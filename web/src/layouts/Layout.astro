---
import '../styles/global.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import AnalyticsSettingsLink from '../components/AnalyticsSettingsLink.astro';
import CommunicationMachine from '../components/CommunicationMachine.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Junkfeathers Music and Tech" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://junkfeathers.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div id="page" class="site-container">
      <header class="site-header">
        <div class="site-branding">
          <a class="site-home-link" href="/">junkfeathers.com</a>
        </div>
        <nav class="main-navigation" aria-label="Primary">
          <a href="/music/">Music</a>
          <a href="/tech/">Tech</a>
        </nav>
      </header>

      <main id="content">
        <slot />
      </main>

      <CommunicationMachine />
      <AnalyticsConsent />

      <footer class="site-footer">
        <div class="inside-site-info">
          <div class="copyright-bar" style="font-size: 0.85em; color: var(--jf-gray-mid); text-transform: uppercase;">
            © {new Date().getFullYear()} Junkfeathers. Pet the <a href="https://snorkleprawn.com" target="_blank" rel="noopener noreferrer" style="color: var(--jf-fg); border-color: var(--jf-fg);">SnorklePrawn</a>.
          </div>
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.65rem 1rem; margin-top: 0.75rem;">
            <a href="/privacy/" style="color: var(--jf-gray-mid); border-color: var(--jf-gray-soft); font-size: 0.72rem; letter-spacing: 0.08em;">PRIVACY</a>
            <AnalyticsSettingsLink />
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
