---
---
<div class="jf-signup-panel jf-signup-panel--inactive" style="margin-top: var(--jf-space-4); border-style: dashed;">
  <span class="jf-label" style="color: var(--jf-gray-mid);">[ DEV MODE // EMAIL COLLECTION OFF ]</span>
  
  <p style="margin: 0 0 var(--jf-space-3) 0;">
    One transmission a month from the Junkfeathers workshop: new music, strange machines, Clio Interviews, product updates, and occasional offers.
  </p>
  
  <div class="jf-signup-form">
    <div class="jf-form-field">
      <label for="email-input" class="jf-field-label">Email Address</label>
      <input type="email" id="email-input" class="jf-email-input" placeholder="name@example.com" disabled />
    </div>
    
    <div class="jf-consent-row">
      <input type="checkbox" id="consent-check" disabled />
      <label for="consent-check" class="jf-consent-copy">
        I consent to receive one monthly email transmission from Junkfeathers.
      </label>
    </div>
    
    <button type="button" class="jf-btn jf-btn--primary jf-btn--inactive" aria-disabled="true" disabled style="width: 100%;">
      Receive the Monthly Transmission
    </button>
  </div>
  
  <span class="jf-privacy-note" style="display: block; font-size: 0.7em; color: var(--jf-gray-mid); margin-top: var(--jf-space-2);">
    Reach pilot is inactive. No cookies are set and no data is collected.
  </span>
</div>
