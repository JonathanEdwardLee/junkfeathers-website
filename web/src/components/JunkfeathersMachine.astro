<section class="routing-machine" data-routing-machine aria-labelledby="junkfeathers-machine-title">
  <header class="machine-title-block">
    <h1 id="junkfeathers-machine-title">JUNKFEATHERS</h1>
  </header>

  <div class="machine-assembly">
    <div class="mechanical-core" aria-hidden="true">
      <div class="core-piston core-piston--left"><span></span></div>
      <div class="core-piston core-piston--right"><span></span></div>

      <div class="core-cage">
        <div class="timing-ring timing-ring--outer"></div>
        <div class="timing-ring timing-ring--inner"></div>
        <div class="drive-wheel drive-wheel--left"><span></span></div>
        <div class="drive-wheel drive-wheel--right"><span></span></div>
        <div class="core-rotor">
          <i></i><i></i><i></i><i></i>
        </div>
        <div class="core-heart">
          <span></span>
        </div>
      </div>

      <div class="indicator-bank">
        <i></i><i></i><i></i>
      </div>
    </div>

    <div class="channel-bridge" aria-hidden="true">
      <span class="bridge-signal bridge-signal--music"></span>
      <span class="bridge-signal bridge-signal--tech"></span>
    </div>

    <nav class="machine-channels" aria-label="Choose a Junkfeathers destination">
      <a class="machine-channel machine-channel--music" href="/music/" data-machine-channel="music">
        <span class="channel-label">MUSIC</span>
        <span class="music-wave" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </span>
      </a>

      <a class="machine-channel machine-channel--tech" href="/tech/" data-machine-channel="tech">
        <span class="channel-label">TECH</span>
        <span class="tech-grid" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </span>
      </a>
    </nav>
  </div>
</section>

<style>
  .routing-machine {
    --machine-edge: #353535;
    --machine-metal: #858585;
    --machine-white: #fff;
    width: min(100% - 1rem, 780px);
    margin: clamp(1rem, 5vw, 2.75rem) auto clamp(2.5rem, 8vw, 5rem);
    overflow: hidden;
    border: 3px solid var(--machine-white);
    background:
      linear-gradient(90deg, transparent 49.8%, rgba(255, 255, 255, 0.035) 50%, transparent 50.2%),
      #020202;
    box-shadow: 7px 7px 0 #1c1c1c;
  }

  .machine-title-block {
    position: relative;
    z-index: 2;
    padding: clamp(1.2rem, 6vw, 2.25rem) 0.75rem clamp(1rem, 4vw, 1.5rem);
    border-bottom: 1px solid var(--machine-edge);
    text-align: center;
  }

  .machine-title-block::before,
  .machine-title-block::after {
    position: absolute;
    top: 50%;
    width: clamp(1rem, 8vw, 4.5rem);
    height: 1px;
    background: var(--machine-metal);
    content: '';
  }

  .machine-title-block::before { left: 0; }
  .machine-title-block::after { right: 0; }

  .machine-title-block h1 {
    margin: 0;
    font-size: clamp(2rem, 11vw, 5.25rem);
    line-height: 0.95;
    letter-spacing: clamp(0.02em, 1vw, 0.12em);
  }

  .machine-assembly {
    position: relative;
    display: grid;
    justify-items: center;
    padding: clamp(1.5rem, 7vw, 3.25rem) clamp(0.75rem, 4vw, 2rem) clamp(1.25rem, 5vw, 2.25rem);
  }

  .mechanical-core {
    position: relative;
    z-index: 2;
    width: clamp(190px, 67vw, 270px);
    aspect-ratio: 1;
  }

  .core-cage {
    position: absolute;
    inset: 10%;
    display: grid;
    place-items: center;
    border: 2px solid var(--machine-white);
    border-radius: 50%;
    background:
      radial-gradient(circle at center, #151515 0 3%, transparent 3.5%),
      repeating-conic-gradient(from 4deg, #202020 0 2deg, #050505 2deg 12deg);
    box-shadow:
      inset 0 0 0 8px #050505,
      inset 0 0 0 9px var(--machine-edge),
      0 0 22px rgba(255, 255, 255, 0.08);
  }

  .core-cage::before,
  .core-cage::after {
    position: absolute;
    inset: -7%;
    border: 1px dashed var(--machine-metal);
    border-radius: 50%;
    content: '';
  }

  .core-cage::before {
    animation: core-orbit 30s linear infinite;
  }

  .core-cage::after {
    inset: -11%;
    border-color: #292929;
    border-style: solid;
  }

  .timing-ring {
    position: absolute;
    border-radius: 50%;
  }

  .timing-ring--outer {
    inset: 14%;
    border: 8px double var(--machine-metal);
    animation: core-orbit 18s linear infinite reverse;
  }

  .timing-ring--outer::before,
  .timing-ring--outer::after {
    position: absolute;
    inset: 47% -13%;
    height: 6%;
    background: var(--machine-white);
    content: '';
  }

  .timing-ring--outer::after {
    transform: rotate(90deg);
  }

  .timing-ring--inner {
    inset: 28%;
    border: 2px dashed var(--machine-white);
    animation: core-orbit 11s steps(24, end) infinite;
  }

  .drive-wheel {
    position: absolute;
    top: 39%;
    z-index: 1;
    width: 25%;
    aspect-ratio: 1;
    border: 2px solid var(--machine-metal);
    border-radius: 50%;
    background: repeating-conic-gradient(
      from 4deg,
      var(--machine-metal) 0 7deg,
      transparent 7deg 22.5deg
    );
    box-shadow: inset 0 0 0 5px #080808;
  }

  .drive-wheel::before {
    position: absolute;
    inset: 28%;
    border: 2px solid var(--machine-white);
    border-radius: 50%;
    background: #050505;
    content: '';
  }

  .drive-wheel::after {
    position: absolute;
    top: -4px;
    left: calc(50% - 3px);
    width: 6px;
    height: 10px;
    background: var(--machine-white);
    box-shadow: 0 0 5px rgba(255, 255, 255, 0.45);
    content: '';
  }

  .drive-wheel span {
    position: absolute;
    z-index: 2;
    inset: calc(50% - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--machine-white);
  }

  .drive-wheel--left {
    left: 18%;
    animation: core-orbit 8s linear infinite;
  }

  .drive-wheel--right {
    right: 18%;
    animation: core-orbit 10.5s linear infinite reverse;
  }

  .core-rotor {
    position: absolute;
    inset: 34%;
    border: 2px solid var(--machine-white);
    border-radius: 50%;
    background: #080808;
    animation: core-orbit 7s linear infinite reverse;
  }

  .core-rotor i {
    position: absolute;
    top: 46%;
    left: -34%;
    width: 168%;
    height: 8%;
    background: var(--machine-white);
    box-shadow: 0 0 7px rgba(255, 255, 255, 0.38);
  }

  .core-rotor i:nth-child(2) { transform: rotate(45deg); }
  .core-rotor i:nth-child(3) { transform: rotate(90deg); }
  .core-rotor i:nth-child(4) { transform: rotate(135deg); }

  .core-heart {
    position: relative;
    z-index: 3;
    width: 21%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    clip-path: polygon(25% 7%, 75% 7%, 100% 50%, 75% 93%, 25% 93%, 0 50%);
    background: var(--machine-white);
    animation: core-breathe 3.8s ease-in-out infinite;
  }

  .core-heart span {
    width: 44%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #000;
  }

  .core-piston {
    position: absolute;
    top: 40%;
    width: 25%;
    height: 20%;
    border-block: 2px solid var(--machine-metal);
  }

  .core-piston--left {
    left: 0;
    border-left: 2px solid var(--machine-metal);
  }

  .core-piston--right {
    right: 0;
    border-right: 2px solid var(--machine-metal);
  }

  .core-piston span {
    position: absolute;
    top: 36%;
    width: 78%;
    height: 28%;
    background: var(--machine-metal);
    animation: piston-stroke 2.6s ease-in-out infinite;
  }

  .core-piston--left span { left: 12%; }
  .core-piston--right span {
    right: 12%;
    animation-direction: reverse;
  }

  .indicator-bank {
    position: absolute;
    inset: auto 0 3%;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .indicator-bank i {
    width: 6px;
    height: 6px;
    border: 1px solid var(--machine-metal);
    border-radius: 50%;
    background: #111;
    animation: indicator-pulse 3s ease-in-out infinite;
  }

  .indicator-bank i:nth-child(2) { animation-delay: 1s; }
  .indicator-bank i:nth-child(3) { animation-delay: 2s; }

  .channel-bridge {
    position: relative;
    z-index: 1;
    width: 62%;
    height: clamp(38px, 12vw, 66px);
    border-top: 1px solid var(--machine-metal);
  }

  .channel-bridge::before {
    position: absolute;
    top: calc(-1 * clamp(18px, 6vw, 34px));
    left: calc(50% - 1px);
    width: 2px;
    height: clamp(18px, 6vw, 34px);
    background: var(--machine-metal);
    content: '';
  }

  .channel-bridge::after {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, #fff 50%, transparent);
    content: '';
    opacity: 0.35;
    animation: bridge-charge 4.5s ease-in-out infinite;
  }

  .bridge-signal {
    position: absolute;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--machine-white);
    box-shadow: 0 0 9px var(--machine-white);
    opacity: 0.72;
  }

  .bridge-signal--music {
    left: 50%;
    animation: signal-left 4.5s ease-in-out infinite;
  }

  .bridge-signal--tech {
    right: 50%;
    animation: signal-right 4.5s ease-in-out 2.25s infinite;
  }

  .machine-channels {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    gap: 0.8rem;
  }

  .machine-channel {
    position: relative;
    min-height: 94px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
    padding: 1rem;
    border: 2px solid var(--machine-white);
    background: #050505;
    color: var(--machine-white);
    text-decoration: none;
    transition: opacity 280ms ease, background-color 280ms ease, color 280ms ease;
  }

  .machine-channel::before {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 28px, rgba(255, 255, 255, 0.06) 29px 30px);
    content: '';
    opacity: 0.25;
    transform: translateX(-30px);
    animation: channel-current 7s linear infinite;
  }

  .machine-channel::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 22%;
    height: 2px;
    background: var(--machine-white);
    box-shadow: 0 0 9px var(--machine-white);
    content: '';
    opacity: 0.5;
    animation: output-scan 4s ease-in-out infinite alternate;
  }

  .machine-channel:hover,
  .machine-channel:focus,
  .machine-channel:active {
    border-bottom: 2px solid var(--machine-white);
    background: #111;
    color: var(--machine-white);
  }

  .machine-channel:focus-visible {
    outline: 2px solid var(--machine-white) !important;
    outline-offset: 4px;
  }

  .channel-label {
    position: relative;
    z-index: 2;
    font-size: clamp(1.3rem, 8vw, 2.35rem);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .music-wave,
  .tech-grid {
    position: relative;
    z-index: 2;
  }

  .music-wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 38px;
  }

  .music-wave i {
    width: 3px;
    height: 18%;
    background: var(--machine-metal);
    animation: wave-idle 2.8s ease-in-out infinite alternate;
  }

  .music-wave i:nth-child(2),
  .music-wave i:nth-child(6) { height: 42%; animation-delay: 0.2s; }
  .music-wave i:nth-child(3),
  .music-wave i:nth-child(5) { height: 72%; animation-delay: 0.4s; }
  .music-wave i:nth-child(4) { height: 100%; animation-delay: 0.6s; }

  .tech-grid {
    width: 42px;
    height: 42px;
    border: 1px solid var(--machine-metal);
    background:
      linear-gradient(90deg, transparent 48%, var(--machine-edge) 49% 51%, transparent 52%),
      linear-gradient(transparent 48%, var(--machine-edge) 49% 51%, transparent 52%);
  }

  .tech-grid i {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--machine-metal);
  }

  .tech-grid i:nth-child(1) { top: 6px; left: 6px; }
  .tech-grid i:nth-child(2) { top: 6px; right: 6px; }
  .tech-grid i:nth-child(3) { right: 6px; bottom: 6px; }
  .tech-grid i:nth-child(4) { bottom: 6px; left: 6px; }

  .routing-machine:has(.machine-channel--music:is(:hover, :focus-visible, :active)) .machine-channel--tech,
  .routing-machine:has(.machine-channel--tech:is(:hover, :focus-visible, :active)) .machine-channel--music {
    opacity: 0.36;
  }

  .machine-channel:is(:hover, :focus-visible, :active) {
    background: #151515;
  }

  .machine-channel--music:is(:hover, :focus-visible, :active) .music-wave i {
    background: var(--machine-white);
    filter: brightness(1.35);
  }

  .machine-channel--tech:is(:hover, :focus-visible, :active) .tech-grid {
    border-color: var(--machine-white);
    box-shadow: inset 0 -10px 0 rgba(255, 255, 255, 0.12), 0 0 10px rgba(255, 255, 255, 0.18);
  }

  .machine-channel--tech:is(:hover, :focus-visible, :active) .tech-grid i {
    background: var(--machine-white);
    animation: tech-node 1.8s ease-in-out infinite;
  }

  .routing-machine:has(.machine-channel--music:is(:hover, :focus-visible, :active)) .bridge-signal--music,
  .routing-machine:has(.machine-channel--tech:is(:hover, :focus-visible, :active)) .bridge-signal--tech {
    opacity: 1;
    box-shadow: 0 0 15px 3px var(--machine-white);
  }

  @media (min-width: 600px) {
    .routing-machine {
      width: min(100% - 2rem, 780px);
    }

    .machine-channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(3rem, 12vw, 7rem);
    }

    .machine-channel {
      min-height: 112px;
    }
  }

  @media (max-width: 599px) {
    .channel-bridge {
      width: 2px;
      height: 42px;
      border-top: 0;
      background: var(--machine-metal);
    }

    .channel-bridge::before {
      top: -20px;
      height: 20px;
    }

    .channel-bridge::after,
    .bridge-signal {
      display: none;
    }

    .machine-channels::before {
      position: absolute;
      z-index: -1;
      inset: -42px auto 0 50%;
      width: 1px;
      background: var(--machine-edge);
      content: '';
    }
  }

  @media (max-width: 350px) {
    .routing-machine {
      width: calc(100% - 0.75rem);
      border-width: 2px;
    }

    .machine-assembly {
      padding-inline: 0.55rem;
    }

    .machine-channel {
      min-height: 82px;
      padding: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .routing-machine *,
    .routing-machine *::before,
    .routing-machine *::after {
      animation: none !important;
      transition: none !important;
    }

    .routing-machine[data-routing-machine] .core-cage .drive-wheel.drive-wheel--left {
      animation: core-orbit 28s linear infinite !important;
    }

    .routing-machine[data-routing-machine] .core-cage .drive-wheel.drive-wheel--right {
      animation: core-orbit 36s linear infinite reverse !important;
    }
  }

  @keyframes core-orbit { to { transform: rotate(1turn); } }
  @keyframes core-breathe { 50% { filter: brightness(0.58); transform: scale(0.88); } }
  @keyframes piston-stroke { 50% { transform: translateX(13%); filter: brightness(1.7); } }
  @keyframes indicator-pulse { 18% { background: #fff; box-shadow: 0 0 7px #fff; } 38% { background: #111; box-shadow: none; } }
  @keyframes bridge-charge { 50% { opacity: 0.9; } }
  @keyframes signal-left { 0%, 12% { left: 50%; opacity: 0; } 22% { opacity: 0.75; } 48%, 100% { left: -1%; opacity: 0; } }
  @keyframes signal-right { 0%, 12% { right: 50%; opacity: 0; } 22% { opacity: 0.75; } 48%, 100% { right: -1%; opacity: 0; } }
  @keyframes channel-current { to { transform: translateX(30px); } }
  @keyframes output-scan { to { left: 78%; } }
  @keyframes wave-idle { to { transform: scaleY(0.45); filter: brightness(1.4); } }
  @keyframes tech-node { 50% { opacity: 0.48; } }
</style>
