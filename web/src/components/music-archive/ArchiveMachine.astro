  }
  .archive-machine,
  .multimedia-machine {
    position: relative;
    width: min(100% - 1rem, 780px);
    border: var(--jf-border-major) solid var(--archive-mid);
    background: #020202;
    box-shadow: 5px 5px 0 #171717;
    overflow-x: hidden;
  }
  .archive-machine { margin: clamp(1rem, 4vw, 2.5rem) auto 1.25rem; }
  .multimedia-machine { margin: 0 auto clamp(2.75rem, 9vw, 5rem); }
  .archive-machine::before,
  .archive-machine::after,
  .multimedia-machine::before,
  .multimedia-machine::after { position: absolute; z-index: 3; top: 7px; width: 5px; height: 5px; border: 1px solid var(--archive-white); border-radius: 50%; background: var(--archive-white); content: ''; }
  .archive-machine::before,
  .multimedia-machine::before { left: 7px; }
  .archive-machine::after,
  .multimedia-machine::after { right: 7px; }
  .archive-console-top { display: grid; border-bottom: 2px solid var(--archive-mid); background: #050505; }
  .archive-header { display: grid; gap: 1.5rem; align-items: end; padding: clamp(1rem, 4vw, 1.75rem); }
  .archive-kicker { margin: 0; color: var(--archive-mid); font-size: .7rem; letter-spacing: .16em; }
  .archive-header h1 { margin: .2rem 0 .75rem; font-size: clamp(2.2rem, 11vw, 4.8rem); line-height: .9; }
  .archive-intro { max-width: 68ch; margin: 0; color: var(--jf-gray-strong); }
  .archive-counter { display: grid; justify-items: start; border-left: 3px solid var(--archive-mid); padding-left: 1rem; }
  .archive-counter strong { font-size: clamp(2.8rem, 12vw, 4.5rem); line-height: .9; font-variant-numeric: tabular-nums; }
  .archive-counter span { color: var(--archive-white); font-weight: 700; letter-spacing: .14em; }
  .archive-machine-art { position: relative; display: grid; align-items: stretch; min-height: 190px; padding: 1rem; overflow: hidden; border-top: 1px solid var(--archive-line); background: repeating-linear-gradient(to bottom, transparent 0 3px, rgba(255,255,255,.026) 4px), #070707; }
  .archive-head { align-self: stretch; display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; padding: .75rem; border: 1px solid var(--archive-dim); background: #020202; }
  .archive-head i { position: relative; overflow: hidden; border-inline: 1px solid #202020; }
  .archive-head i::after { position: absolute; inset: 68% 3px auto; height: 25%; background: #9a9a9a; content: ''; animation: archive-head-read 3.8s ease-in-out infinite alternate; }
  .archive-head i:nth-child(2)::after { animation-delay: -1.8s; }
  .archive-head i:nth-child(3)::after { animation-delay: -2.7s; }
  .archive-index-strip { position: absolute; right: 1rem; bottom: 1rem; display: flex; gap: .32rem; padding: .3rem .45rem; border: 1px solid var(--archive-dim); background: rgba(0,0,0,.9); color: var(--archive-mid); font-size: .55rem; letter-spacing: .08em; }
  .archive-index-strip span:last-child { color: var(--archive-white); }
  .archive-art-status { position: absolute; top: 1rem; right: 1rem; display: grid; justify-items: end; color: var(--archive-mid); font-size: .56rem; letter-spacing: .1em; }
  .archive-art-status strong { color: var(--archive-white); }
  .archive-controls { padding: 1rem; border-bottom: 2px solid var(--archive-mid); background: #030303; }
  .archive-search-label,
  .archive-filter-grid label span { display: block; margin-bottom: .35rem; color: var(--jf-gray-strong); font-size: .7rem; letter-spacing: .12em; }
  input, select, button { border-radius: 0; font: inherit; }
  [data-archive-search] { width: 100%; min-height: 52px; padding: .75rem; border: 2px solid var(--archive-white); background: #000; color: #fff; font-size: 1rem; }
  [data-archive-search]::placeholder { color: var(--jf-gray-mid); }
  .archive-filter-grid { display: grid; gap: .75rem; margin-top: .9rem; }
  .archive-filter-grid select { width: 100%; min-height: 44px; padding: .55rem; border: 1px solid var(--jf-gray-strong); background: #080808; color: #fff; }
  .archive-control-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-top: 1rem; }
  .archive-result-count { margin: 0; color: var(--archive-white); font-size: .78rem; font-weight: 700; letter-spacing: .1em; }
  [data-archive-search]:focus-visible,
  select:focus-visible,
  button:focus-visible,
  .mm-drawer :global(a:focus-visible),
  .mm-panel :global(a:focus-visible) { outline: 3px solid #fff; outline-offset: 3px; }
  .archive-output {
    display: flex;
    flex-direction: column;
    height: 24.5rem;
    max-height: 24.5rem;
    padding: 1rem;
    min-height: 0;
    overflow: hidden;
  }
  .archive-state,
