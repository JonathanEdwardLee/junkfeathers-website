<div class="archive-stack" data-archive-stack>
<section class="archive-machine" data-archive-machine>
  <div class="archive-console-top">
    <header class="archive-header">
      <div>
        <p class="archive-kicker">JF / MUSIC CATALOG</p>
        <h1>MUSIC ARCHIVE</h1>
        <p class="archive-intro">Welcome to my Music Archive Machine &mdash; a collection of songs I've written, songs I've collaborated on with others, and also the music of the bands I've been in over the years. This machine is an ongoing project as I compile older projects with newer ones in one collection. Thank you for being here and enjoy!</p>
      </div>
      <div class="archive-counter" aria-label="215 known songs">
        <strong>215</strong>
        <span>KNOWN SONGS</span>
      </div>
    </header>

    <div class="archive-machine-art" aria-hidden="true">
      <div class="archive-head">
        <i></i><i></i><i></i>
      </div>
      <div class="archive-index-strip">
        <span>01</span><span>03</span><span>05</span><span>07</span><span>10</span>
      </div>
      <div class="archive-art-status">
        <span>INDEX / V04</span>
        <strong>READ HEAD ACTIVE</strong>
      </div>
    </div>
  </div>

  <div class="archive-controls" aria-label="Archive search controls">
    <label class="archive-search-label" for="archive-search">SEARCH THE ARCHIVE</label>
    <input id="archive-search" type="search" inputmode="search" autocomplete="off" placeholder="SONG, PROJECT / BAND, RELEASE, HISTORICAL TITLE&hellip;" data-archive-search disabled />

    <div class="archive-filter-grid">
      <label>
        <span>DECADE</span>
        <select data-filter="decade" disabled>
          <option value="all">ALL DECADES</option>
        </select>
      </label>
      <label>
        <span>PROJECT / BAND</span>
        <select data-filter="project" disabled>
          <option value="all">ALL PROJECTS / BANDS</option>
        </select>
      </label>
      <label>
        <span>STREAMING PLATFORM</span>
        <select data-filter="platform" disabled>
          <option value="all">ALL STREAMING PLATFORMS</option>
        </select>
      </label>
    </div>

    <div class="archive-control-footer">
      <p class="archive-result-count" role="status" aria-live="polite" data-result-count>LOADING ARCHIVE&hellip;</p>
      <button type="button" class="archive-reset archive-btn" data-reset disabled>RESET SEARCH</button>
    </div>
  </div>

  <div class="archive-output">
    <div class="archive-state" data-loading-state>
      <span class="archive-pulse" aria-hidden="true"></span>
      VERIFYING PUBLIC CATALOG&hellip;
    </div>
    <div class="archive-state archive-state--error" data-error-state hidden>
      ARCHIVE UNAVAILABLE. THE MUSIC PAGE IS STILL ONLINE; TRY THIS MACHINE AGAIN LATER.
    </div>
    <div class="archive-state" data-no-results hidden>
      NO MATCHING SONGS. ADJUST THE SEARCH OR RESET THE FILTERS.
    </div>

    <div class="archive-results" data-results aria-label="Archive results"></div>
    <nav class="archive-pager" data-archive-pager hidden aria-label="Archive result pages">
      <button type="button" class="archive-btn" data-page-step="-1" aria-label="Previous page">PREV</button>
      <label class="archive-page-label">
        <span>PAGE</span>
        <select data-page-select aria-label="Page number"></select>
      </label>
      <span data-page-count></span>
      <button type="button" class="archive-btn" data-page-step="1" aria-label="Next page">NEXT</button>
    </nav>

    <noscript>
      <p class="archive-noscript">Interactive archive search requires JavaScript. The existing music transmission remains available on the <a href="/music/">Music page <span aria-hidden="true">&#8599;</span></a>.</p>
    </noscript>
  </div>
</section>

<section class="multimedia-machine" data-multimedia-machine data-state="idle" aria-label="Multimedia Machine">
  <div class="mm-heading">
    <div>
      <p>MULTIMEDIA MACHINE</p>
      <h2 id="archive-mm-title" tabindex="-1" data-mm-title>STANDBY</h2>
    </div>
    <div class="mm-tools">
      <span data-mm-readout></span>
    </div>
  </div>
  <div class="mm-tabs" role="tablist" aria-label="Multimedia Machine surfaces" data-mm-tabs>
    <button type="button" class="archive-btn" role="tab" data-surface="INFO" aria-selected="true" tabindex="0">INFO</button>
  </div>
  <div class="mm-stage">
    <div class="mm-panel" data-mm-panel>
      <div class="mm-crt" aria-live="polite">
        <div class="mm-crt-noise" aria-hidden="true"></div>
        <div class="mm-crt-scan" aria-hidden="true"></div>
        <p class="mm-await">AWAITING INPUT<span class="mm-cursor" aria-hidden="true">_</span></p>
      </div>
    </div>
  </div>
  <aside class="mm-drawer" aria-label="Streaming destinations" data-mm-drawer>
    <p>STREAMING</p>
    <p>AWAITING INPUT</p>
  </aside>
</section>
</div>

<script>
  interface ArchiveProject { id: string; name: string }
  interface ArchiveRelease { id: string; title: string; artist: string; date: string | null; year: string | null; datePrecision: string | null }
  interface ArchiveRecording { id: string; title: string; version: string | null; duration: string | null; artist: string; leadVocal: string | null }
  interface ArchiveSongLink {
    id: string; songId: string; platform: string; priority: number; url: string; linkLevel: string;
    releaseTitle: string | null; mediaId: string | null; embedUrl: string | null; supportContext: string | null;
  }
  interface ArchiveDestination {
    id: string; platform: string; url: string; kind: 'exact' | 'release-page' | 'smart-link'; label: string; level: string;
  }
  interface ArchiveVersion {
    key: string; recordingId: string | null; releaseId: string | null; projectId: string; projectName: string;
    label: string; datePrecision: string | null; listenChannelIds: string[]; watchChannelIds: string[];
    lyricIds: string[]; lyricState: string; destinations: ArchiveDestination[];
  }
  interface ArchiveSong {
    id: string; title: string; aliases: string[]; projectIds: string[]; projectNames: string[];
    recordingIds: string[]; releaseIds: string[]; linkIds: string[]; eligibility: string;
    alternateTitle: string | null; writing: string | null; lyrics: string | null; vocal: string | null;
    acoustic: boolean; creditStatus: string; linerNotes: string | null; decade: string | null;
    contexts: string[]; date: { value: string; precision: string | null; releaseId: string } | null;
    credits: { name: string; category: string; role: string }[];
    versions: ArchiveVersion[];
  }
  interface ArchivePlayerFact { label: string; value: string; url?: string }
  interface ArchivePlaybackCandidate {
    kind: 'bandcamp-track' | 'bandcamp-album-fallback' | 'same-version';
    label: string; embedUrl: string; registryId: string | null; attributionUrl: string;
    releaseFallback: boolean;
  }
  interface ArchivePlayback {
    kind: ArchivePlaybackCandidate['kind'] | 'external'; label: string; embedUrl: string | null;
    registryId: string | null; attributionUrl: string; releaseFallback: boolean;
    candidates: ArchivePlaybackCandidate[];
  }
  interface ArchiveLyric {
    id: string; songId: string; title: string; version: string; text: string; authors: string;
    sourceType: string; evidence: string; rights: string; sampleTreatment: string | null;
    publicEligible?: boolean; state?: string;
  }
  interface ArchivePlayerChannel {
    id: string; songId: string; title: string; type: 'vhs' | 'cassette'; order: number; label: string;
    recordingId: string | null; releaseId: string | null; versionKey: string; versionLabel: string; platform: string; songLinkId: string;
    playbackMethod: string; externalUrl: string; datePrecision: string; projectId: string; projectName: string;
    mediaId: string | null; embedUrl: string | null; playback: ArchivePlayback; facts: ArchivePlayerFact[];
    lyrics: ArchiveLyric[];
  }
  interface ArchiveData {
    meta: {
      schemaVersion: string;
      publicKnownSongs: number;
      counts: { songs: number; songLinks: number; playerChannels: number; lyrics: number; bandcampEmbedRegistry: number };
      latestView: { projectId: string; releaseId: string; releaseTitle: string; songIds: string[] };
    };
    facets: { decades: string[]; projects: ArchiveProject[]; platforms: string[] };
    projects: ArchiveProject[]; songs: ArchiveSong[]; releases: ArchiveRelease[];
    recordings: ArchiveRecording[]; songLinks: ArchiveSongLink[]; lyrics: ArchiveLyric[]; playerChannels: ArchivePlayerChannel[];
  }
  interface SearchItem extends ArchiveSong {
    searchText: string;
    releases: ArchiveRelease[];
    recordings: ArchiveRecording[];
    links: ArchiveSongLink[];
  }
  type Surface = 'INFO' | 'LISTEN' | 'WATCH' | 'LYRICS' | 'VERSIONS';

  const machine = document.querySelector<HTMLElement>('[data-archive-machine]');
  const mm = document.querySelector<HTMLElement>('[data-multimedia-machine]');
  if (machine && mm) {
    const search = machine.querySelector<HTMLInputElement>('[data-archive-search]')!;
    const filters = [...machine.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const reset = machine.querySelector<HTMLButtonElement>('[data-reset]')!;
    const results = machine.querySelector<HTMLElement>('[data-results]')!;
    const resultCount = machine.querySelector<HTMLElement>('[data-result-count]')!;
    const loadingState = machine.querySelector<HTMLElement>('[data-loading-state]')!;
    const errorState = machine.querySelector<HTMLElement>('[data-error-state]')!;
    const noResults = machine.querySelector<HTMLElement>('[data-no-results]')!;
    const pager = machine.querySelector<HTMLElement>('[data-archive-pager]')!;
    const pageSelect = machine.querySelector<HTMLSelectElement>('[data-page-select]')!;
    const pageCountLabel = machine.querySelector<HTMLElement>('[data-page-count]')!;
    const pageButtons = [...machine.querySelectorAll<HTMLButtonElement>('[data-page-step]')];
    const mmTitle = mm.querySelector<HTMLElement>('[data-mm-title]')!;
    const mmReadout = mm.querySelector<HTMLElement>('[data-mm-readout]')!;
    const mmTabs = mm.querySelector<HTMLElement>('[data-mm-tabs]')!;
    const mmPanel = mm.querySelector<HTMLElement>('[data-mm-panel]')!;
    const mmDrawer = mm.querySelector<HTMLElement>('[data-mm-drawer]')!;
    const pageSize = 2;
    const defaultLimit = 16;
    const defaultDecade = '2020s';
    let currentPage = 1;
    let data: ArchiveData;
    let items: SearchItem[] = [];
    let itemById = new Map<string, SearchItem>();
    let channelById = new Map<string, ArchivePlayerChannel>();
    let lyricById = new Map<string, ArchiveLyric>();
    let latestView = new URLSearchParams(window.location.search).get('view') === 'latest';
    let openSong: SearchItem | null = null;
    let openVersion: ArchiveVersion | null = null;
    let openSurface: Surface = 'INFO';
    let moreButton: HTMLButtonElement | null = null;

    const normalize = (value: unknown) => String(value ?? '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const byId = <T extends { id: string }>(values: T[]) => new Map(values.map((value) => [value.id, value]));
    const option = (value: string, label: string) => {
      const element = document.createElement('option');
      element.value = value;
      element.textContent = label;
      return element;
    };
    const appendText = (element: HTMLElement, label: string, value: string | null | undefined) => {
      if (!value) return;
      const item = document.createElement('li');
      const key = document.createElement('span');
      const content = document.createElement('strong');
      key.textContent = label;
      content.textContent = value;
      item.append(key, content);
      element.append(item);
    };
    const selectedProjectId = (item: SearchItem) => {
      const selected = filters.find((filter) => filter.dataset.filter === 'project')?.value;
      return selected && item.projectIds.includes(selected) ? selected : item.projectIds[0] ?? '';
    };
    const params = () => {
      const searchParams = new URLSearchParams(window.location.search);
      return { song: searchParams.get('song'), channel: searchParams.get('channel') };
    };
    const writeParams = (songId: string | null, channelId: string | null, replace = false) => {
      const url = new URL(window.location.href);
      if (songId) url.searchParams.set('song', songId); else url.searchParams.delete('song');
      if (channelId) url.searchParams.set('channel', channelId); else url.searchParams.delete('channel');
      history[replace ? 'replaceState' : 'pushState']({ song: songId, channel: channelId }, '', url);
    };
    const defaultVersion = (item: SearchItem) => {
      const projectId = selectedProjectId(item);
      const inProject = item.versions.filter((version) => version.projectId === projectId);
      const pool = inProject.length ? inProject : item.versions;
      return pool.find((version) => version.listenChannelIds.length)
        ?? pool.find((version) => version.watchChannelIds.length)
        ?? pool[0]
        ?? null;
    };
    const versionForChannel = (item: SearchItem, channelId: string | null) => {
      if (!channelId) return defaultVersion(item);
      const channel = channelById.get(channelId);
      if (!channel || channel.songId !== item.id) return defaultVersion(item);
      return item.versions.find((version) => version.listenChannelIds.includes(channelId) || version.watchChannelIds.includes(channelId)) ?? defaultVersion(item);
    };
    const surfacesFor = (version: ArchiveVersion | null): Surface[] => {
      const surfaces: Surface[] = ['INFO'];
      if (version?.listenChannelIds.length) surfaces.push('LISTEN');
      if (version?.watchChannelIds.length) surfaces.push('WATCH');
      if (version?.lyricState === 'public') surfaces.push('LYRICS');
      if ((openSong?.versions.length ?? 0) > 1) surfaces.push('VERSIONS');
      return surfaces;
    };
    const selectedChannel = (type: 'cassette' | 'vhs') => {
      const ids = type === 'cassette' ? openVersion?.listenChannelIds ?? [] : openVersion?.watchChannelIds ?? [];
      const requested = params().channel;
      if (requested && ids.includes(requested)) return channelById.get(requested) ?? null;
      const channels = ids.map((id) => channelById.get(id)).filter((value): value is ArchivePlayerChannel => Boolean(value))
        .sort((left, right) => left.order - right.order || left.id.localeCompare(right.id));
      if (type === 'cassette') {
        const bandcamp = channels.find((channel) => channel.platform === 'Bandcamp');
        if (bandcamp) return bandcamp;
      }
      return channels[0] ?? null;
    };

    const makeItems = (archive: ArchiveData) => {
      const releases = byId(archive.releases);
      const recordings = byId(archive.recordings);
      const links = byId(archive.songLinks);
      return archive.songs.map((song) => {
        const songReleases = song.releaseIds.map((id) => releases.get(id)).filter((value): value is ArchiveRelease => Boolean(value));
        const songRecordings = song.recordingIds.map((id) => recordings.get(id)).filter((value): value is ArchiveRecording => Boolean(value));
        const songLinks = song.linkIds.map((id) => links.get(id)).filter((value): value is ArchiveSongLink => Boolean(value));
        return {
          ...song,
          releases: songReleases,
          recordings: songRecordings,
          links: songLinks,
          searchText: normalize([
            song.title, ...song.aliases, ...song.projectNames,
            ...songReleases.flatMap((release) => [release.title, release.artist]),
            ...songRecordings.flatMap((recording) => [recording.title, recording.version, recording.artist]),
          ].join(' ')),
        };
      });
    };

    const card = (item: SearchItem) => {
      const article = document.createElement('article');
      article.className = 'archive-card';
      article.dataset.songId = item.id;
      const head = document.createElement('div');
      head.className = 'archive-card-head';
      const type = document.createElement('span');
      type.className = 'archive-type';
      type.textContent = item.eligibility === 'Yes' ? 'SONG' : item.eligibility.startsWith('Pending') ? 'ARCHIVE / PENDING' : 'ARCHIVE ENTRY';
      const id = document.createElement('span');
      id.className = 'archive-id';
      id.textContent = item.id;
      head.append(type, id);

      const title = document.createElement('h2');
      title.textContent = item.title;
      const subtitle = document.createElement('p');
      subtitle.className = 'archive-subtitle';
      subtitle.textContent = item.projectNames.join(' / ');
      const credits = document.createElement('ul');
      credits.className = 'archive-meta';
      const dateLabel = item.date ? [item.date.value, item.date.precision].filter(Boolean).join(' · ') : null;
      appendText(credits, 'DATE', dateLabel);
      appendText(credits, 'WRITING', item.writing);
      appendText(credits, 'LYRICS', item.lyrics);
      appendText(credits, item.vocal === 'Instrumental' ? 'VOICE' : 'SINGER(S)', item.vocal);
      if (item.acoustic) appendText(credits, 'FORMAT', 'ACOUSTIC');
      appendText(credits, 'RELEASE', item.releases.map((release) => release.title).filter((value, index, values) => values.indexOf(value) === index).slice(0, 3).join(' / '));
      appendText(credits, 'VERSION', item.recordings.map((recording) => recording.version).filter((value): value is string => Boolean(value)).filter((value, index, values) => values.indexOf(value) === index).slice(0, 2).join(' / '));

      article.append(head, title);
      if (item.alternateTitle) {
        const alternate = document.createElement('p');
        alternate.className = 'archive-alternate';
        alternate.textContent = `ALSO KNOWN AS / ${item.alternateTitle}`;
        article.append(alternate);
      }
      if (item.projectNames.length) article.append(subtitle);
      if (credits.childElementCount) article.append(credits);

      const actions = document.createElement('div');
      actions.className = 'archive-actions';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'archive-btn';
      button.dataset.mediaAction = 'more';
      button.dataset.songId = item.id;
      button.setAttribute('aria-label', `More about ${item.title}`);
      button.textContent = 'MORE';
      actions.append(button);
      article.append(actions);
      return article;
    };

    const isAll = (value: string | undefined) => !value || value === 'all';
    const currentCatalog = () => {
      const query = normalize(search.value);
      const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.filter!, filter.value]));
      const decade = isAll(selected.decade) ? '' : selected.decade;
      const project = isAll(selected.project) ? '' : selected.project;
      const platform = isAll(selected.platform) ? '' : selected.platform;
      const hasInput = Boolean(query || decade || project || platform);
      const tokens = query.split(' ').filter(Boolean);
      const matching = items.filter((item) =>
        tokens.every((token) => item.searchText.includes(token)) &&
        (!decade || item.decade === decade) &&
        (!project || item.projectIds.includes(project)) &&
        (!platform || item.links.some((link) => link.platform === platform))
      );
      const showingLatest = latestView && !query && project === data.meta.latestView.projectId && !decade && !platform;
      const latestIds = new Set(data.meta.latestView.songIds);
      const catalog = showingLatest
        ? matching.filter((item) => latestIds.has(item.id))
        : hasInput
          ? matching
          : items.filter((item) => item.eligibility === 'Yes' && !item.projectIds.includes('PRJ-PROJ-001')).slice(0, defaultLimit);
      return { catalog, matching, showingLatest, hasInput };
    };

    const pageToSong = (item: SearchItem) => {
      const index = currentCatalog().catalog.findIndex((entry) => entry.id === item.id);
      if (index >= 0) currentPage = Math.floor(index / pageSize) + 1;
    };

    const render = () => {
      const { catalog, matching, showingLatest, hasInput } = currentCatalog();
      const pageCount = Math.max(1, Math.ceil(catalog.length / pageSize));
      if (currentPage > pageCount) currentPage = pageCount;
      if (currentPage < 1) currentPage = 1;
      const display = catalog.slice((currentPage - 1) * pageSize, currentPage * pageSize);
      resultCount.textContent = showingLatest
        ? `${data.meta.latestView.releaseTitle.toUpperCase()} / ${catalog.length} SONG${catalog.length === 1 ? '' : 'S'}`
        : hasInput
          ? `${matching.length} MATCH${matching.length === 1 ? '' : 'ES'}`
          : `${data.meta.counts.songs} ARCHIVE ENTRIES / SHOWING ${catalog.length}`;
      noResults.hidden = catalog.length > 0;
      pager.hidden = catalog.length <= pageSize;
      if (pageSelect.options.length !== pageCount || pageSelect.options[0]?.value !== '1') {
        pageSelect.replaceChildren(...Array.from({ length: pageCount }, (_, index) => option(String(index + 1), String(index + 1))));
      }
      pageSelect.value = String(currentPage);
      pageCountLabel.textContent = `/ ${pageCount}`;
      pageButtons.forEach((button) => {
        const step = Number(button.dataset.pageStep);
        button.disabled = (step < 0 && currentPage <= 1) || (step > 0 && currentPage >= pageCount);
      });
      results.replaceChildren(...display.map(card));
      display.forEach((item) => {
        const cardEl = results.querySelector<HTMLElement>(`[data-song-id="${item.id}"]`);
        cardEl?.classList.toggle('archive-card--open', openSong?.id === item.id);
      });
    };

    const youtubeId = (channel: ArchivePlayerChannel) => channel.mediaId || (() => {
      try { return new URL(channel.externalUrl).searchParams.get('v') || channel.externalUrl.match(/youtu\.be\/([^?]+)/)?.[1] || null; }
      catch { return null; }
    })();
    const safeBandcampEmbedUrl = (value: string) => {
      try {
        const parsed = new URL(value);
        return parsed.protocol === 'https:'
          && parsed.hostname === 'bandcamp.com'
          && parsed.pathname.startsWith('/EmbeddedPlayer/')
          && !/[?&]autoplay=1\b/i.test(parsed.href)
          ? parsed.href
          : null;
      } catch { return null; }
    };
    const safeSameVersionEmbedUrl = (value: string) => {
      try {
        const parsed = new URL(value);
        return parsed.protocol === 'https:'
          && parsed.hostname === 'open.spotify.com'
          && parsed.pathname.startsWith('/embed/')
          && !/[?&]autoplay=1\b/i.test(parsed.href)
          ? parsed.href
          : null;
      } catch { return null; }
    };
    const cassettePlayback = (channel: ArchivePlayerChannel) => {
      for (const candidate of channel.playback.candidates) {
        const embedUrl = candidate.kind.startsWith('bandcamp-')
          ? safeBandcampEmbedUrl(candidate.embedUrl)
          : safeSameVersionEmbedUrl(candidate.embedUrl);
        if (embedUrl) return { ...candidate, embedUrl };
      }
      return null;
    };
    const clearPlayback = () => { mmPanel.replaceChildren(); };

    const idleScreen = () => {
      const screen = document.createElement('div');
      screen.className = 'mm-crt';
      screen.setAttribute('aria-live', 'polite');
      const noise = document.createElement('div');
      noise.className = 'mm-crt-noise';
      noise.setAttribute('aria-hidden', 'true');
      const scan = document.createElement('div');
      scan.className = 'mm-crt-scan';
      scan.setAttribute('aria-hidden', 'true');
      const line = document.createElement('p');
      line.className = 'mm-await';
      line.append('AWAITING INPUT');
      const cursor = document.createElement('span');
      cursor.className = 'mm-cursor';
      cursor.setAttribute('aria-hidden', 'true');
      cursor.textContent = '_';
      line.append(cursor);
      screen.append(noise, scan, line);
      return screen;
    };
    const renderIdle = () => {
      mm.dataset.state = 'idle';
      mmTitle.textContent = 'STANDBY';
      mmReadout.textContent = '';
      mmTabs.replaceChildren();
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'archive-btn';
      tab.setAttribute('role', 'tab');
      tab.dataset.surface = 'INFO';
      tab.setAttribute('aria-selected', 'true');
      tab.tabIndex = 0;
      tab.textContent = 'INFO';
      mmTabs.append(tab);
      mmPanel.replaceChildren(idleScreen());
      const heading = document.createElement('p');
      heading.textContent = 'STREAMING';
      const empty = document.createElement('p');
      empty.textContent = 'AWAITING INPUT';
      mmDrawer.replaceChildren(heading, empty);
    };
    const crtWrap = (content: HTMLElement, extraClass = '') => {
      const screen = document.createElement('div');
      screen.className = `mm-crt${extraClass ? ` ${extraClass}` : ''}`;
      const scan = document.createElement('div');
      scan.className = 'mm-crt-scan';
      scan.setAttribute('aria-hidden', 'true');
      const body = document.createElement('div');
      body.className = 'mm-crt-body';
      body.append(content);
      screen.append(scan, body);
      return screen;
    };

    const factsList = (facts: ArchivePlayerFact[]) => {
      const list = document.createElement('dl');
      for (const fact of facts) {
        const term = document.createElement('dt');
        const value = document.createElement('dd');
        term.textContent = fact.label;
        if (fact.url) {
          const anchor = document.createElement('a');
          anchor.href = fact.url;
          anchor.target = '_blank';
          anchor.rel = 'noopener noreferrer';
          anchor.textContent = `${fact.value} ↗`;
          value.append(anchor);
        } else value.textContent = fact.value;
        list.append(term, value);
      }
      return list;
    };

    const infoFacts = () => {
      const channel = selectedChannel('cassette') ?? selectedChannel('vhs');
      const facts = channel?.facts?.length ? [...channel.facts] : [];
      if (!facts.length && openSong) {
        const rows: ArchivePlayerFact[] = [
          { label: 'PROJECT', value: openSong.projectNames.join(' / ') },
          { label: 'DATE', value: openSong.date ? [openSong.date.value, openSong.date.precision].filter(Boolean).join(' · ') : '' },
          { label: 'WRITING', value: openSong.writing ?? '' },
          { label: 'LYRICS', value: openSong.lyrics ?? '' },
          { label: 'RELEASE', value: openSong.releases.map((release) => release.title).filter(Boolean).join(' / ') },
        ].filter((fact) => fact.value);
        facts.push(...rows);
      }
      if (openVersion && openVersion.lyricState !== 'public' && !facts.some((fact) => fact.label === 'LYRICS' && fact.value === 'LYRICS NOT AVAILABLE')) {
        facts.push({ label: 'LYRICS', value: 'LYRICS NOT AVAILABLE' });
      }
      if (openVersion?.recordingId) facts.unshift({ label: 'RECORDING ID', value: openVersion.recordingId });
      if (openVersion?.releaseId) facts.unshift({ label: 'RELEASE ID', value: openVersion.releaseId });
      facts.unshift({ label: 'SONG ID', value: openSong?.id ?? '' });
      return facts.filter((fact) => fact.value);
    };

    const renderPlayer = (type: 'vhs' | 'cassette') => {
      const channel = selectedChannel(type);
      const stage = document.createElement('div');
      stage.className = type === 'vhs' ? 'mm-watch' : 'mm-cassette';
      const screen = document.createElement('div');
      screen.className = type === 'vhs' ? 'mm-watch-screen' : 'mm-cassette-window';
      const status = document.createElement('p');
      status.className = 'mm-player-status';
      if (!channel) {
        const message = document.createElement('p');
        message.textContent = type === 'vhs' ? 'NO VERIFIED WATCH SOURCE' : 'NO VERIFIED LISTEN SOURCE';
        screen.append(message);
        status.textContent = 'STANDBY';
        if (type === 'vhs') {
          const bezel = document.createElement('div');
          bezel.className = 'mm-watch-bezel';
          bezel.append(screen);
          stage.append(status, bezel);
        } else {
          stage.append(status, cassetteShell(screen));
        }
        mmPanel.append(stage);
        return;
      }
      const selectedPlayback = type === 'cassette' ? cassettePlayback(channel) : null;
      let embedUrl = selectedPlayback?.embedUrl ?? null;
      if (type === 'vhs') {
        const id = youtubeId(channel);
        embedUrl = id ? `https://www.youtube-nocookie.com/embed/${id}?playsinline=1&rel=0` : null;
      }
      if (embedUrl) {
        const frame = document.createElement('iframe');
        frame.src = embedUrl;
        frame.title = `${channel.title} — ${channel.versionLabel} ${type === 'vhs' ? 'video' : 'audio'} player`;
        frame.loading = 'lazy';
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.allow = type === 'vhs' ? 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' : 'encrypted-media';
        frame.allowFullscreen = type === 'vhs';
        screen.append(frame);
        if (selectedPlayback?.kind.startsWith('bandcamp-')) {
          const attribution = document.createElement('a');
          attribution.className = 'mm-bandcamp-attribution';
          attribution.href = selectedPlayback.attributionUrl;
          attribution.target = '_blank';
          attribution.rel = 'noopener noreferrer';
          attribution.textContent = selectedPlayback.releaseFallback
            ? 'BANDCAMP RELEASE PLAYER FALLBACK / OPEN RELEASE ↗'
            : 'BANDCAMP EXACT TRACK / OPEN TRACK ↗';
          screen.append(attribution);
        }
      } else {
        const message = document.createElement('p');
        message.textContent = type === 'vhs' ? 'NO VERIFIED WATCH SOURCE' : 'NO VERIFIED ON-PAGE LISTEN PLAYER';
        screen.append(message);
        const url = channel.playback.attributionUrl || channel.externalUrl;
        if (url) {
          const anchor = document.createElement('a');
          anchor.href = url;
          anchor.target = '_blank';
          anchor.rel = 'noopener noreferrer';
          anchor.textContent = `${channel.platform === 'Bandcamp' ? 'PLAY ON BANDCAMP' : `OPEN ${channel.platform.toUpperCase()}`} ↗`;
          screen.append(anchor);
        }
      }
      status.textContent = `${channel.id} / ${channel.projectName.toUpperCase()} / ${channel.platform.toUpperCase()}`;
      if (type === 'vhs') {
        const bezel = document.createElement('div');
        bezel.className = 'mm-watch-bezel';
        bezel.append(screen);
        stage.append(status, bezel);
      } else {
        stage.append(status, cassetteShell(screen));
      }
      mmPanel.append(stage);
    };
    const cassetteShell = (windowEl: HTMLElement) => {
      const deck = document.createElement('div');
      deck.className = 'mm-cassette-deck';
      const grille = document.createElement('div');
      grille.className = 'mm-cassette-grille';
      grille.setAttribute('aria-hidden', 'true');
      for (let index = 0; index < 14; index += 1) grille.append(document.createElement('i'));
      const shell = document.createElement('div');
      shell.className = 'mm-cassette-shell';
      const screws = document.createElement('div');
      screws.className = 'mm-cassette-screws';
      screws.setAttribute('aria-hidden', 'true');
      screws.append(document.createElement('i'), document.createElement('i'), document.createElement('i'), document.createElement('i'));
      const reels = document.createElement('div');
      reels.className = 'mm-cassette-reels';
      reels.setAttribute('aria-hidden', 'true');
      const left = document.createElement('span');
      const right = document.createElement('span');
      reels.append(left, right);
      const teeth = document.createElement('div');
      teeth.className = 'mm-cassette-teeth';
      teeth.setAttribute('aria-hidden', 'true');
      for (let index = 0; index < 8; index += 1) teeth.append(document.createElement('i'));
      shell.append(screws, reels, windowEl, teeth);
      const transport = document.createElement('div');
      transport.className = 'mm-cassette-transport';
      transport.setAttribute('aria-hidden', 'true');
      for (let index = 0; index < 5; index += 1) transport.append(document.createElement('b'));
      deck.append(grille, shell, transport);
      return deck;
    };

    const renderLyrics = () => {
      const lyric = (openVersion?.lyricIds ?? []).map((id) => lyricById.get(id)).find((item) => item?.state === 'public' && item.text);
      if (!lyric) {
        const message = document.createElement('p');
        message.textContent = 'LYRICS NOT AVAILABLE';
        mmPanel.append(crtWrap(message));
        return;
      }
      const credit = document.createElement('p');
      credit.className = 'mm-lyric-credit';
      credit.textContent = `LYRICS / ${lyric.authors} · ${lyric.version}`;
      const copy = document.createElement('pre');
      copy.textContent = lyric.text;
      const body = document.createElement('div');
      body.append(credit, copy);
      if (lyric.sampleTreatment) {
        const sample = document.createElement('p');
        sample.className = 'mm-sample-note';
        sample.textContent = lyric.sampleTreatment;
        body.append(sample);
      }
      mmPanel.append(crtWrap(body));
    };

    const renderVersions = () => {
      const list = document.createElement('div');
      list.className = 'archive-mm-versions';
      for (const version of openSong?.versions ?? []) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'mm-version-link';
        button.dataset.versionKey = version.key;
        if (version.key === openVersion?.key) button.setAttribute('aria-current', 'true');
        button.textContent = [version.projectName, version.label, version.recordingId || version.releaseId, version.datePrecision].filter(Boolean).join(' / ');
        list.append(button);
      }
      mmPanel.append(crtWrap(list));
    };

    const renderDrawer = () => {
      mmDrawer.replaceChildren();
      const heading = document.createElement('p');
      heading.textContent = 'STREAMING';
      const list = document.createElement('ul');
      const destinations = openVersion?.destinations ?? [];
      if (!destinations.length) {
        const empty = document.createElement('p');
        empty.textContent = 'NO VERIFIED STREAMING DESTINATION';
        mmDrawer.append(heading, empty);
        return;
      }
      for (const destination of destinations) {
        const row = document.createElement('li');
        const anchor = document.createElement('a');
        const label = destination.kind === 'smart-link' ? 'SMART LINK'
          : destination.kind === 'release-page' ? 'RELEASE PAGE'
          : 'EXACT TRACK';
        anchor.href = destination.url;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        anchor.textContent = `${destination.platform.toUpperCase()} / ${label} ↗`;
        const level = document.createElement('span');
        level.textContent = label;
        row.append(anchor, level);
        list.append(row);
      }
      mmDrawer.append(heading, list);
    };

    const renderSurface = () => {
      clearPlayback();
      if (openSurface === 'INFO') mmPanel.append(crtWrap(factsList(infoFacts()), 'mm-crt--info'));
      else if (openSurface === 'LISTEN') renderPlayer('cassette');
      else if (openSurface === 'WATCH') renderPlayer('vhs');
      else if (openSurface === 'LYRICS') renderLyrics();
      else renderVersions();
    };

    const renderTabs = () => {
      const surfaces = surfacesFor(openVersion);
      if (!surfaces.includes(openSurface)) openSurface = 'INFO';
      mmTabs.replaceChildren();
      for (const surface of surfaces) {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'archive-btn';
        tab.setAttribute('role', 'tab');
        tab.id = `archive-mm-tab-${surface.toLowerCase()}`;
        tab.dataset.surface = surface;
        tab.setAttribute('aria-selected', String(surface === openSurface));
        tab.tabIndex = surface === openSurface ? 0 : -1;
        tab.textContent = surface;
        mmTabs.append(tab);
      }
    };

    const renderMachine = (focus = false) => {
      if (!openSong || !openVersion) {
        renderIdle();
        return;
      }
      mm.dataset.state = 'open';
      mmTitle.textContent = openSong.title;
      const channel = selectedChannel(openSurface === 'WATCH' ? 'vhs' : 'cassette') ?? selectedChannel('vhs') ?? selectedChannel('cassette');
      mmReadout.textContent = [openSong.id, openVersion.releaseId, channel?.id, openVersion.projectName].filter(Boolean).join(' / ');
      renderTabs();
      renderSurface();
      renderDrawer();
      if (focus) {
        mmTitle.focus({ preventScroll: true });
        mm.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      }
    };

    const closeMachine = (recordHistory = true) => {
      openSong = null;
      openVersion = null;
      openSurface = 'INFO';
      clearPlayback();
      renderIdle();
      if (recordHistory) writeParams(null, null);
      moreButton?.focus();
    };

    const openMachine = (item: SearchItem, channelId: string | null, surface: Surface | null, recordHistory = true, replace = false) => {
      const version = versionForChannel(item, channelId);
      if (!version) return;
      openSong = item;
      openVersion = version;
      const validChannelId = channelId && (version.listenChannelIds.includes(channelId) || version.watchChannelIds.includes(channelId))
        ? channelId : null;
      const channel = validChannelId ? channelById.get(validChannelId) ?? null : null;
      openSurface = surface ?? (channel?.type === 'vhs' ? 'WATCH' : channel?.type === 'cassette' ? 'LISTEN' : 'INFO');
      const surfaces = surfacesFor(version);
      if (!surfaces.includes(openSurface)) openSurface = 'INFO';
      if (recordHistory) writeParams(item.id, validChannelId, replace);
      pageToSong(item);
      render();
      moreButton = results.querySelector<HTMLButtonElement>(`[data-song-id="${item.id}"]`);
      renderMachine(true);
    };

    const applyDeepLink = (recordHistory = false) => {
      const { song, channel } = params();
      if (!song) {
        if (openSong) closeMachine(false);
        return;
      }
      const item = itemById.get(song);
      if (!item) {
        if (openSong) closeMachine(false);
        return;
      }
      openMachine(item, channel, channel ? null : 'INFO', recordHistory, true);
    };

    fetch('/data/music-archive/v04/archive.json', { cache: 'no-store' })
      .then((response) => { if (!response.ok) throw new Error('archive data unavailable'); return response.json(); })
      .then((archive: ArchiveData) => {
        if (archive.meta.schemaVersion !== 'music-archive-v04.0' || archive.meta.publicKnownSongs !== 215 || archive.meta.counts.playerChannels !== 409 || archive.meta.counts.lyrics !== 147 || archive.meta.counts.bandcampEmbedRegistry !== 139) throw new Error('public v04 contract mismatch');
        data = archive;
        items = makeItems(archive);
        itemById = byId(items);
        channelById = byId(archive.playerChannels);
        lyricById = byId(archive.lyrics);
        const decadeFilter = filters.find((filter) => filter.dataset.filter === 'decade')!;
        for (const decade of archive.facets.decades) decadeFilter.append(option(decade, decade.toUpperCase()));
        const projectFilter = filters.find((filter) => filter.dataset.filter === 'project')!;
        for (const project of archive.facets.projects) projectFilter.append(option(project.id, project.name.toUpperCase()));
        const platformFilter = filters.find((filter) => filter.dataset.filter === 'platform')!;
        for (const platform of archive.facets.platforms) platformFilter.append(option(platform, platform.toUpperCase()));
        projectFilter.value = archive.meta.latestView.projectId;
        if (!latestView) decadeFilter.value = defaultDecade;
        search.disabled = false;
        reset.disabled = false;
        filters.forEach((filter) => { filter.disabled = false; });
        loadingState.hidden = true;
        render();
        applyDeepLink(false);
      })
      .catch(() => {
        loadingState.hidden = true;
        errorState.hidden = false;
        resultCount.textContent = 'ARCHIVE OFFLINE';
      });

    search.addEventListener('input', () => { latestView = false; currentPage = 1; render(); });
    filters.forEach((filter) => filter.addEventListener('change', () => {
      latestView = false;
      currentPage = 1;
      const decadeFilter = filters.find((item) => item.dataset.filter === 'decade')!;
      const projectFilter = filters.find((item) => item.dataset.filter === 'project')!;
      const project = isAll(projectFilter.value) ? '' : projectFilter.value;
      const decade = isAll(decadeFilter.value) ? '' : decadeFilter.value;
      if (project && decade && !items.some((item) => item.projectIds.includes(project) && item.decade === decade)) {
        decadeFilter.value = 'all';
      }
      render();
    }));
    reset.addEventListener('click', () => {
      latestView = false;
      currentPage = 1;
      search.value = '';
      filters.forEach((filter) => { filter.value = 'all'; });
      filters.find((filter) => filter.dataset.filter === 'decade')!.value = defaultDecade;
      filters.find((filter) => filter.dataset.filter === 'project')!.value = data.meta.latestView.projectId;
      render();
      search.focus();
    });
    pageSelect.addEventListener('change', () => {
      currentPage = Number(pageSelect.value) || 1;
      render();
    });
    pageButtons.forEach((button) => button.addEventListener('click', () => {
      currentPage += Number(button.dataset.pageStep);
      render();
    }));
    results.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-media-action="more"]');
      const item = button?.dataset.songId ? itemById.get(button.dataset.songId) : null;
      if (!item || !button) return;
      moreButton = button;
      openMachine(item, null, 'INFO');
    });
    mmTabs.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-surface]');
      const surface = tab?.dataset.surface as Surface | undefined;
      if (!surface || !openSong || !openVersion) return;
      openSurface = surface;
      renderMachine();
    });
    mmTabs.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      const tabs = [...mmTabs.querySelectorAll<HTMLButtonElement>('[data-surface]')];
      const index = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
      next?.click();
      next?.focus();
      event.preventDefault();
    });
    mmPanel.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-version-key]');
      const key = button?.dataset.versionKey;
      const version = openSong?.versions.find((item) => item.key === key);
      if (!openSong || !version) return;
      const channelId = version.listenChannelIds[0] ?? version.watchChannelIds[0] ?? null;
      openMachine(openSong, channelId, 'INFO', true);
    });
    machine.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mm.dataset.state === 'open') {
        event.preventDefault();
        closeMachine(true);
      }
    });
    mm.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mm.dataset.state === 'open') {
        event.preventDefault();
        closeMachine(true);
      }
    });
    window.addEventListener('popstate', () => applyDeepLink(false));
  }
</script>

<style>
