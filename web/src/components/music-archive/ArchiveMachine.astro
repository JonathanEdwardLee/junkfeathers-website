<section class="archive-machine" data-archive-machine>
  <div class="archive-console-top">
    <header class="archive-header">
      <div>
        <p class="archive-kicker">JF / MUSIC CATALOG</p>
        <h1>MUSIC ARCHIVE</h1>
        <p class="archive-intro">Welcome to my Music Archive Machine &mdash; a collection of songs I've written, songs I've collaborated on with others, and also the music of the bands I've been in over the years. This machine is an ongoing project as I compile older projects with newer ones in one collection. Thank you for being here and enjoy!</p>
      </div>
      <div class="archive-counter" aria-label="215 known songs">
        <strong>215</strong>
        <span>KNOWN SONGS</span>
      </div>
    </header>

    <div class="archive-machine-art" aria-hidden="true">
      <div class="archive-head">
        <i></i><i></i><i></i>
      </div>
      <div class="archive-index-strip">
        <span>01</span><span>03</span><span>05</span><span>07</span><span>10</span>
      </div>
      <div class="archive-art-status">
        <span>INDEX / V03.2</span>
        <strong>READ HEAD ACTIVE</strong>
      </div>
    </div>
  </div>

  <div class="archive-controls" aria-label="Archive search controls">
    <label class="archive-search-label" for="archive-search">SEARCH THE ARCHIVE</label>
    <input id="archive-search" type="search" inputmode="search" autocomplete="off" placeholder="SONG, PROJECT / BAND, RELEASE, HISTORICAL TITLE&hellip;" data-archive-search disabled />

    <div class="archive-filter-grid">
      <label>
        <span>DECADE</span>
        <select data-filter="decade" disabled>
          <option value="">ALL DECADES</option>
        </select>
      </label>
      <label>
        <span>PROJECT / BAND</span>
        <select data-filter="project" disabled>
          <option value="">ALL PROJECTS / BANDS</option>
        </select>
      </label>
      <label>
        <span>STREAMING PLATFORM</span>
        <select data-filter="platform" disabled>
          <option value="">ALL STREAMING PLATFORMS</option>
        </select>
      </label>
    </div>

    <div class="archive-control-footer">
      <p class="archive-result-count" role="status" aria-live="polite" data-result-count>LOADING ARCHIVE SIGNAL&hellip;</p>
      <button type="button" class="archive-reset" data-reset disabled>RESET SEARCH</button>
    </div>
  </div>

  <div class="archive-output">
    <div class="archive-state" data-loading-state>
      <span class="archive-pulse" aria-hidden="true"></span>
      VERIFYING PUBLIC CATALOG&hellip;
    </div>
    <div class="archive-state archive-state--error" data-error-state hidden>
      ARCHIVE SIGNAL UNAVAILABLE. THE MUSIC PAGE IS STILL ONLINE; TRY THIS MACHINE AGAIN LATER.
    </div>
    <div class="archive-state" data-no-results hidden>
      NO MATCHING SIGNAL. ADJUST THE SEARCH OR RESET THE FILTERS.
    </div>

    <div class="archive-results" data-results aria-label="Archive results"></div>
    <p class="archive-limit-note" data-limit-note hidden></p>

    <div class="archive-player-rack" aria-label="Persistent archive players">
      <section class="archive-player archive-player--vhs" aria-labelledby="archive-vhs-title" data-player="vhs">
        <div class="archive-player-heading">
          <div><p>VHS VIDEO PLAYER</p><h2 id="archive-vhs-title" tabindex="-1" data-player-title>SELECT WATCH</h2></div>
          <span data-player-channel>VHS / STANDBY</span>
        </div>
        <p class="archive-player-status" role="status" aria-live="polite" data-player-status>NO VIDEO CHANNEL SELECTED</p>
        <div class="archive-player-screen" data-player-screen><p>VHS SIGNAL STANDBY</p></div>
        <div class="archive-channel-controls" data-channel-controls hidden>
          <button type="button" data-channel-step="-1" aria-label="Previous video channel">&#9664; PREV</button>
          <span data-channel-position></span>
          <button type="button" data-channel-step="1" aria-label="Next video channel">NEXT &#9654;</button>
        </div>
        <div class="archive-version-info" data-player-info><p>Choose WATCH on an archive card. The machine will stay with that exact project and recording context.</p></div>
        <details class="archive-lyrics" data-player-lyrics hidden><summary>READ LYRICS</summary><div data-lyrics-content></div></details>
        <details class="archive-stream-links" data-player-links hidden><summary>STREAM / LINKS</summary><div data-links-content></div></details>
      </section>

      <section class="archive-player archive-player--cassette" aria-labelledby="archive-cassette-title" data-player="cassette">
        <div class="archive-player-heading">
          <div><p>CASSETTE AUDIO PLAYER</p><h2 id="archive-cassette-title" tabindex="-1" data-player-title>SELECT LISTEN</h2></div>
          <span data-player-channel>CASSETTE / STANDBY</span>
        </div>
        <p class="archive-player-status" role="status" aria-live="polite" data-player-status>NO AUDIO CHANNEL SELECTED</p>
        <div class="archive-player-screen" data-player-screen><p>CASSETTE SIGNAL STANDBY</p></div>
        <div class="archive-channel-controls" data-channel-controls hidden>
          <button type="button" data-channel-step="-1" aria-label="Previous audio channel">&#9664; PREV</button>
          <span data-channel-position></span>
          <button type="button" data-channel-step="1" aria-label="Next audio channel">NEXT &#9654;</button>
        </div>
        <div class="archive-version-info" data-player-info><p>Choose LISTEN on an archive card. Bandcamp is selected first when the exact recording has supported playback.</p></div>
        <details class="archive-lyrics" data-player-lyrics hidden><summary>READ LYRICS</summary><div data-lyrics-content></div></details>
        <details class="archive-stream-links" data-player-links hidden><summary>STREAM / LINKS</summary><div data-links-content></div></details>
      </section>
    </div>

    <noscript>
      <p class="archive-noscript">Interactive archive search requires JavaScript. The existing music transmission remains available on the <a href="/music/">Music page <span aria-hidden="true">&#8599;</span></a>.</p>
    </noscript>
  </div>
</section>

<script>
  interface ArchiveProject { id: string; name: string }
  interface ArchiveRelease { id: string; title: string; artist: string; date: string | null; year: string | null; datePrecision: string | null }
  interface ArchiveRecording { id: string; title: string; version: string | null; duration: string | null; artist: string; leadVocal: string | null }
  interface ArchiveSongLink {
    id: string; songId: string; platform: string; priority: number; url: string; linkLevel: string;
    releaseTitle: string | null; mediaId: string | null; embedUrl: string | null; supportContext: string | null;
  }
  interface ArchiveSong {
    id: string; title: string; aliases: string[]; projectIds: string[]; projectNames: string[];
    recordingIds: string[]; releaseIds: string[]; linkIds: string[]; eligibility: string;
    alternateTitle: string | null; writing: string | null; lyrics: string | null; vocal: string | null;
    acoustic: boolean; creditStatus: string; linerNotes: string | null; decade: string | null;
    contexts: string[]; date: { value: string; precision: string | null; releaseId: string } | null;
  }
  interface ArchivePlayerFact { label: string; value: string; url?: string }
  interface ArchivePlayerLink { label: string; platform: string; url: string; level: string }
  interface ArchivePlaybackCandidate {
    kind: 'bandcamp-track' | 'bandcamp-album-fallback' | 'same-version';
    label: string; embedUrl: string; registryId: string | null; attributionUrl: string;
    releaseFallback: boolean;
  }
  interface ArchivePlayback {
    kind: ArchivePlaybackCandidate['kind'] | 'external'; label: string; embedUrl: string | null;
    registryId: string | null; attributionUrl: string; releaseFallback: boolean;
    candidates: ArchivePlaybackCandidate[];
  }
  interface ArchiveLyric {
    id: string; songId: string; title: string; version: string; text: string; authors: string;
    sourceType: string; evidence: string; rights: string; sampleTreatment: string | null;
  }
  interface ArchivePlayerChannel {
    id: string; songId: string; title: string; type: 'vhs' | 'cassette'; order: number; label: string;
    recordingId: string; releaseId: string; versionLabel: string; platform: string; songLinkId: string;
    playbackMethod: string; externalUrl: string; datePrecision: string; projectId: string; projectName: string;
    mediaId: string | null; embedUrl: string | null; playback: ArchivePlayback; facts: ArchivePlayerFact[];
    streamLinks: ArchivePlayerLink[]; lyrics: ArchiveLyric[];
  }
  interface ArchiveData {
    meta: {
      schemaVersion: string;
      publicKnownSongs: number;
      counts: { songs: number; songLinks: number; playerChannels: number; lyrics: number; bandcampEmbedRegistry: number };
      latestView: { projectId: string; releaseId: string; releaseTitle: string; songIds: string[] };
    };
    facets: { decades: string[]; projects: ArchiveProject[]; platforms: string[] };
    projects: ArchiveProject[]; songs: ArchiveSong[]; releases: ArchiveRelease[];
    recordings: ArchiveRecording[]; songLinks: ArchiveSongLink[]; playerChannels: ArchivePlayerChannel[];
  }
  interface SearchItem extends ArchiveSong {
    searchText: string;
    releases: ArchiveRelease[];
    versions: ArchiveRecording[];
    links: ArchiveSongLink[];
  }

  const machine = document.querySelector<HTMLElement>('[data-archive-machine]');
  if (machine) {
    const search = machine.querySelector<HTMLInputElement>('[data-archive-search]')!;
    const filters = [...machine.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const reset = machine.querySelector<HTMLButtonElement>('[data-reset]')!;
    const results = machine.querySelector<HTMLElement>('[data-results]')!;
    const resultCount = machine.querySelector<HTMLElement>('[data-result-count]')!;
    const loadingState = machine.querySelector<HTMLElement>('[data-loading-state]')!;
    const errorState = machine.querySelector<HTMLElement>('[data-error-state]')!;
    const noResults = machine.querySelector<HTMLElement>('[data-no-results]')!;
    const limitNote = machine.querySelector<HTMLElement>('[data-limit-note]')!;
    const playerElements = [...machine.querySelectorAll<HTMLElement>('[data-player]')];
    const resultLimit = 40;
    const defaultLimit = 16;
    const defaultDecade = '2020s';
    let data: ArchiveData;
    let items: SearchItem[] = [];
    let itemById = new Map<string, SearchItem>();
    let latestView = new URLSearchParams(window.location.search).get('view') === 'latest';
    const playerState = new Map<'vhs' | 'cassette', { channels: ArchivePlayerChannel[]; index: number }>();

    const normalize = (value: unknown) => String(value ?? '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const byId = <T extends { id: string }>(values: T[]) => new Map(values.map((value) => [value.id, value]));
    const option = (value: string, label: string) => {
      const element = document.createElement('option');
      element.value = value;
      element.textContent = label;
      return element;
    };
    const appendText = (element: HTMLElement, label: string, value: string | null | undefined) => {
      if (!value) return;
      const item = document.createElement('li');
      const key = document.createElement('span');
      const content = document.createElement('strong');
      key.textContent = label;
      content.textContent = value;
      item.append(key, content);
      element.append(item);
    };
    const selectedProjectId = (item: SearchItem) => {
      const selected = filters.find((filter) => filter.dataset.filter === 'project')?.value;
      return selected && item.projectIds.includes(selected) ? selected : item.projectIds[0] ?? '';
    };
    const matchingChannels = (item: SearchItem, type: 'vhs' | 'cassette') => data.playerChannels
      .filter((channel) => channel.songId === item.id && channel.projectId === selectedProjectId(item) && channel.type === type)
      .sort((left, right) => left.order - right.order || left.id.localeCompare(right.id));

    const makeItems = (archive: ArchiveData) => {
      const releases = byId(archive.releases);
      const recordings = byId(archive.recordings);
      const links = byId(archive.songLinks);
      return archive.songs.map((song) => {
        const songReleases = song.releaseIds.map((id) => releases.get(id)).filter((value): value is ArchiveRelease => Boolean(value));
        const versions = song.recordingIds.map((id) => recordings.get(id)).filter((value): value is ArchiveRecording => Boolean(value));
        const songLinks = song.linkIds.map((id) => links.get(id)).filter((value): value is ArchiveSongLink => Boolean(value));
        return {
          ...song,
          releases: songReleases,
          versions,
          links: songLinks,
          searchText: normalize([
            song.title, ...song.aliases, ...song.projectNames,
            ...songReleases.flatMap((release) => [release.title, release.artist]),
            ...versions.flatMap((version) => [version.title, version.version, version.artist]),
          ].join(' ')),
        };
      });
    };

    const card = (item: SearchItem) => {
      const article = document.createElement('article');
      article.className = 'archive-card';
      article.dataset.songId = item.id;
      const head = document.createElement('div');
      head.className = 'archive-card-head';
      const type = document.createElement('span');
      type.className = 'archive-type';
      type.textContent = item.eligibility === 'Yes' ? 'SONG' : item.eligibility.startsWith('Pending') ? 'ARCHIVE / PENDING' : 'ARCHIVE ENTRY';
      const id = document.createElement('span');
      id.className = 'archive-id';
      id.textContent = item.id;
      head.append(type, id);

      const title = document.createElement('h2');
      title.textContent = item.title;
      const subtitle = document.createElement('p');
      subtitle.className = 'archive-subtitle';
      subtitle.textContent = item.projectNames.join(' / ');
      const credits = document.createElement('ul');
      credits.className = 'archive-meta';
      const dateLabel = item.date ? [item.date.value, item.date.precision].filter(Boolean).join(' · ') : null;
      appendText(credits, 'DATE', dateLabel);
      appendText(credits, 'WRITING', item.writing);
      appendText(credits, 'LYRICS', item.lyrics);
      appendText(credits, item.vocal === 'Instrumental' ? 'VOICE' : 'SINGER(S)', item.vocal);
      if (item.acoustic) appendText(credits, 'FORMAT', 'ACOUSTIC');
      appendText(credits, 'RELEASE', item.releases.map((release) => release.title).filter((value, index, values) => values.indexOf(value) === index).slice(0, 3).join(' / '));
      appendText(credits, 'VERSION', item.versions.map((version) => version.version).filter((value): value is string => Boolean(value)).filter((value, index, values) => values.indexOf(value) === index).slice(0, 2).join(' / '));

      article.append(head, title);
      if (item.alternateTitle) {
        const alternate = document.createElement('p');
        alternate.className = 'archive-alternate';
        alternate.textContent = `ALSO KNOWN AS / ${item.alternateTitle}`;
        article.append(alternate);
      }
      if (item.projectNames.length) article.append(subtitle);
      if (credits.childElementCount) article.append(credits);

      const actions = document.createElement('div');
      actions.className = 'archive-actions';
      for (const [mode, type] of [['listen', 'cassette'], ['watch', 'vhs']] as const) {
        const channels = matchingChannels(item, type);
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.mediaAction = mode;
        button.dataset.songId = item.id;
        button.disabled = channels.length === 0;
        button.setAttribute('aria-label', channels.length ? `${mode === 'watch' ? 'Watch' : 'Listen to'} ${item.title} in ${selectedProjectId(item) ? data.projects.find((project) => project.id === selectedProjectId(item))?.name ?? 'the selected project' : 'its archive context'}` : `${mode.toUpperCase()} unavailable for ${item.title} in this project context`);
        button.textContent = mode.toUpperCase();
        actions.append(button);
      }
      article.append(actions);
      return article;
    };

    const render = () => {
      const query = normalize(search.value);
      const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.filter!, filter.value]));
      const hasInput = Boolean(query || Object.values(selected).some(Boolean));
      const tokens = query.split(' ').filter(Boolean);
      const matching = items.filter((item) =>
        tokens.every((token) => item.searchText.includes(token)) &&
        (!selected.decade || item.decade === selected.decade) &&
        (!selected.project || item.projectIds.includes(selected.project)) &&
        (!selected.platform || item.links.some((link) => link.platform === selected.platform))
      );
      const showingLatest = latestView && !query && selected.project === data.meta.latestView.projectId && !selected.decade && !selected.platform;
      const latestIds = new Set(data.meta.latestView.songIds);
      const display = showingLatest
        ? matching.filter((item) => latestIds.has(item.id))
        : hasInput
          ? matching.slice(0, resultLimit)
          : items.filter((item) => item.eligibility === 'Yes' && !item.projectIds.includes('PRJ-PROJ-001')).slice(0, defaultLimit);
      resultCount.textContent = showingLatest
        ? `${data.meta.latestView.releaseTitle.toUpperCase()} / ${display.length} SONG${display.length === 1 ? '' : 'S'}`
        : hasInput
          ? `${matching.length} MATCH${matching.length === 1 ? '' : 'ES'}`
          : `${data.meta.counts.songs} ARCHIVE ENTRIES / SHOWING ${display.length}`;
      noResults.hidden = display.length > 0;
      limitNote.hidden = showingLatest || !hasInput || matching.length <= resultLimit;
      if (!limitNote.hidden) limitNote.textContent = `SHOWING FIRST ${resultLimit} OF ${matching.length} MATCHES. NARROW THE SEARCH FOR A SHORTER SIGNAL.`;
      results.replaceChildren(...display.map(card));
    };

    const playerElement = (type: 'vhs' | 'cassette') => machine.querySelector<HTMLElement>(`[data-player="${type}"]`)!;
    const youtubeId = (channel: ArchivePlayerChannel) => channel.mediaId || (() => {
      try { return new URL(channel.externalUrl).searchParams.get('v') || channel.externalUrl.match(/youtu\.be\/([^?]+)/)?.[1] || null; }
      catch { return null; }
    })();
    const safeBandcampEmbedUrl = (value: string) => {
      try {
        const parsed = new URL(value);
        return parsed.protocol === 'https:'
          && parsed.hostname === 'bandcamp.com'
          && parsed.pathname.startsWith('/EmbeddedPlayer/')
          && !/[?&]autoplay=1\b/i.test(parsed.href)
          ? parsed.href
          : null;
      } catch { return null; }
    };
    const safeSameVersionEmbedUrl = (value: string) => {
      try {
        const parsed = new URL(value);
        return parsed.protocol === 'https:'
          && parsed.hostname === 'open.spotify.com'
          && parsed.pathname.startsWith('/embed/')
          && !/[?&]autoplay=1\b/i.test(parsed.href)
          ? parsed.href
          : null;
      } catch { return null; }
    };
    const cassettePlayback = (channel: ArchivePlayerChannel) => {
      for (const candidate of channel.playback.candidates) {
        const embedUrl = candidate.kind.startsWith('bandcamp-')
          ? safeBandcampEmbedUrl(candidate.embedUrl)
          : safeSameVersionEmbedUrl(candidate.embedUrl);
        if (embedUrl) return { ...candidate, embedUrl };
      }
      return null;
    };
    const clearPlayback = () => {
      for (const element of playerElements) element.querySelector<HTMLElement>('[data-player-screen]')?.replaceChildren();
    };
    const renderPlayer = (type: 'vhs' | 'cassette', focus = false) => {
      const state = playerState.get(type);
      if (!state?.channels.length) return;
      const channel = state.channels[state.index];
      const element = playerElement(type);
      const title = element.querySelector<HTMLElement>('[data-player-title]')!;
      const channelLabel = element.querySelector<HTMLElement>('[data-player-channel]')!;
      const status = element.querySelector<HTMLElement>('[data-player-status]')!;
      const screen = element.querySelector<HTMLElement>('[data-player-screen]')!;
      const controls = element.querySelector<HTMLElement>('[data-channel-controls]')!;
      const position = element.querySelector<HTMLElement>('[data-channel-position]')!;
      const info = element.querySelector<HTMLElement>('[data-player-info]')!;
      const lyricPanel = element.querySelector<HTMLDetailsElement>('[data-player-lyrics]')!;
      const lyricContent = element.querySelector<HTMLElement>('[data-lyrics-content]')!;
      const linkPanel = element.querySelector<HTMLDetailsElement>('[data-player-links]')!;
      const linkContent = element.querySelector<HTMLElement>('[data-links-content]')!;

      clearPlayback();
      title.textContent = channel.title;
      channelLabel.textContent = `${channel.id} / ${channel.label}`;
      status.textContent = `${channel.projectName.toUpperCase()} / ${channel.platform.toUpperCase()} / READY — PLAYBACK NEVER STARTS AUTOMATICALLY`;
      controls.hidden = state.channels.length < 2;
      position.textContent = `CHANNEL ${state.index + 1} / ${state.channels.length}`;

      const selectedPlayback = type === 'cassette' ? cassettePlayback(channel) : null;
      let embedUrl = selectedPlayback?.embedUrl ?? null;
      if (type === 'vhs') {
        const id = youtubeId(channel);
        embedUrl = id ? `https://www.youtube-nocookie.com/embed/${id}?playsinline=1&rel=0` : null;
      }
      screen.classList.toggle('archive-player-screen--bandcamp', Boolean(selectedPlayback?.kind.startsWith('bandcamp-')));
      status.textContent = `${channel.projectName.toUpperCase()} / ${(selectedPlayback?.label ?? channel.platform).toUpperCase()} / READY — PLAYBACK NEVER STARTS AUTOMATICALLY`;
      if (embedUrl) {
        const frame = document.createElement('iframe');
        frame.src = embedUrl;
        frame.title = `${channel.title} — ${channel.versionLabel} ${type === 'vhs' ? 'video' : 'audio'} player`;
        frame.loading = 'lazy';
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.allow = type === 'vhs' ? 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' : 'encrypted-media';
        frame.allowFullscreen = type === 'vhs';
        screen.append(frame);
        if (selectedPlayback?.kind.startsWith('bandcamp-')) {
          const attribution = document.createElement('a');
          attribution.className = 'archive-bandcamp-attribution';
          attribution.href = selectedPlayback.attributionUrl;
          attribution.target = '_blank';
          attribution.rel = 'noopener noreferrer';
          attribution.textContent = selectedPlayback.releaseFallback
            ? 'BANDCAMP RELEASE PLAYER FALLBACK / OPEN RELEASE ↗'
            : 'BANDCAMP EXACT TRACK / OPEN TRACK ↗';
          screen.append(attribution);
        }
      } else {
        const fallback = document.createElement('div');
        fallback.className = 'archive-external-fallback';
        const message = document.createElement('p');
        message.textContent = 'ON-PAGE PLAYER UNAVAILABLE. THE EXACT PUBLIC SOURCE REMAINS AVAILABLE.';
        const anchor = document.createElement('a');
        anchor.href = channel.playback.attributionUrl || channel.externalUrl;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        anchor.textContent = `${channel.platform === 'Bandcamp' ? 'PLAY ON BANDCAMP' : `OPEN ${channel.platform.toUpperCase()}`} ↗`;
        fallback.append(message, anchor);
        screen.append(fallback);
      }

      const facts = document.createElement('dl');
      for (const fact of channel.facts) {
        const term = document.createElement('dt');
        const value = document.createElement('dd');
        term.textContent = fact.label;
        if (fact.url) {
          const anchor = document.createElement('a');
          anchor.href = fact.url;
          anchor.target = '_blank';
          anchor.rel = 'noopener noreferrer';
          anchor.textContent = `${fact.value} ↗`;
          value.append(anchor);
        } else value.textContent = fact.value;
        facts.append(term, value);
      }
      info.replaceChildren(facts);

      lyricContent.replaceChildren();
      lyricPanel.hidden = channel.lyrics.length === 0;
      lyricPanel.open = false;
      for (const lyric of channel.lyrics) {
        const credit = document.createElement('p');
        credit.className = 'archive-lyric-credit';
        credit.textContent = `LYRICS / ${lyric.authors} · ${lyric.version}`;
        const copy = document.createElement('pre');
        copy.textContent = lyric.text;
        lyricContent.append(credit, copy);
        if (lyric.sampleTreatment) {
          const sample = document.createElement('p');
          sample.className = 'archive-sample-note';
          sample.textContent = lyric.sampleTreatment;
          lyricContent.append(sample);
        }
      }

      linkContent.replaceChildren();
      linkPanel.hidden = channel.streamLinks.length === 0;
      linkPanel.open = false;
      const linkList = document.createElement('ul');
      for (const link of channel.streamLinks) {
        const row = document.createElement('li');
        const anchor = document.createElement('a');
        anchor.href = link.url;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        anchor.textContent = `${link.label.toUpperCase()} ↗`;
        const level = document.createElement('span');
        level.textContent = link.level;
        row.append(anchor, level);
        linkList.append(row);
      }
      linkContent.append(linkList);
      if (focus) {
        title.focus({ preventScroll: true });
        element.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      }
    };
    const loadPlayer = (item: SearchItem, type: 'vhs' | 'cassette') => {
      const channels = matchingChannels(item, type);
      if (!channels.length) return;
      const bandcampIndex = channels.findIndex((channel) => channel.platform === 'Bandcamp');
      playerState.set(type, { channels, index: type === 'cassette' && bandcampIndex >= 0 ? bandcampIndex : 0 });
      renderPlayer(type, true);
    };

    fetch('/data/music-archive/v03/archive.json', { cache: 'no-store' })
      .then((response) => { if (!response.ok) throw new Error('archive data unavailable'); return response.json(); })
      .then((archive: ArchiveData) => {
        if (archive.meta.schemaVersion !== 'music-archive-v03.2' || archive.meta.publicKnownSongs !== 215 || archive.meta.counts.songLinks !== 620 || archive.meta.counts.playerChannels !== 165 || archive.meta.counts.lyrics !== 26 || archive.meta.counts.bandcampEmbedRegistry !== 139) throw new Error('public v03.2 contract mismatch');
        data = archive;
        items = makeItems(archive);
        itemById = byId(items);
        const decadeFilter = filters.find((filter) => filter.dataset.filter === 'decade')!;
        for (const decade of archive.facets.decades) decadeFilter.append(option(decade, decade.toUpperCase()));
        const projectFilter = filters.find((filter) => filter.dataset.filter === 'project')!;
        for (const project of archive.facets.projects) projectFilter.append(option(project.id, project.name.toUpperCase()));
        const platformFilter = filters.find((filter) => filter.dataset.filter === 'platform')!;
        for (const platform of archive.facets.platforms) platformFilter.append(option(platform, platform.toUpperCase()));
        projectFilter.value = archive.meta.latestView.projectId;
        if (!latestView) decadeFilter.value = defaultDecade;
        search.disabled = false;
        reset.disabled = false;
        filters.forEach((filter) => { filter.disabled = false; });
        loadingState.hidden = true;
        render();
      })
      .catch(() => {
        loadingState.hidden = true;
        errorState.hidden = false;
        resultCount.textContent = 'ARCHIVE OFFLINE';
      });

    search.addEventListener('input', () => { latestView = false; render(); });
    filters.forEach((filter) => filter.addEventListener('change', () => { latestView = false; render(); }));
    reset.addEventListener('click', () => {
      latestView = false;
      search.value = '';
      filters.forEach((filter) => { filter.value = ''; });
      filters.find((filter) => filter.dataset.filter === 'decade')!.value = defaultDecade;
      filters.find((filter) => filter.dataset.filter === 'project')!.value = data.meta.latestView.projectId;
      render();
      search.focus();
    });
    results.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-media-action]');
      const item = button?.dataset.songId ? itemById.get(button.dataset.songId) : null;
      const mode = button?.dataset.mediaAction;
      if (item && mode === 'listen') loadPlayer(item, 'cassette');
      if (item && mode === 'watch') loadPlayer(item, 'vhs');
    });
    playerElements.forEach((element) => element.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-channel-step]');
      const type = element.dataset.player as 'vhs' | 'cassette';
      const state = playerState.get(type);
      if (!button || !state?.channels.length) return;
      state.index = (state.index + Number(button.dataset.channelStep) + state.channels.length) % state.channels.length;
      renderPlayer(type);
    }));
  }
</script>

