<section class="archive-machine" data-archive-machine>
  <header class="archive-header">
    <div>
      <p class="archive-kicker">JF / CATALOG SIGNAL 01</p>
      <h1>ARCHIVE MACHINE</h1>
      <p class="archive-intro">Search the known songs, versions, releases, projects, people, places, and listening links recovered so far.</p>
    </div>
    <div class="archive-counter" aria-label="195 known songs">
      <strong>195</strong>
      <span>KNOWN SONGS</span>
    </div>
  </header>

  <div class="archive-controls" aria-label="Archive search controls">
    <label class="archive-search-label" for="archive-search">SEARCH THE ARCHIVE</label>
    <input id="archive-search" type="search" inputmode="search" autocomplete="off" placeholder="SONG, PROJECT, RELEASE, PERSON, PLACE…" data-archive-search disabled />

    <div class="archive-filter-grid">
      <label>
        <span>TYPE</span>
        <select data-filter="type" disabled>
          <option value="">ALL TYPES</option>
        </select>
      </label>
      <label>
        <span>PROJECT</span>
        <select data-filter="project" disabled>
          <option value="">ALL PROJECTS</option>
        </select>
      </label>
      <label>
        <span>CONTRIBUTOR</span>
        <select data-filter="contributor" disabled>
          <option value="">ALL CONTRIBUTORS</option>
        </select>
      </label>
      <label>
        <span>PLATFORM</span>
        <select data-filter="platform" disabled>
          <option value="">ALL PLATFORMS</option>
        </select>
      </label>
    </div>

    <div class="archive-control-footer">
      <p class="archive-result-count" role="status" aria-live="polite" data-result-count>LOADING ARCHIVE SIGNAL…</p>
      <button type="button" class="archive-reset" data-reset disabled>RESET SEARCH</button>
    </div>
  </div>

  <div class="archive-state" data-loading-state>
    <span class="archive-pulse" aria-hidden="true"></span>
    VERIFYING PUBLIC CATALOG…
  </div>
  <div class="archive-state archive-state--error" data-error-state hidden>
    ARCHIVE SIGNAL UNAVAILABLE. THE MUSIC PAGE IS STILL ONLINE; TRY THIS MACHINE AGAIN LATER.
  </div>
  <div class="archive-state" data-empty-state hidden>
    ENTER A SEARCH OR USE A FILTER TO EXPLORE THE ARCHIVE.
  </div>
  <div class="archive-state" data-no-results hidden>
    NO MATCHING SIGNAL. ADJUST THE SEARCH OR RESET THE FILTERS.
  </div>

  <div class="archive-results" data-results aria-label="Archive results"></div>
  <p class="archive-limit-note" data-limit-note hidden></p>

  <noscript>
    <p class="archive-noscript">Interactive archive search requires JavaScript. The existing music transmission remains available on the <a href="/music/">Music page</a>.</p>
  </noscript>
</section>

<script>
  interface ArchiveLink { id: string; entityType: string; entityId: string; platform: string; type: string; url: string }
  interface ArchiveCredit { recordingId: string | null; releaseId: string | null; contributorId: string; role: string; instrument: string | null }
  interface ArchiveData {
    meta: { publicKnownSongs: number };
    songs: any[]; recordings: any[]; releases: any[]; projects: any[]; contributors: any[];
    credits: ArchiveCredit[]; links: ArchiveLink[]; events: any[]; participants: any[];
  }
  interface SearchItem {
    id: string; type: string; title: string; subtitle: string; meta: string[]; evidence: string;
    searchText: string; projectIds: string[]; contributorIds: string[]; platforms: string[];
    versions: any[]; links: ArchiveLink[];
  }

  const machine = document.querySelector<HTMLElement>('[data-archive-machine]');
  if (machine) {
    const search = machine.querySelector<HTMLInputElement>('[data-archive-search]')!;
    const filters = [...machine.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const reset = machine.querySelector<HTMLButtonElement>('[data-reset]')!;
    const results = machine.querySelector<HTMLElement>('[data-results]')!;
    const resultCount = machine.querySelector<HTMLElement>('[data-result-count]')!;
    const loadingState = machine.querySelector<HTMLElement>('[data-loading-state]')!;
    const errorState = machine.querySelector<HTMLElement>('[data-error-state]')!;
    const emptyState = machine.querySelector<HTMLElement>('[data-empty-state]')!;
    const noResults = machine.querySelector<HTMLElement>('[data-no-results]')!;
    const limitNote = machine.querySelector<HTMLElement>('[data-limit-note]')!;
    const resultLimit = 40;
    let items: SearchItem[] = [];

    const normalize = (value: unknown) => String(value ?? '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const byId = <T extends { id: string }>(values: T[]) => new Map(values.map((value) => [value.id, value]));
    const unique = (values: Array<string | null | undefined>) => [...new Set(values.filter(Boolean) as string[])];
    const option = (value: string, label: string) => {
      const element = document.createElement('option');
      element.value = value; element.textContent = label; return element;
    };

    const makeItems = (data: ArchiveData) => {
      const recordings = byId(data.recordings);
      const releases = byId(data.releases);
      const projects = byId(data.projects);
      const contributors = byId(data.contributors);
      const creditsByRecording = new Map<string, ArchiveCredit[]>();
      const creditsByRelease = new Map<string, ArchiveCredit[]>();
      for (const credit of data.credits) {
        if (credit.recordingId) creditsByRecording.set(credit.recordingId, [...(creditsByRecording.get(credit.recordingId) ?? []), credit]);
        if (credit.releaseId) creditsByRelease.set(credit.releaseId, [...(creditsByRelease.get(credit.releaseId) ?? []), credit]);
      }
      const linksFor = (id: string) => data.links.filter((link) => link.entityId === id);
      const creditTerms = (credits: ArchiveCredit[]) => credits.flatMap((credit) => {
        const contributor = contributors.get(credit.contributorId);
        return [contributor?.name, credit.role, credit.instrument].filter(Boolean);
      });
      const appearanceBase = (value: string) => value.split(':')[0];

      const songItems: SearchItem[] = data.songs.map((song) => {
        const appearances = unique(song.appearanceIds.map(appearanceBase));
        const songRecordings = appearances.map((id: string) => recordings.get(id)).filter(Boolean);
        const songReleases = appearances.map((id: string) => releases.get(id)).filter(Boolean);
        const recordingCredits = songRecordings.flatMap((recording: any) => creditsByRecording.get(recording.id) ?? []);
        const releaseCredits = songReleases.flatMap((release: any) => creditsByRelease.get(release.id) ?? []);
        const relatedLinks = unique([...songRecordings.map((recording: any) => recording.id), ...songReleases.map((release: any) => release.id)]).flatMap(linksFor);
        const projectNames = song.projectIds.map((id: string) => projects.get(id)?.name).filter(Boolean);
        return {
          id: song.id, type: 'song', title: song.title, subtitle: projectNames.join(' / ') || song.projectNames.join(' / '),
          meta: [song.cover ? 'COVER / EXTERNAL COMPOSITION' : 'SONG FAMILY', `${song.appearanceCount} KNOWN APPEARANCE${song.appearanceCount === 1 ? '' : 'S'}`], evidence: song.evidence,
          searchText: normalize([song.title, ...song.aliases, ...projectNames, ...songRecordings.flatMap((recording: any) => [recording.title, recording.version, recording.artist, recording.featured, recording.role]), ...songReleases.map((release: any) => release.title), ...creditTerms([...recordingCredits, ...releaseCredits]), ...relatedLinks.map((link) => link.platform)].join(' ')),
          projectIds: song.projectIds, contributorIds: unique([...recordingCredits, ...releaseCredits].map((credit) => credit.contributorId)), platforms: unique(relatedLinks.map((link) => link.platform)),
          versions: songRecordings, links: relatedLinks,
        };
      });

      const releaseItems: SearchItem[] = data.releases.map((release) => {
        const releaseRecordings = data.recordings.filter((recording) => recording.releaseId === release.id);
        const releaseCredits = [...(creditsByRelease.get(release.id) ?? []), ...releaseRecordings.flatMap((recording) => creditsByRecording.get(recording.id) ?? [])];
        const releaseLinks = linksFor(release.id);
        return {
          id: release.id, type: 'release', title: release.title, subtitle: [release.artist, projects.get(release.projectId)?.name].filter(Boolean).join(' / '),
          meta: [release.type, release.date ?? release.year ?? 'DATE UNKNOWN', release.datePrecision].filter(Boolean), evidence: release.evidence,
          searchText: normalize([release.title, release.artist, release.type, release.date, release.year, release.datePrecision, release.label, release.status, ...releaseRecordings.flatMap((recording) => [recording.title, recording.version]), ...creditTerms(releaseCredits), ...releaseLinks.map((link) => link.platform)].join(' ')),
          projectIds: [release.projectId].filter(Boolean), contributorIds: unique(releaseCredits.map((credit) => credit.contributorId)), platforms: unique(releaseLinks.map((link) => link.platform)),
          versions: releaseRecordings, links: releaseLinks,
        };
      });

      const projectItems: SearchItem[] = data.projects.map((project) => {
        const projectRecordings = data.recordings.filter((recording) => recording.projectId === project.id);
        const projectReleases = data.releases.filter((release) => release.projectId === project.id);
        const projectCredits = [...projectRecordings.flatMap((recording) => creditsByRecording.get(recording.id) ?? []), ...projectReleases.flatMap((release) => creditsByRelease.get(release.id) ?? [])];
        const projectLinks = unique([...projectRecordings.map((recording) => recording.id), ...projectReleases.map((release) => release.id), project.id]).flatMap(linksFor);
        return {
          id: project.id, type: 'project', title: project.name, subtitle: project.relationship ?? project.type,
          meta: [project.type, project.period ?? 'PERIOD UNKNOWN', project.datePrecision].filter(Boolean), evidence: project.evidence,
          searchText: normalize([project.name, project.type, project.period, project.relationship, ...projectReleases.map((release) => release.title), ...projectRecordings.map((recording) => recording.title), ...creditTerms(projectCredits), ...projectLinks.map((link) => link.platform)].join(' ')),
          projectIds: [project.id], contributorIds: unique(projectCredits.map((credit) => credit.contributorId)), platforms: unique(projectLinks.map((link) => link.platform)), versions: projectRecordings, links: projectLinks,
        };
      });

      const eventItems: SearchItem[] = data.events.map((event) => {
        const eventParticipants = data.participants.filter((participant) => participant.eventId === event.id);
        return {
          id: event.id, type: 'event', title: event.name, subtitle: [event.venue, event.city, event.region].filter(Boolean).join(' / ') || projects.get(event.projectId)?.name || '',
          meta: [event.type, event.date ?? 'DATE UNKNOWN', event.datePrecision].filter(Boolean), evidence: event.evidence,
          searchText: normalize([event.name, event.type, event.date, event.datePrecision, event.venue, event.city, event.region, event.status, ...eventParticipants.flatMap((participant) => [participant.name, participant.role, participant.instrument])].join(' ')),
          projectIds: [event.projectId].filter(Boolean), contributorIds: unique(eventParticipants.map((participant) => participant.entityId).filter((id) => contributors.has(id))), platforms: [], versions: [], links: [],
        };
      });
      return [...songItems, ...releaseItems, ...projectItems, ...eventItems];
    };

    const render = () => {
      const query = normalize(search.value);
      const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.filter!, filter.value]));
      const hasInput = Boolean(query || Object.values(selected).some(Boolean));
      const tokens = query.split(' ').filter(Boolean);
      const matching = items.filter((item) =>
        tokens.every((token) => item.searchText.includes(token)) &&
        (!selected.type || item.type === selected.type) &&
        (!selected.project || item.projectIds.includes(selected.project)) &&
        (!selected.contributor || item.contributorIds.includes(selected.contributor)) &&
        (!selected.platform || item.platforms.includes(selected.platform))
      );
      const display = hasInput ? matching.slice(0, resultLimit) : items.filter((item) => item.type === 'song').slice(0, 16);
      resultCount.textContent = hasInput ? `${matching.length} MATCH${matching.length === 1 ? '' : 'ES'}` : `197 SONG FAMILIES / SHOWING 16`;
      emptyState.hidden = true;
      noResults.hidden = !hasInput || matching.length > 0;
      limitNote.hidden = !hasInput || matching.length <= resultLimit;
      if (!limitNote.hidden) limitNote.textContent = `SHOWING FIRST ${resultLimit} OF ${matching.length} MATCHES. NARROW THE SEARCH FOR A SHORTER SIGNAL.`;
      results.replaceChildren(...display.map(card));
    };

    const card = (item: SearchItem) => {
      const article = document.createElement('article');
      article.className = 'archive-card';
      const head = document.createElement('div'); head.className = 'archive-card-head';
      const type = document.createElement('span'); type.className = 'archive-type'; type.textContent = item.type.toUpperCase();
      const id = document.createElement('span'); id.className = 'archive-id'; id.textContent = item.id;
      const title = document.createElement('h2'); title.textContent = item.title;
      const subtitle = document.createElement('p'); subtitle.className = 'archive-subtitle'; subtitle.textContent = item.subtitle;
      const meta = document.createElement('ul'); meta.className = 'archive-meta';
      for (const value of item.meta.filter(Boolean)) { const li = document.createElement('li'); li.textContent = value; meta.append(li); }
      const evidence = document.createElement('p'); evidence.className = 'archive-evidence'; evidence.textContent = `EVIDENCE / ${item.evidence}`;
      head.append(type, id); article.append(head, title); if (item.subtitle) article.append(subtitle); article.append(meta, evidence);
      if (item.versions.length || item.links.length) {
        const details = document.createElement('details');
        const summary = document.createElement('summary'); summary.textContent = item.type === 'song' ? `VERSIONS + LINKS (${item.versions.length})` : `CATALOG DETAILS (${item.versions.length})`;
        details.append(summary);
        if (item.versions.length) {
          const list = document.createElement('ul'); list.className = 'archive-versions';
          for (const version of item.versions.slice(0, 30)) {
            const li = document.createElement('li');
            const name = document.createElement('span'); name.textContent = [version.title, version.version].filter(Boolean).join(' — ');
            const duration = document.createElement('span'); duration.textContent = version.duration ?? 'DURATION UNKNOWN';
            li.append(name, duration); list.append(li);
          }
          details.append(list);
        }
        if (item.links.length) {
          const linkRow = document.createElement('div'); linkRow.className = 'archive-links';
          for (const link of item.links) { const anchor = document.createElement('a'); anchor.href = link.url; anchor.target = '_blank'; anchor.rel = 'noopener noreferrer'; anchor.textContent = `${link.platform} ↗`; linkRow.append(anchor); }
          details.append(linkRow);
        }
        article.append(details);
      }
      return article;
    };

    fetch('/data/music-archive/v01/archive.json')
      .then((response) => { if (!response.ok) throw new Error('archive data unavailable'); return response.json(); })
      .then((data: ArchiveData) => {
        if (data.meta.publicKnownSongs !== 195) throw new Error('public counter mismatch');
        items = makeItems(data);
        const typeFilter = filters.find((filter) => filter.dataset.filter === 'type')!;
        for (const value of ['song', 'release', 'project', 'event']) typeFilter.append(option(value, value.toUpperCase()));
        const projectFilter = filters.find((filter) => filter.dataset.filter === 'project')!;
        for (const project of data.projects) projectFilter.append(option(project.id, project.name.toUpperCase()));
        const contributorFilter = filters.find((filter) => filter.dataset.filter === 'contributor')!;
        for (const contributor of data.contributors) contributorFilter.append(option(contributor.id, contributor.name.toUpperCase()));
        const platformFilter = filters.find((filter) => filter.dataset.filter === 'platform')!;
        for (const platform of [...new Set(data.links.map((link) => link.platform))].sort()) platformFilter.append(option(platform, platform.toUpperCase()));
        search.disabled = false; reset.disabled = false; filters.forEach((filter) => filter.disabled = false); loadingState.hidden = true;
        render();
      })
      .catch(() => { loadingState.hidden = true; errorState.hidden = false; resultCount.textContent = 'ARCHIVE OFFLINE'; });

    search.addEventListener('input', render);
    filters.forEach((filter) => filter.addEventListener('change', render));
    reset.addEventListener('click', () => { search.value = ''; filters.forEach((filter) => filter.value = ''); render(); search.focus(); });
  }
</script>

<style>
  .archive-machine { width: min(100% - 1rem, 980px); margin: clamp(1rem, 4vw, 2.5rem) auto; }
  .archive-header { display: grid; gap: 1.5rem; align-items: end; padding: clamp(1rem, 4vw, 2rem); border: 3px solid var(--jf-fg); background: #050505; }
  .archive-kicker { margin: 0; color: var(--jf-gray-mid); font-size: .7rem; letter-spacing: .16em; }
  .archive-header h1 { margin: .2rem 0 .75rem; font-size: clamp(2.2rem, 11vw, 5.5rem); line-height: .9; }
  .archive-intro { max-width: 62ch; margin: 0; color: var(--jf-gray-strong); }
  .archive-counter { display: grid; justify-items: start; border-left: 3px solid var(--jf-fg); padding-left: 1rem; }
  .archive-counter strong { font-size: clamp(2.8rem, 12vw, 5rem); line-height: .9; font-variant-numeric: tabular-nums; }
  .archive-counter span { color: var(--jf-link); font-weight: 700; letter-spacing: .14em; }
  .archive-controls { margin-top: 1rem; padding: 1rem; border: 2px solid var(--jf-fg); }
  .archive-search-label, .archive-filter-grid label span { display: block; margin-bottom: .35rem; color: var(--jf-gray-strong); font-size: .7rem; letter-spacing: .12em; }
  input, select, button { border-radius: 0; font: inherit; }
  [data-archive-search] { width: 100%; min-height: 52px; padding: .75rem; border: 2px solid var(--jf-fg); background: #000; color: #fff; font-size: 1rem; }
  [data-archive-search]::placeholder { color: var(--jf-gray-mid); }
  .archive-filter-grid { display: grid; gap: .75rem; margin-top: .9rem; }
  .archive-filter-grid select { width: 100%; min-height: 44px; padding: .55rem; border: 1px solid var(--jf-gray-strong); background: #080808; color: #fff; }
  .archive-control-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-top: 1rem; }
  .archive-result-count { margin: 0; color: var(--jf-link); font-size: .78rem; font-weight: 700; letter-spacing: .1em; }
  .archive-reset { min-height: 44px; padding: .55rem .8rem; border: 1px solid var(--jf-gray-strong); background: #000; color: #fff; cursor: pointer; }
  .archive-reset:hover { background: #fff; color: #000; }
  .archive-state, .archive-noscript, .archive-limit-note { margin: 1rem 0; padding: 1rem; border: 1px dashed var(--jf-gray-mid); color: var(--jf-gray-strong); }
  .archive-state--error { border-color: #ff8b8b; color: #ffb4b4; }
  .archive-pulse { display: inline-block; width: .65rem; height: .65rem; margin-right: .5rem; background: var(--jf-link); animation: archive-pulse 1s steps(2, end) infinite; }
  .archive-results { display: grid; gap: 1rem; margin-top: 1rem; }
  .archive-card { min-width: 0; padding: 1rem; border: 1px solid var(--jf-gray-soft); background: #030303; }
  .archive-card:hover { border-color: var(--jf-gray-strong); }
  .archive-card-head { display: flex; justify-content: space-between; gap: 1rem; color: var(--jf-gray-mid); font-size: .68rem; letter-spacing: .1em; }
  .archive-type { color: var(--jf-link); font-weight: 700; }
  .archive-id { text-align: right; }
  .archive-card h2 { margin: .55rem 0 .2rem; font-size: clamp(1.1rem, 5vw, 1.55rem); text-transform: none; }
  .archive-subtitle { margin: 0; color: var(--jf-gray-strong); }
  .archive-meta { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin: .8rem 0; padding: 0; list-style: none; color: var(--jf-gray-mid); font-size: .72rem; }
  .archive-meta li::before { content: '[ '; } .archive-meta li::after { content: ' ]'; }
  .archive-evidence { margin: .75rem 0; color: var(--jf-gray-mid); font-size: .68rem; }
  details { border-top: 1px dashed var(--jf-gray-soft); padding-top: .65rem; }
  summary { min-height: 44px; padding: .65rem 0; color: var(--jf-gray-strong); cursor: pointer; font-size: .72rem; letter-spacing: .08em; }
  .archive-versions { margin: .25rem 0 .8rem; padding: 0; list-style: none; }
  .archive-versions li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; padding: .4rem 0; border-top: 1px solid #222; color: var(--jf-gray-strong); font-size: .76rem; }
  .archive-links { display: flex; flex-wrap: wrap; gap: .65rem 1rem; }
  .archive-links a { font-size: .72rem; font-weight: 700; letter-spacing: .08em; }
  [hidden] { display: none !important; }
  @media (min-width: 620px) {
    .archive-header { grid-template-columns: minmax(0, 1fr) auto; }
    .archive-filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .archive-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) { .archive-filter-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 360px) { .archive-machine { width: calc(100% - 12px); } .archive-header, .archive-controls, .archive-card { padding: .75rem; } }
  @media (prefers-reduced-motion: reduce) { .archive-pulse { animation: none; } }
  @keyframes archive-pulse { 50% { opacity: .25; } }
</style>
