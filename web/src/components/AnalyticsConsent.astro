<section
  class="analytics-inline"
  data-analytics-panel
  aria-labelledby="analytics-title"
  aria-describedby="analytics-description"
  hidden
>
  <div class="analytics-inline__header">
    <span class="cookie-indicator" aria-hidden="true"><i></i><i></i><i></i></span>
    <h2 id="analytics-title" tabindex="-1">COOKIE MACHINE?</h2>
  </div>

  <p id="analytics-description">
    Optional analytics cookies help me see what people actually use, improve the website, and decide what strange thing to build next.
    Google Analytics only loads if you allow it. No advertising personalization.
  </p>
  <p class="analytics-inline__privacy"><a href="/privacy/">PRIVACY DETAILS</a></p>

  <div class="analytics-inline__actions">
    <button type="button" data-analytics-allow>ALLOW ANALYTICS</button>
    <button type="button" data-analytics-decline>NO THANKS</button>
  </div>
  <div class="analytics-inline__status" aria-live="polite" data-analytics-status>ANALYTICS: OFF</div>
</section>

<script>
  const measurementId = 'G-152ZY7TDDP';
  const consentKey = 'junkfeathers_analytics_consent_v1';
  const scriptSelector = 'script[data-jf-google-analytics]';
  const productionHosts = new Set(['junkfeathers.com', 'www.junkfeathers.com']);
  const isProductionHost = import.meta.env.PROD && productionHosts.has(window.location.hostname);
  const sentOnce = new Set<string>();

  type ConsentChoice = 'granted' | 'denied' | null;
  type GtagCommand = [string, ...unknown[]];
  type AnalyticsWindow = Window & {
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
    [key: `ga-disable-${string}`]: boolean | undefined;
  };

  const analyticsWindow = window as unknown as AnalyticsWindow;
  const panel = document.querySelector<HTMLElement>('[data-analytics-panel]');
  const settings = document.querySelector<HTMLButtonElement>('[data-analytics-settings]');
  const heading = document.querySelector<HTMLElement>('#analytics-title');
  const allow = document.querySelector<HTMLButtonElement>('[data-analytics-allow]');
  const decline = document.querySelector<HTMLButtonElement>('[data-analytics-decline]');
  const status = document.querySelector<HTMLElement>('[data-analytics-status]');

  if (panel && settings && heading && allow && decline && status) {
    const readChoice = (): ConsentChoice => {
      try {
        const value = window.localStorage.getItem(consentKey);
        return value === 'granted' || value === 'denied' ? value : null;
      } catch {
        return null;
      }
    };

    const writeChoice = (choice: Exclude<ConsentChoice, null>) => {
      try {
        window.localStorage.setItem(consentKey, choice);
      } catch {
        // Consent still applies for this page when storage is unavailable.
      }
    };

    const updateInterface = (choice: ConsentChoice) => {
      status.textContent = choice === 'granted'
        ? 'ANALYTICS: ALLOWED'
        : 'ANALYTICS: OFF';
      allow.setAttribute('aria-pressed', String(choice === 'granted'));
      decline.setAttribute('aria-pressed', String(choice === 'denied'));
    };

    const showPanel = (moveFocus = false) => {
      panel.hidden = false;
      settings.setAttribute('aria-expanded', 'true');
      if (moveFocus) {
        window.requestAnimationFrame(() => {
          panel.scrollIntoView({ block: 'nearest' });
          heading.focus({ preventScroll: true });
        });
      }
    };

    const hidePanel = (returnFocus = false) => {
      panel.hidden = true;
      settings.setAttribute('aria-expanded', 'false');
      if (returnFocus) settings.focus();
    };

    function gtag(..._args: GtagCommand) {
      analyticsWindow.dataLayer = analyticsWindow.dataLayer ?? [];
      analyticsWindow.dataLayer.push(arguments);
    }

    const configureConsent = (analyticsStorage: 'granted' | 'denied') => {
      gtag('consent', 'update', {
        analytics_storage: analyticsStorage,
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
    };

    const loadAnalytics = () => {
      if (!isProductionHost || document.querySelector(scriptSelector)) return;

      analyticsWindow[`ga-disable-${measurementId}`] = false;
      analyticsWindow.dataLayer = analyticsWindow.dataLayer ?? [];
      analyticsWindow.gtag = (...args: unknown[]) => gtag(...(args as GtagCommand));
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      configureConsent('granted');
      gtag('set', {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
      gtag('js', new Date());
      gtag('config', measurementId, {
        send_page_view: false,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
      gtag('event', 'page_view', { page_path: window.location.pathname });

      const googleScript = document.createElement('script');
      googleScript.async = true;
      googleScript.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      googleScript.dataset.jfGoogleAnalytics = 'true';
      document.head.append(googleScript);
    };

    const deleteAnalyticsCookies = () => {
      const cookieNames = document.cookie
        .split(';')
        .map((cookie) => cookie.split('=')[0]?.trim())
        .filter((name): name is string => Boolean(name && (name === '_ga' || name.startsWith('_ga_'))));
      const domains = new Set([window.location.hostname, 'junkfeathers.com', '.junkfeathers.com']);

      cookieNames.forEach((name) => {
        document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
        domains.forEach((domain) => {
          document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}; SameSite=Lax`;
        });
      });
    };

    const disableAnalytics = () => {
      if (analyticsWindow.gtag || analyticsWindow.dataLayer) configureConsent('denied');
      analyticsWindow[`ga-disable-${measurementId}`] = true;
      document.querySelector(scriptSelector)?.remove();
      deleteAnalyticsCookies();
    };

    const sendEvent = (eventName: string) => {
      if (readChoice() !== 'granted' || !isProductionHost) return;

      const eventParameters: Record<string, Record<string, string>> = {
        communication_open: { source_module: 'communication_machine' },
        support_lab_click: { source_module: 'communication_machine', destination_type: 'kofi' },
        orpheus_get_click: { project_name: 'orpheus_deck', destination_type: 'google_play' },
      };
      const parameters = eventParameters[eventName];
      if (!parameters) return;
      if (eventName === 'communication_open' && sentOnce.has(eventName)) return;

      sentOnce.add(eventName);
      gtag('event', eventName, parameters);
    };

    settings.setAttribute('aria-controls', 'analytics-consent-panel');
    settings.setAttribute('aria-expanded', 'false');
    panel.id = 'analytics-consent-panel';

    const initialChoice = readChoice();
    updateInterface(initialChoice);
    if (initialChoice === 'granted') loadAnalytics();
    if (initialChoice === null) showPanel();

    settings.addEventListener('click', () => {
      if (panel.hidden) showPanel(true);
      else hidePanel(true);
    });
    allow.addEventListener('click', () => {
      writeChoice('granted');
      updateInterface('granted');
      loadAnalytics();
      hidePanel(true);
    });
    decline.addEventListener('click', () => {
      writeChoice('denied');
      updateInterface('denied');
      disableAnalytics();
      hidePanel(true);
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-analytics-event]')
        : null;
      if (target?.dataset.analyticsEvent) sendEvent(target.dataset.analyticsEvent);
    });

    document.addEventListener('jf:analytics-intent', (event) => {
      if (event instanceof CustomEvent && typeof event.detail?.eventName === 'string') {
        sendEvent(event.detail.eventName);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) hidePanel(true);
    });
  }
</script>

<style>
  .analytics-inline {
    position: relative;
    width: min(100% - 1rem, 780px);
    margin: 0 auto;
    padding: 0.9rem;
    border: 1px solid var(--jf-gray-mid);
    background:
      repeating-linear-gradient(90deg, transparent 0 23px, rgba(255, 255, 255, 0.018) 23px 24px),
      #020202;
    color: var(--jf-fg);
    box-shadow: 4px 4px 0 #171717;
    font-family: monospace;
    text-align: left;
  }

  .analytics-inline[hidden] { display: none; }

  .analytics-inline::before,
  .analytics-inline::after {
    position: absolute;
    top: 7px;
    width: 4px;
    height: 4px;
    border: 1px solid var(--jf-gray-mid);
    border-radius: 50%;
    background: #000;
    content: '';
  }

  .analytics-inline::before { left: 7px; }
  .analytics-inline::after { right: 7px; }

  .analytics-inline__header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #2c2c2c;
  }

  .cookie-indicator {
    width: 30px;
    height: 30px;
    display: grid;
    grid-template-columns: repeat(2, 5px);
    place-content: center;
    gap: 4px;
    flex: 0 0 auto;
    border: 1px solid var(--jf-gray-mid);
    border-radius: 50%;
  }

  .cookie-indicator i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--jf-gray-mid);
  }

  .cookie-indicator i:last-child { grid-column: 1 / -1; justify-self: center; }

  .analytics-inline h2 {
    margin: 0;
    color: var(--jf-fg);
    font-size: clamp(1rem, 5vw, 1.25rem);
    letter-spacing: 0.06em;
  }

  .analytics-inline p {
    max-width: 72ch;
    margin: 0.7rem 0 0;
    color: #c8c8c8;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .analytics-inline__privacy a {
    color: var(--jf-gray-mid);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  .analytics-inline__actions {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .analytics-inline__actions button {
    min-height: 46px;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--jf-fg);
    border-radius: 0;
    background: #050505;
    color: var(--jf-fg);
    cursor: pointer;
    font: 700 0.72rem/1.15 monospace;
    letter-spacing: 0.05em;
  }

  .analytics-inline__actions button:hover,
  .analytics-inline__actions button:focus,
  .analytics-inline__actions button[aria-pressed='true'] {
    background: var(--jf-fg);
    color: #000;
  }

  .analytics-inline__status {
    margin-top: 0.65rem;
    color: var(--jf-gray-mid);
    font-size: 0.59rem;
    letter-spacing: 0.1em;
    text-align: right;
  }

  .analytics-inline button:focus-visible,
  .analytics-inline a:focus-visible,
  .analytics-inline h2:focus-visible {
    outline: 2px solid var(--jf-fg) !important;
    outline-offset: 3px;
  }

  @media (min-width: 540px) {
    .analytics-inline { padding: 1rem 1.15rem; }
    .analytics-inline__actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 600px) {
    .analytics-inline { width: min(100% - 2rem, 780px); }
  }

  @media (max-width: 350px) {
    .analytics-inline {
      width: calc(100% - 0.75rem);
      padding: 0.75rem;
      box-shadow: 3px 3px 0 #171717;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .analytics-inline * { transition: none !important; }
  }
</style>
