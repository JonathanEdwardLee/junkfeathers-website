---
interface Props {
  siteKey: string;
  betaMode?: boolean;
}

const { siteKey, betaMode = false } = Astro.props;
const contactConfigured = siteKey.length > 0;
---

<section
  id="contact-channel-panel"
  class="contact-form-panel"
  data-contact-form-root
  data-sitekey={siteKey}
  data-beta-mode={String(betaMode)}
  hidden
>
  <header class="contact-form-header">
    <span>CONTACT // SECURE TRANSMISSION</span>
    <h2>CONTACT</h2>
    <p>Send a direct message. This does not subscribe you to updates.</p>
    {betaMode && <small>TURNSTILE TEST KEY // LOCAL BETA</small>}
  </header>

  <form data-contact-form novalidate>
    <div class="contact-field">
      <label for="contact-name">NAME <small>OPTIONAL</small></label>
      <input id="contact-name" name="name" type="text" maxlength="100" autocomplete="name" />
    </div>

    <div class="contact-field">
      <label for="contact-email">EMAIL <small>REQUIRED</small></label>
      <input
        id="contact-email"
        name="email"
        type="email"
        maxlength="254"
        autocomplete="email"
        inputmode="email"
        required
      />
    </div>

    <div class="contact-field contact-field--message">
      <label for="contact-message">MESSAGE <small>REQUIRED // 10–5000</small></label>
      <textarea id="contact-message" name="message" minlength="10" maxlength="5000" rows="7" required></textarea>
      <output for="contact-message" data-message-count>0 / 5000</output>
    </div>

    <div class="contact-trap" aria-hidden="true">
      <label for="contact-company">COMPANY</label>
      <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <input name="started_at" type="hidden" data-contact-started-at />

    <div class="turnstile-frame" data-turnstile-frame>
      <div data-turnstile-widget></div>
      <p data-turnstile-note>
        {contactConfigured ? 'HUMAN VERIFICATION REQUIRED' : 'CHANNEL CONFIGURATION REQUIRED'}
      </p>
    </div>

    <div class="contact-submit-row">
      <button type="submit" data-contact-submit disabled={!contactConfigured}>SEND</button>
      <output class="contact-status" role="status" aria-live="polite" data-contact-status>
        {contactConfigured ? 'CHANNEL READY' : 'CHANNEL UNAVAILABLE'}
      </output>
    </div>
  </form>
</section>

<script>
  type ContactResponseCode =
    | 'sent'
    | 'validation'
    | 'verification'
    | 'rate_limited'
    | 'unavailable'
    | 'delivery_failed';

  type ContactResponse = {
    ok: boolean;
    code: ContactResponseCode;
  };

  type TurnstileApi = {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    reset: (widgetId: string) => void;
  };

  type ContactWindow = Window & {
    turnstile?: TurnstileApi;
  };

  const contactWindow = window as ContactWindow;
  const contactRoots = document.querySelectorAll<HTMLElement>('[data-contact-form-root]');
  let turnstileLoader: Promise<TurnstileApi> | null = null;

  const loadTurnstile = (): Promise<TurnstileApi> => {
    if (contactWindow.turnstile) return Promise.resolve(contactWindow.turnstile);
    if (turnstileLoader) return turnstileLoader;

    turnstileLoader = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.dataset.jfTurnstile = 'true';
      script.addEventListener('load', () => {
        if (contactWindow.turnstile) resolve(contactWindow.turnstile);
        else reject(new Error('Turnstile unavailable'));
      }, { once: true });
      script.addEventListener('error', () => reject(new Error('Turnstile unavailable')), { once: true });
      document.head.append(script);
    });

    return turnstileLoader;
  };

  contactRoots.forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-contact-form]');
    const name = root.querySelector<HTMLInputElement>('[name="name"]');
    const email = root.querySelector<HTMLInputElement>('[name="email"]');
    const message = root.querySelector<HTMLTextAreaElement>('[name="message"]');
    const company = root.querySelector<HTMLInputElement>('[name="company"]');
    const startedAt = root.querySelector<HTMLInputElement>('[data-contact-started-at]');
    const messageCount = root.querySelector<HTMLOutputElement>('[data-message-count]');
    const widget = root.querySelector<HTMLElement>('[data-turnstile-widget]');
    const widgetNote = root.querySelector<HTMLElement>('[data-turnstile-note]');
    const submit = root.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const status = root.querySelector<HTMLOutputElement>('[data-contact-status]');
    const siteKey = root.dataset.sitekey?.trim() ?? '';
    const betaMode = root.dataset.betaMode === 'true';

    if (!form || !name || !email || !message || !company || !startedAt || !messageCount || !widget || !widgetNote || !submit || !status) return;

    let turnstileToken = '';
    let widgetId: string | null = null;
    let inFlight = false;

    const setStatus = (text: string) => {
      status.textContent = text;
    };

    const setBusy = (busy: boolean) => {
      inFlight = busy;
      submit.disabled = busy || !siteKey;
      form.setAttribute('aria-busy', String(busy));
    };

    const resetVerification = () => {
      turnstileToken = '';
      if (widgetId && contactWindow.turnstile) contactWindow.turnstile.reset(widgetId);
    };

    const renderVerification = async () => {
      if (!siteKey || widgetId) return;

      try {
        const turnstile = await loadTurnstile();
        widgetId = turnstile.render(widget, {
          sitekey: siteKey,
          action: 'contact',
          theme: 'dark',
          size: window.matchMedia('(max-width: 420px)').matches ? 'compact' : 'flexible',
          callback: (token: string) => {
            turnstileToken = token;
            widgetNote.textContent = 'VERIFICATION READY';
            if (!inFlight) setStatus('CHANNEL READY');
          },
          'expired-callback': () => {
            turnstileToken = '';
            widgetNote.textContent = 'VERIFICATION EXPIRED';
            setStatus('VERIFY AND TRY AGAIN');
          },
          'error-callback': () => {
            turnstileToken = '';
            widgetNote.textContent = 'VERIFICATION UNAVAILABLE';
            setStatus('CHANNEL UNAVAILABLE');
          },
        });
      } catch {
        widgetNote.textContent = 'VERIFICATION UNAVAILABLE';
        setStatus('CHANNEL UNAVAILABLE');
        submit.disabled = true;
      }
    };

    const updateMessageCount = () => {
      messageCount.value = `${Array.from(message.value).length} / 5000`;
    };

    const markValidity = (field: HTMLInputElement | HTMLTextAreaElement, valid: boolean) => {
      field.setAttribute('aria-invalid', String(!valid));
    };

    const validate = () => {
      const nameLength = Array.from(name.value.trim()).length;
      const emailValue = email.value.trim();
      const messageLength = Array.from(message.value.trim()).length;
      const nameValid = nameLength <= 100;
      const emailValid = emailValue.length > 0 && emailValue.length <= 254 && email.validity.valid;
      const messageValid = messageLength >= 10 && messageLength <= 5000;

      markValidity(name, nameValid);
      markValidity(email, emailValid);
      markValidity(message, messageValid);

      return nameValid && emailValid && messageValid && company.value === '';
    };

    const simulateBetaResponse = async (): Promise<ContactResponse> => {
      await new Promise((resolve) => window.setTimeout(resolve, 650));
      const requested = new URLSearchParams(window.location.search).get('contact-test');
      const code: ContactResponseCode = requested === 'verification'
        || requested === 'rate_limited'
        || requested === 'unavailable'
        || requested === 'delivery_failed'
        ? requested
        : 'sent';
      return { ok: code === 'sent', code };
    };

    const sendRequest = async (): Promise<ContactResponse> => {
      if (betaMode) return simulateBetaResponse();

      const response = await fetch('/api/contact.php', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'JunkfeathersContact',
        },
        body: JSON.stringify({
          name: name.value.trim(),
          email: email.value.trim(),
          message: message.value.trim(),
          company: company.value,
          started_at: Number(startedAt.value),
          turnstile_token: turnstileToken,
        }),
      });

      const payload = await response.json().catch(() => null) as ContactResponse | null;
      if (!payload || typeof payload.ok !== 'boolean' || typeof payload.code !== 'string') {
        throw new Error('Invalid response');
      }

      return payload;
    };

    const showResponse = (response: ContactResponse) => {
      if (response.ok && response.code === 'sent') {
        message.value = '';
        updateMessageCount();
        startedAt.value = String(Date.now());
        resetVerification();
        setStatus('MESSAGE SENT');
        document.dispatchEvent(new CustomEvent('jf:analytics-intent', {
          detail: { eventName: 'contact_message_sent' },
        }));
        return;
      }

      if (response.code === 'validation') setStatus('CHECK THE FIELDS');
      else if (response.code === 'verification') {
        setStatus('VERIFY AND TRY AGAIN');
        resetVerification();
      } else if (response.code === 'delivery_failed') setStatus('SIGNAL FAILED — TRY AGAIN');
      else setStatus('CHANNEL UNAVAILABLE');
    };

    startedAt.value = String(Date.now());
    updateMessageCount();
    message.addEventListener('input', updateMessageCount);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (inFlight) return;

      if (!validate()) {
        setStatus('CHECK THE FIELDS');
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      if (!turnstileToken) {
        setStatus('VERIFY AND TRY AGAIN');
        widget.scrollIntoView({ block: 'nearest' });
        return;
      }

      setBusy(true);
      setStatus('SENDING…');

      try {
        showResponse(await sendRequest());
      } catch {
        setStatus('SIGNAL FAILED — TRY AGAIN');
      } finally {
        setBusy(false);
      }
    });

    document.addEventListener('jf:contact-open', () => {
      if (!root.hidden) void renderVerification();
    });
  });
</script>

<style>
  .contact-form-panel {
    margin-top: 0.75rem;
    padding: clamp(0.8rem, 3vw, 1rem);
    border: 1px solid var(--comm-mid, #858585);
    background:
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(255, 255, 255, 0.015) 23px 24px),
      #030303;
    color: #fff;
    font-family: monospace;
  }

  .contact-form-panel[hidden] { display: none; }

  .contact-form-header {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #292929;
  }

  .contact-form-header > span,
  .contact-form-header > small {
    display: block;
    color: #858585;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }

  .contact-form-header h2 {
    margin: 0.2rem 0;
    font-size: clamp(1rem, 5vw, 1.3rem);
    letter-spacing: 0.08em;
  }

  .contact-form-header p {
    margin: 0;
    color: #bfbfbf;
    font-size: 0.72rem;
  }

  .contact-form-header > small { margin-top: 0.45rem; }

  form {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .contact-field {
    display: grid;
    gap: 0.35rem;
  }

  .contact-field label {
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .contact-field label small {
    color: #858585;
    font-size: 0.56rem;
    font-weight: 400;
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid #4a4a4a;
    border-radius: 0;
    background: #000;
    color: #fff;
    font: 0.82rem/1.5 monospace;
  }

  .contact-field input { min-height: 46px; padding: 0.55rem 0.65rem; }
  .contact-field textarea { min-height: 150px; padding: 0.65rem; resize: vertical; }

  .contact-field [aria-invalid='true'] { border-color: #fff; box-shadow: inset 0 0 0 1px #fff; }

  .contact-field output {
    color: #858585;
    font-size: 0.58rem;
    text-align: right;
  }

  .contact-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .turnstile-frame {
    min-width: 0;
    min-height: 78px;
    display: grid;
    align-content: center;
    gap: 0.35rem;
    overflow: hidden;
    padding: 0.55rem;
    border: 1px solid #292929;
    background: #010101;
  }

  [data-turnstile-widget] { min-width: 0; }

  .turnstile-frame p {
    margin: 0;
    color: #858585;
    font-size: 0.56rem;
    letter-spacing: 0.09em;
  }

  .contact-submit-row {
    display: grid;
    gap: 0.55rem;
  }

  .contact-submit-row button {
    min-height: 48px;
    border: 2px solid #fff;
    border-radius: 0;
    background: #050505;
    color: #fff;
    cursor: pointer;
    font: 700 0.76rem/1 monospace;
    letter-spacing: 0.1em;
  }

  .contact-submit-row button:hover,
  .contact-submit-row button:focus {
    background: #fff;
    color: #000;
  }

  .contact-submit-row button:disabled {
    border-color: #2a2a2a;
    background: #030303;
    color: #4a4a4a;
    cursor: not-allowed;
  }

  .contact-status {
    min-height: 1.5em;
    color: #bfbfbf;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  @media (min-width: 620px) {
    form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contact-field--message,
    .turnstile-frame,
    .contact-submit-row { grid-column: 1 / -1; }
    .contact-submit-row { grid-template-columns: minmax(150px, 0.35fr) 1fr; align-items: center; }
  }

  @media (max-width: 350px) {
    .contact-form-panel { padding: 0.65rem; }
    .contact-field input,
    .contact-field textarea { font-size: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form-panel * { animation: none !important; transition: none !important; }
  }
</style>
