---
interface Track {
  title: string;
  duration: string;
  bandcampUrl: string;
}

interface Props {
  anchorId: string;
  youtubeId: string;
  youtubeUrl: string;
  bandcampUrl: string;
  spotifyUrl: string;
  releaseTitle: string;
  tracks: Track[];
}

const {
  anchorId,
  youtubeId,
  youtubeUrl,
  bandcampUrl,
  spotifyUrl,
  releaseTitle,
  tracks,
} = Astro.props;

const screenId = `${anchorId}-screen`;
const statusId = `${anchorId}-status`;
---

<section class="video-transmission" id={anchorId} data-video-transmission data-youtube-id={youtubeId} data-release-title={releaseTitle}>
  <div class="transmission-heading" aria-hidden="true">
    <span>SOLO // TRANSMISSION 001</span>
    <span>NTSC-M</span>
  </div>

  <div class="crt-machine">
    <div class="crt-bezel">
      <div class="crt-screen" id={screenId} data-crt-screen>
        <div class="crt-dormant" data-dormant-content>
          <div class="crt-noise" aria-hidden="true"></div>
          <div class="crt-scan" aria-hidden="true"></div>
          <div class="crt-reticle" aria-hidden="true">
            <span></span>
          </div>
          <p class="crt-standby">NO SIGNAL</p>
        </div>
      </div>
    </div>

    <div class="crt-controls">
      <div class="power-cluster">
        <button
          class="power-button"
          type="button"
          aria-controls={screenId}
          aria-describedby={statusId}
          aria-pressed="false"
          data-power-button
        >
          <span class="power-symbol" aria-hidden="true">◉</span>
          <span data-power-label>POWER</span>
        </button>
        <span class="power-light" aria-hidden="true"></span>
      </div>

      <p class="machine-status" id={statusId} role="status" aria-live="polite" data-machine-status>
        STANDBY / SIGNAL COLD
      </p>

      <div class="vent-bank" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="release-panel">
      <div class="release-title-block">
        <p class="release-index">JF-MUSIC / 001</p>
        <h2>{releaseTitle}</h2>
      </div>

      <ol class="track-list" aria-label="Track sequence">
        {tracks.map((track, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <a href={track.bandcampUrl} target="_blank" rel="noopener noreferrer">
              <span class="track-title">{track.title}</span>
              <span class="track-duration">{track.duration}</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="release-links" aria-label="Listen on external services">
        <a href={bandcampUrl} target="_blank" rel="noopener noreferrer">BANDCAMP ↗</a>
        <a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YOUTUBE ↗</a>
        <a href={spotifyUrl} target="_blank" rel="noopener noreferrer">SPOTIFY ↗</a>
      </div>
    </div>
  </div>
</section>

<script>
  const transmissions = document.querySelectorAll<HTMLElement>('[data-video-transmission]');

  transmissions.forEach((transmission) => {
    const screen = transmission.querySelector<HTMLElement>('[data-crt-screen]');
    const button = transmission.querySelector<HTMLButtonElement>('[data-power-button]');
    const label = transmission.querySelector<HTMLElement>('[data-power-label]');
    const status = transmission.querySelector<HTMLElement>('[data-machine-status]');
    const youtubeId = transmission.dataset.youtubeId;
    const releaseTitle = transmission.dataset.releaseTitle;

    if (!screen || !button || !label || !status || !youtubeId || !releaseTitle) return;

    const dormantMarkup = screen.innerHTML;
    let wakeTimer: number | undefined;

    const powerOff = () => {
      if (wakeTimer !== undefined) window.clearTimeout(wakeTimer);
      wakeTimer = undefined;
      screen.innerHTML = dormantMarkup;
      screen.classList.remove('crt-screen--booting', 'crt-screen--online');
      transmission.classList.remove('video-transmission--online');
      button.setAttribute('aria-pressed', 'false');
      label.textContent = 'POWER';
      status.textContent = 'STANDBY / SIGNAL COLD';
    };

    const powerOn = () => {
      button.setAttribute('aria-pressed', 'true');
      label.textContent = 'POWER OFF';
      status.textContent = 'WAKING SIGNAL';
      screen.classList.add('crt-screen--booting');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      wakeTimer = window.setTimeout(() => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?playsinline=1&rel=0`;
        iframe.title = `${releaseTitle} video player`;
        iframe.loading = 'lazy';
        iframe.allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;

        screen.replaceChildren(iframe);
        screen.classList.remove('crt-screen--booting');
        screen.classList.add('crt-screen--online');
        transmission.classList.add('video-transmission--online');
        status.textContent = 'SIGNAL ONLINE / PLAYBACK READY';
        wakeTimer = undefined;
      }, reducedMotion ? 0 : 520);
    };

    button.addEventListener('click', () => {
      const isOn = button.getAttribute('aria-pressed') === 'true';
      if (isOn) powerOff();
      else powerOn();
    });
  });
</script>

<style>
  .video-transmission {
    scroll-margin-top: 1rem;
  }

  .transmission-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.15rem 0.45rem;
    color: var(--jf-gray-mid);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .crt-machine {
    border: 3px solid var(--jf-fg);
    background: #080808;
    box-shadow: 7px 7px 0 #222;
  }

  .crt-bezel {
    padding: clamp(0.65rem, 3vw, 1.15rem);
    border-bottom: 2px solid var(--jf-fg);
    background:
      linear-gradient(135deg, transparent 9px, #0d0d0d 0) top left,
      linear-gradient(225deg, transparent 9px, #0d0d0d 0) top right;
    background-size: 51% 100%;
    background-repeat: no-repeat;
  }

  .crt-screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 2px solid var(--jf-gray-mid);
    border-radius: 4% / 7%;
    background: #020202;
    box-shadow: inset 0 0 32px #000;
    isolation: isolate;
  }

  .crt-screen::after {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    box-shadow: inset 0 0 22px 7px rgba(0, 0, 0, 0.78);
    content: '';
    pointer-events: none;
  }

  .crt-dormant,
  .crt-noise,
  .crt-scan,
  .crt-reticle {
    position: absolute;
    inset: 0;
  }

  .crt-dormant {
    background:
      radial-gradient(ellipse at center, #181818 0, #080808 52%, #010101 100%);
  }

  .crt-noise {
    opacity: 0.34;
    background-image:
      repeating-radial-gradient(circle at 18% 31%, #aaa 0 0.4px, transparent 0.8px 3px),
      repeating-radial-gradient(circle at 77% 66%, #777 0 0.5px, transparent 1px 4px);
    background-size: 7px 9px, 11px 8px;
    animation: signal-noise 0.22s steps(2, end) infinite;
  }

  .crt-scan {
    z-index: 2;
    opacity: 0.45;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255, 255, 255, 0.08) 4px,
      transparent 5px
    );
  }

  .crt-scan::after {
    position: absolute;
    inset-inline: 0;
    height: 12%;
    background: linear-gradient(transparent, rgba(255, 255, 255, 0.08), transparent);
    content: '';
    animation: scan-sweep 6s linear infinite;
  }

  .crt-reticle {
    z-index: 3;
    display: grid;
    place-items: center;
    opacity: 0.28;
  }

  .crt-reticle::before,
  .crt-reticle::after,
  .crt-reticle span::before,
  .crt-reticle span::after {
    position: absolute;
    background: var(--jf-gray-mid);
    content: '';
  }

  .crt-reticle::before {
    width: 1px;
    height: 22%;
  }

  .crt-reticle::after {
    width: 18%;
    height: 1px;
  }

  .crt-reticle span::before {
    inset: 9% auto auto 5%;
    width: 12%;
    height: 1px;
  }

  .crt-reticle span::after {
    inset: 9% 5% auto auto;
    width: 12%;
    height: 1px;
  }

  .crt-standby {
    position: absolute;
    z-index: 4;
    inset: auto 0 12%;
    margin: 0;
    color: var(--jf-gray-strong);
    font-size: clamp(0.65rem, 2.8vw, 0.82rem);
    letter-spacing: 0.24em;
    text-align: center;
  }

  .crt-screen--booting::before {
    position: absolute;
    z-index: 6;
    inset: 50% 5%;
    height: 2px;
    background: #fff;
    box-shadow: 0 0 16px #fff;
    content: '';
    animation: crt-wake 0.52s ease-out both;
  }

  .crt-screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .crt-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 72px;
    padding: 0.65rem;
  }

  .power-cluster {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .power-button {
    width: 106px;
    min-height: 44px;
    padding: 0.55rem 0.72rem;
    border: 2px solid var(--jf-fg);
    border-radius: 0;
    background: #000;
    color: var(--jf-fg);
    font: 700 0.72rem/1 monospace;
    letter-spacing: 0.07em;
    cursor: pointer;
  }

  .power-button:hover,
  .power-button[aria-pressed='true'] {
    background: var(--jf-fg);
    color: var(--jf-bg);
  }

  .power-symbol {
    margin-right: 0.3rem;
  }

  .power-light {
    width: 7px;
    height: 7px;
    border: 1px solid var(--jf-gray-mid);
    border-radius: 50%;
    background: #222;
  }

  .video-transmission--online .power-light {
    background: var(--jf-fg);
    box-shadow: 0 0 8px var(--jf-fg);
  }

  .machine-status {
    min-width: 0;
    margin: 0;
    color: var(--jf-gray-mid);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .vent-bank {
    display: flex;
    gap: 4px;
  }

  .vent-bank span {
    display: block;
    width: 3px;
    height: 27px;
    background: var(--jf-gray-soft);
  }

  .release-panel {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1rem, 4vw, 1.5rem);
    border-top: 2px solid var(--jf-fg);
    background: #030303;
  }

  .release-index {
    margin: 0 0 0.2rem;
    color: var(--jf-gray-mid);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .release-title-block h2 {
    margin: 0;
    font-size: clamp(1.25rem, 6vw, 2rem);
    letter-spacing: 0.06em;
  }

  .track-list {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--jf-gray-strong);
    font-size: 0.82rem;
  }

  .track-list li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    border-top: 1px solid #252525;
    padding-top: 0.3rem;
  }

  .track-list span {
    color: var(--jf-gray-soft);
  }

  .track-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    color: var(--jf-gray-strong);
    border-bottom: 0;
  }

  .track-list a:hover,
  .track-list a:focus {
    color: var(--jf-fg);
  }

  .track-list .track-title {
    color: inherit;
  }

  .track-list .track-duration {
    color: var(--jf-gray-mid);
    font-variant-numeric: tabular-nums;
  }

  .release-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.35rem;
  }

  .release-links a {
    color: var(--jf-fg);
    border-color: var(--jf-gray-mid);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media (min-width: 620px) {
    .crt-machine {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 138px;
    }

    .crt-bezel {
      border-right: 2px solid var(--jf-fg);
      border-bottom: 0;
    }

    .crt-controls {
      grid-template-columns: 1fr;
      align-content: space-between;
      justify-items: stretch;
      padding: 1rem 0.85rem;
    }

    .power-cluster {
      justify-content: space-between;
    }

    .machine-status {
      text-align: left;
    }

    .vent-bank {
      justify-content: flex-end;
    }

    .release-panel {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(240px, 0.85fr);
    }

    .release-links {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 390px) {
    .crt-controls {
      grid-template-columns: 1fr auto;
    }

    .machine-status {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crt-noise,
    .crt-scan::after,
    .crt-screen--booting::before {
      animation: none;
    }
  }

  @keyframes signal-noise {
    0% { transform: translate(0, 0); }
    33% { transform: translate(-1px, 1px); }
    66% { transform: translate(1px, -1px); }
    100% { transform: translate(0, 1px); }
  }

  @keyframes scan-sweep {
    from { transform: translateY(-100%); }
    to { transform: translateY(900%); }
  }

  @keyframes crt-wake {
    0% { opacity: 0; transform: scaleX(0.05); }
    35% { opacity: 1; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleY(85); }
  }
</style>
