---
interface VideoInfo {
  label: string;
  value: string;
  url?: string;
}

interface VideoLyric {
  authors: string;
  version: string;
  text: string;
  sampleTreatment: string | null;
}

interface VideoDestination {
  platform: string;
  url: string;
  kind: 'exact' | 'release-page' | 'smart-link';
  label: string;
}

interface VideoChannel {
  number: number;
  songId: string;
  songLinkId: string;
  playerChannelId: string;
  youtubeId: string;
  youtubeUrl: string;
  moreHref: string;
  title: string;
  info: VideoInfo[];
  lyrics: VideoLyric | null;
  destinations: VideoDestination[];
}

interface Props {
  anchorId: string;
  channels: VideoChannel[];
}

const { anchorId, channels } = Astro.props;
if (channels.length !== 6) throw new Error('Video channel machine requires exactly six channels.');

const initialChannel = channels[0];
const screenId = `${anchorId}-screen`;
const statusId = `${anchorId}-status`;
---

<section
  class="video-transmission"
  id={anchorId}
  data-video-transmission
  data-channel-config={JSON.stringify(channels)}
>
  <div class="transmission-heading" aria-hidden="true">
    <span>VIDEO // CHANNEL MACHINE</span>
    <span data-channel-readout>CH 01 / STANDBY</span>
  </div>

  <div class="crt-machine">
    <div class="crt-bezel">
      <div class="crt-screen" id={screenId} data-crt-screen>
        <div class="crt-dormant" data-dormant-content>
          <div class="crt-noise" aria-hidden="true"></div>
          <div class="crt-scan" aria-hidden="true"></div>
          <div class="crt-reticle" aria-hidden="true"><span></span></div>
          <p class="crt-standby">NO SIGNAL / CH 01</p>
        </div>
      </div>
    </div>

    <div class="crt-controls">
      <div class="channel-bank" aria-label="Video channels">
        {channels.map((channel, index) => (
          <button
            type="button"
            aria-label={`Channel ${String(channel.number).padStart(2, '0')}: ${channel.title}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-channel-button
            data-channel-index={index}
          >
            CH {String(channel.number).padStart(2, '0')}
          </button>
        ))}
      </div>

      <div class="power-cluster">
        <button
          class="power-button"
          type="button"
          aria-controls={screenId}
          aria-describedby={statusId}
          aria-pressed="false"
          data-power-button
        >
          <span class="power-symbol" aria-hidden="true">◉</span>
          <span data-power-label>POWER</span>
        </button>
        <span class="power-light" aria-hidden="true"></span>
      </div>

      <p class="machine-status" id={statusId} role="status" aria-live="polite" data-machine-status>
        CH 01 / SIGNAL COLD
      </p>

      <div class="vent-bank" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="release-panel">
      <div class="release-title-block">
        <p class="release-index" data-channel-index-label>
          CH 01 / {initialChannel.songId} / {initialChannel.playerChannelId}
        </p>
        <h2 data-channel-title>{initialChannel.title}</h2>
      </div>

      <div class="info-machine" data-info-machine>
        <div class="info-chassis" aria-hidden="true" data-info-art>
          <div class="tuner-drum" data-tuner-drum>
            {channels.map((channel) => (
              <span>{String(channel.number).padStart(2, '0')}</span>
            ))}
          </div>
          <div class="gear-train">
            <i></i><i></i><i></i>
          </div>
          <div class="meter">
            <b data-meter-needle></b>
          </div>
          <div class="lamp-row">
            <i></i><i></i><i></i><i></i>
          </div>
          <div class="shutter"></div>
          <p class="info-readout" data-art-readout>CH 01 / INFO</p>
        </div>

        <div class="info-console">
          <div class="channel-tab-row">
            <div class="channel-tabs" role="tablist" aria-label="Channel information surfaces" data-channel-tabs>
              {(['INFO', 'LYRICS', 'STREAMING'] as const).map((surface, index) => {
                const unavailable = surface === 'LYRICS'
                  ? !initialChannel.lyrics
                  : surface === 'STREAMING'
                    ? initialChannel.destinations.length === 0
                    : false;
                return (
                <button
                  type="button"
                  class="machine-tab"
                  role="tab"
                  id={`${anchorId}-tab-${surface.toLowerCase()}`}
                  aria-controls={`${anchorId}-surface`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                  data-channel-tab={surface}
                  disabled={unavailable}
                  aria-disabled={unavailable}
                >
                  {surface}
                </button>
                );
              })}
            </div>
            <a class="channel-more" href={initialChannel.moreHref} data-channel-more>
              MORE
            </a>
          </div>

          <div
            class="channel-surface"
            id={`${anchorId}-surface`}
            role="tabpanel"
            aria-labelledby={`${anchorId}-tab-info`}
            data-channel-surface
          >
            <dl class="channel-info" data-channel-info>
              {initialChannel.info.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>
                    {item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.value} <span aria-hidden="true">&#8599;</span></a> : item.value}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>

      <div class="release-links" aria-label="Video source">
        <a href={initialChannel.youtubeUrl} target="_blank" rel="noopener noreferrer" data-youtube-link>
          OPEN ON YOUTUBE ↗
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  interface ChannelInfo {
    label: string;
    value: string;
    url?: string;
  }

  interface ChannelLyric {
    authors: string;
    version: string;
    text: string;
    sampleTreatment: string | null;
  }

  interface ChannelDestination {
    platform: string;
    url: string;
    kind: 'exact' | 'release-page' | 'smart-link';
    label: string;
  }

  interface ChannelData {
    number: number;
    songId: string;
    songLinkId: string;
    playerChannelId: string;
    youtubeId: string;
    youtubeUrl: string;
    moreHref: string;
    title: string;
    info: ChannelInfo[];
    lyrics: ChannelLyric | null;
    destinations: ChannelDestination[];
  }

  type ChannelSurface = 'INFO' | 'LYRICS' | 'STREAMING';

  const transmissions = document.querySelectorAll<HTMLElement>('[data-video-transmission]');

  transmissions.forEach((transmission) => {
    const screen = transmission.querySelector<HTMLElement>('[data-crt-screen]');
    const powerButton = transmission.querySelector<HTMLButtonElement>('[data-power-button]');
    const powerLabel = transmission.querySelector<HTMLElement>('[data-power-label]');
    const status = transmission.querySelector<HTMLElement>('[data-machine-status]');
    const readout = transmission.querySelector<HTMLElement>('[data-channel-readout]');
    const indexLabel = transmission.querySelector<HTMLElement>('[data-channel-index-label]');
    const title = transmission.querySelector<HTMLElement>('[data-channel-title]');
    const surfacePanel = transmission.querySelector<HTMLElement>('[data-channel-surface]');
    const youtubeLink = transmission.querySelector<HTMLAnchorElement>('[data-youtube-link]');
    const moreLink = transmission.querySelector<HTMLAnchorElement>('[data-channel-more]');
    const art = transmission.querySelector<HTMLElement>('[data-info-art]');
    const artReadout = transmission.querySelector<HTMLElement>('[data-art-readout]');
    const channelButtons = Array.from(
      transmission.querySelectorAll<HTMLButtonElement>('[data-channel-button]'),
    );
    const tabButtons = Array.from(
      transmission.querySelectorAll<HTMLButtonElement>('[data-channel-tab]'),
    );

    let channels: ChannelData[] = [];
    try {
      channels = JSON.parse(transmission.dataset.channelConfig ?? '[]') as ChannelData[];
    } catch {
      return;
    }

    if (
      !screen
      || !powerButton
      || !powerLabel
      || !status
      || !readout
      || !indexLabel
      || !title
      || !surfacePanel
      || !youtubeLink
      || !moreLink
      || !art
      || !artReadout
      || channels.length !== 6
      || channelButtons.length !== channels.length
      || tabButtons.length !== 3
    ) return;

    let currentIndex = 0;
    let currentSurface: ChannelSurface = 'INFO';
    let poweredOn = false;
    let wakeTimer: number | undefined;
    const dormantMarkup = screen.innerHTML;

    const channelNumber = (channel: ChannelData) => String(channel.number).padStart(2, '0');

    const clearWakeTimer = () => {
      if (wakeTimer !== undefined) window.clearTimeout(wakeTimer);
      wakeTimer = undefined;
    };

    const surfaceAvailable = (channel: ChannelData, surface: ChannelSurface) => {
      if (surface === 'INFO') return true;
      if (surface === 'LYRICS') return Boolean(channel.lyrics?.text);
      return channel.destinations.length > 0;
    };

    const renderStatic = (channel: ChannelData) => {
      screen.innerHTML = dormantMarkup;
      const standby = screen.querySelector<HTMLElement>('.crt-standby');
      if (standby) standby.textContent = `NO SIGNAL / CH ${channelNumber(channel)}`;
    };

    const renderFacts = (channel: ChannelData) => {
      const list = document.createElement('dl');
      list.className = 'channel-info';
      for (const item of channel.info) {
        const row = document.createElement('div');
        const term = document.createElement('dt');
        const detail = document.createElement('dd');
        term.textContent = item.label;
        if (item.url) {
          const link = document.createElement('a');
          link.href = item.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = `${item.value} ↗`;
          detail.append(link);
        } else detail.textContent = item.value;
        row.append(term, detail);
        list.append(row);
      }
      return list;
    };

    const renderLyrics = (channel: ChannelData) => {
      const lyric = channel.lyrics;
      const body = document.createElement('div');
      body.className = 'channel-lyrics';
      if (!lyric?.text) {
        const empty = document.createElement('p');
        empty.textContent = 'LYRICS NOT AVAILABLE';
        body.append(empty);
        return body;
      }
      const credit = document.createElement('p');
      credit.className = 'channel-lyric-credit';
      credit.textContent = `LYRICS / ${lyric.authors} · ${lyric.version}`;
      const copy = document.createElement('pre');
      copy.textContent = lyric.text;
      body.append(credit, copy);
      if (lyric.sampleTreatment) {
        const sample = document.createElement('p');
        sample.className = 'channel-sample-note';
        sample.textContent = lyric.sampleTreatment;
        body.append(sample);
      }
      return body;
    };

    const renderStreaming = (channel: ChannelData) => {
      const list = document.createElement('ul');
      list.className = 'channel-streaming';
      if (!channel.destinations.length) {
        const empty = document.createElement('p');
        empty.textContent = 'NO VERIFIED STREAMING DESTINATION';
        return empty;
      }
      for (const destination of channel.destinations) {
        const row = document.createElement('li');
        const anchor = document.createElement('a');
        anchor.href = destination.url;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        anchor.textContent = `${destination.platform.toUpperCase()} / ${destination.label} ↗`;
        const level = document.createElement('span');
        level.textContent = destination.label;
        row.append(anchor, level);
        list.append(row);
      }
      return list;
    };

    const renderSurface = (channel: ChannelData) => {
      const content = currentSurface === 'LYRICS'
        ? renderLyrics(channel)
        : currentSurface === 'STREAMING'
          ? renderStreaming(channel)
          : renderFacts(channel);
      surfacePanel.replaceChildren(content);
      surfacePanel.setAttribute('aria-labelledby', `${transmission.id}-tab-${currentSurface.toLowerCase()}`);
    };

    const renderTabs = (channel: ChannelData) => {
      tabButtons.forEach((button) => {
        const surface = button.dataset.channelTab as ChannelSurface;
        const enabled = surfaceAvailable(channel, surface);
        const selected = surface === currentSurface;
        button.disabled = !enabled;
        button.setAttribute('aria-disabled', String(!enabled));
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
    };

    const clearPlayer = () => {
      clearWakeTimer();
      screen.classList.remove('crt-screen--booting', 'crt-screen--online');
      transmission.classList.remove('video-transmission--online');
    };

    const loadPlayer = (channel: ChannelData) => {
      clearPlayer();
      status.textContent = `CH ${channelNumber(channel)} / WAKING SIGNAL`;
      readout.textContent = `CH ${channelNumber(channel)} / ONLINE`;
      screen.classList.add('crt-screen--booting');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      wakeTimer = window.setTimeout(() => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${channel.youtubeId}?playsinline=1&rel=0`;
        iframe.title = `${channel.title} video player`;
        iframe.loading = 'lazy';
        iframe.allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;

        screen.replaceChildren(iframe);
        screen.classList.remove('crt-screen--booting');
        screen.classList.add('crt-screen--online');
        transmission.classList.add('video-transmission--online');
        status.textContent = `CH ${channelNumber(channel)} / PLAYER READY`;
        wakeTimer = undefined;
      }, reducedMotion ? 0 : 520);
    };

    const renderChannel = (reloadPlayer = true) => {
      const channel = channels[currentIndex];
      if (!surfaceAvailable(channel, currentSurface)) currentSurface = 'INFO';
      channelButtons.forEach((button, index) => {
        button.setAttribute('aria-pressed', String(index === currentIndex));
      });
      indexLabel.textContent = `CH ${channelNumber(channel)} / ${channel.songId} / ${channel.playerChannelId}`;
      title.textContent = channel.title;
      moreLink.href = channel.moreHref;
      youtubeLink.href = channel.youtubeUrl;
      art.style.setProperty('--ch', String(currentIndex));
      artReadout.textContent = `CH ${channelNumber(channel)} / ${currentSurface}`;
      renderTabs(channel);
      renderSurface(channel);
      if (!reloadPlayer) return;
      if (poweredOn) loadPlayer(channel);
      else {
        clearPlayer();
        renderStatic(channel);
        readout.textContent = `CH ${channelNumber(channel)} / STANDBY`;
        status.textContent = `CH ${channelNumber(channel)} / SIGNAL COLD`;
      }
    };

    const selectChannel = (index: number) => {
      currentIndex = index;
      currentSurface = 'INFO';
      renderChannel(true);
    };

    const selectSurface = (surface: ChannelSurface) => {
      const channel = channels[currentIndex];
      if (!surfaceAvailable(channel, surface)) return;
      currentSurface = surface;
      renderChannel(false);
    };

    const powerOff = () => {
      poweredOn = false;
      powerButton.setAttribute('aria-pressed', 'false');
      powerLabel.textContent = 'POWER';
      renderChannel(true);
    };

    const powerOn = () => {
      poweredOn = true;
      powerButton.setAttribute('aria-pressed', 'true');
      powerLabel.textContent = 'POWER OFF';
      renderChannel(true);
    };

    channelButtons.forEach((button, index) => {
      button.addEventListener('click', () => selectChannel(index));
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const surface = button.dataset.channelTab as ChannelSurface | undefined;
        if (!surface || button.disabled) return;
        selectSurface(surface);
      });
    });

    transmission.querySelector<HTMLElement>('[data-channel-tabs]')?.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      const enabled = tabButtons.filter((button) => !button.disabled);
      const index = enabled.findIndex((button) => button.getAttribute('aria-selected') === 'true');
      const next = enabled[(index + (event.key === 'ArrowRight' ? 1 : -1) + enabled.length) % enabled.length];
      next?.click();
      next?.focus();
      event.preventDefault();
    });

    powerButton.addEventListener('click', () => {
      const isOn = powerButton.getAttribute('aria-pressed') === 'true';
      if (isOn) powerOff();
      else powerOn();
    });

    renderChannel();
  });
</script>

<style>
  .video-transmission { scroll-margin-top: 1rem; }

  .transmission-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.15rem 0.45rem;
    color: var(--jf-gray-mid);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .crt-machine {
    border: 3px solid var(--jf-fg);
    background: #080808;
    box-shadow: 7px 7px 0 #222;
  }

  .crt-bezel {
    padding: clamp(0.65rem, 3vw, 1.15rem);
    border-bottom: 2px solid var(--jf-fg);
    background:
      linear-gradient(135deg, transparent 9px, #0d0d0d 0) top left,
      linear-gradient(225deg, transparent 9px, #0d0d0d 0) top right;
    background-size: 51% 100%;
    background-repeat: no-repeat;
  }

  .crt-screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 2px solid var(--jf-gray-mid);
    border-radius: 4% / 7%;
    background: #020202;
    box-shadow: inset 0 0 32px #000;
    isolation: isolate;
  }

  .crt-screen::after {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    box-shadow: inset 0 0 22px 7px rgba(0, 0, 0, 0.78);
    content: '';
    pointer-events: none;
  }

  .crt-dormant,
  .crt-noise,
  .crt-reticle,
  .crt-scan {
    position: absolute;
    inset: 0;
  }

  .crt-dormant {
    background: radial-gradient(ellipse at center, #242424 0, #101010 58%, #020202 100%);
  }

  .crt-noise {
    opacity: 0.68;
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.92) 0 0.7px, transparent 0.9px),
      radial-gradient(circle, rgba(180, 180, 180, 0.8) 0 0.8px, transparent 1px),
      radial-gradient(circle, rgba(255, 255, 255, 0.55) 0 0.6px, transparent 0.9px);
    background-position: 0 0, 2px 1px, 1px 3px;
    background-size: 4px 4px, 5px 5px, 7px 6px;
    filter: contrast(1.4);
    animation: signal-noise 0.14s steps(2, end) infinite;
  }

  .crt-scan {
    z-index: 2;
    opacity: 0.45;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255, 255, 255, 0.08) 4px,
      transparent 5px
    );
    pointer-events: none;
  }

  .crt-reticle {
    z-index: 3;
    display: grid;
    place-items: center;
    opacity: 0.28;
  }

  .crt-reticle::before,
  .crt-reticle::after,
  .crt-reticle span::before,
  .crt-reticle span::after {
    position: absolute;
    background: var(--jf-gray-mid);
    content: '';
  }

  .crt-reticle::before { width: 1px; height: 22%; }
  .crt-reticle::after { width: 18%; height: 1px; }
  .crt-reticle span::before { inset: 9% auto auto 5%; width: 12%; height: 1px; }
  .crt-reticle span::after { inset: 9% 5% auto auto; width: 12%; height: 1px; }

  .crt-scan::after {
    position: absolute;
    inset-inline: 0;
    height: 12%;
    background: linear-gradient(transparent, rgba(255, 255, 255, 0.08), transparent);
    content: '';
    animation: scan-sweep 6s linear infinite;
  }

  .crt-standby {
    position: absolute;
    z-index: 4;
    inset: auto 0 7%;
    width: fit-content;
    margin: auto;
    padding: 0.24rem 0.42rem;
    background: rgba(0, 0, 0, 0.82);
    color: var(--jf-gray-strong);
    font-size: clamp(0.58rem, 2.5vw, 0.74rem);
    letter-spacing: 0.16em;
    text-align: center;
  }

  .crt-screen--booting::before {
    position: absolute;
    z-index: 6;
    inset: 50% 5%;
    height: 2px;
    background: #fff;
    box-shadow: 0 0 16px #fff;
    content: '';
    animation: crt-wake 0.52s ease-out both;
  }

  .crt-screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .crt-controls {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
  }

  .channel-bank {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .channel-bank button,
  .power-button {
    min-width: 0;
    min-height: 44px;
    border: 1px solid var(--jf-gray-mid);
    border-radius: 0;
    background: #000;
    color: var(--jf-gray-mid);
    font: 700 0.68rem/1 monospace;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .channel-bank button:hover,
  .channel-bank button[aria-pressed='true'],
  .power-button:hover,
  .power-button[aria-pressed='true'] {
    border-color: var(--jf-fg);
    background: var(--jf-fg);
    color: var(--jf-bg);
  }

  .channel-bank button:focus-visible,
  .power-button:focus-visible,
  .channel-info a:focus-visible,
  .channel-streaming a:focus-visible,
  .machine-tab:focus-visible,
  .channel-more:focus-visible,
  .release-links a:focus-visible {
    outline: 3px solid var(--jf-fg);
    outline-offset: 3px;
  }

  .power-cluster {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.45rem;
  }

  .power-button {
    width: 100%;
    padding: 0.55rem 0.62rem;
    border-width: 2px;
    color: var(--jf-fg);
  }

  .power-symbol { margin-right: 0.25rem; }

  .power-light {
    width: 7px;
    height: 7px;
    border: 1px solid var(--jf-gray-mid);
    border-radius: 50%;
    background: #222;
  }

  .video-transmission--online .power-light {
    background: var(--jf-fg);
    box-shadow: 0 0 8px var(--jf-fg);
  }

  .machine-status {
    min-width: 0;
    margin: 0;
    color: var(--jf-gray-mid);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .vent-bank {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
  }

  .vent-bank span {
    display: block;
    width: 3px;
    height: 18px;
    background: var(--jf-gray-soft);
  }

  .release-panel {
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 4vw, 1.5rem);
    border-top: 2px solid var(--jf-fg);
    background: #030303;
  }

  .release-index {
    margin: 0 0 0.2rem;
    color: var(--jf-gray-mid);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .release-title-block h2 {
    margin: 0;
    font-size: clamp(1.25rem, 6vw, 2rem);
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .info-machine {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .info-chassis {
    --ch: 0;
    position: relative;
    min-height: 132px;
    overflow: hidden;
