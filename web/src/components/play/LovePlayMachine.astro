---
import { LOVE_AUDIO_SRC } from '../../data/play/love-phase1.timeline';
---

<section class="love-play" data-love-play>
  <header class="love-play__chrome">
    <p class="love-play__kicker">JUNKFEATHERS PLAY</p>
    <h1 class="love-play__title">LOVE</h1>
    <p class="love-play__feat">feat. TYGERTYGER</p>
    <p class="love-play__beta">SECRET BETA</p>
    <p class="love-play__status" data-love-status>WAKE TO PLAY</p>
  </header>

  <div class="love-play__stage" data-love-stage data-scene="IDLE">
    <div class="love-play__phaser" data-love-phaser aria-hidden="true"></div>

    <div class="love-play__hud">
      <div class="love-play__meter" data-love-meter hidden>
        <p class="love-play__hearts" data-love-hearts>HEARTS 0</p>
        <div class="love-play__meter-track" aria-hidden="true">
          <div class="love-play__meter-fill" data-love-meter-fill></div>
        </div>
        <p class="love-play__meter-time" data-love-meter-time>4:05</p>
      </div>

      <button class="love-play__cta" type="button" data-love-play-button>
        PLAY LOVE
      </button>

      <div class="love-play__copy">
        <div class="love-play__lyric" data-love-lyric hidden></div>
        <div class="love-play__sample" data-love-sample hidden></div>
      </div>
      <p class="love-play__error" data-love-error hidden></p>

      <div class="love-play__end" data-love-end hidden>
        <p>THANK YOU FOR PLAYING</p>
        <p class="love-play__end-title">LOVE</p>
        <p>
          JUNKFEATHERS feat.
          <a
            class="love-play__credit-link"
            href="https://audius.co/tygertyger"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Opens Tygertyger’s music on Audius in a new tab"
          >Tygertyger</a>
        </p>
        <p class="love-play__hearts-end" data-love-hearts-end>HEARTS BROKEN 0</p>
        <button class="love-play__cta" type="button" data-love-again-button>
          PLAY AGAIN
        </button>
      </div>
    </div>
  </div>

  <div class="love-play__controls">
    <div class="love-play__controls-buttons">
      <button class="love-play__ctrl" type="button" data-love-mute aria-pressed="false">MUTE</button>
      <button class="love-play__ctrl" type="button" data-love-pause disabled>PAUSE</button>
      <button class="love-play__ctrl" type="button" data-love-restart disabled>START OVER</button>
    </div>
  </div>

  <pre class="love-play__debug" data-love-debug hidden></pre>

  <audio data-love-audio preload="metadata" playsinline src={LOVE_AUDIO_SRC}></audio>

  <div class="love-play__fallback" data-love-fallback hidden>
    <p>The moving machine could not start on this browser.</p>
    <p>The song, lyrics, and replay still work from this page.</p>
  </div>
</section>

<script>
  import { bootLovePlay } from '../../scripts/play/love-phase1';

  const root = document.querySelector('[data-love-play]');
  if (root instanceof HTMLElement) {
    bootLovePlay(root);
  }
</script>

<style>
  .love-play {
    --love-white: #ffffff;
    --love-gray: #8a8a8a;
    --love-dim: #4d4d4d;
    --love-soft: #1a1a1a;
    box-sizing: border-box;
    width: min(100%, 360px);
    margin: 0 auto;
    color: var(--love-white);
    font-family: ui-monospace, "Cascadia Mono", "Segoe UI Mono", Menlo, monospace;
  }

  .love-play *,
  .love-play *::before,
  .love-play *::after {
    box-sizing: border-box;
  }

  .love-play__chrome {
    padding: 10px 8px 8px;
    border: 2px solid var(--love-white);
    border-bottom: 0;
    background: #000;
    text-align: center;
  }

  .love-play__kicker,
  .love-play__feat,
  .love-play__status,
  .love-play__beta {
    margin: 0;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.68rem;
    color: var(--love-gray);
  }

  .love-play__beta {
    margin-top: 6px;
    letter-spacing: 0.2em;
    font-size: 0.58rem;
    color: var(--love-dim);
  }

  .love-play__title {
    margin: 6px 0 2px;
    font-size: 1.7rem;
    letter-spacing: 0.28em;
    font-weight: 500;
  }

  .love-play__status {
    margin-top: 8px;
    color: var(--love-white);
  }

  .love-play__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 360 / 640;
    border: 2px solid var(--love-white);
    background: #000;
    overflow: hidden;
  }

  .love-play__phaser,
  .love-play__hud {
    position: absolute;
    inset: 0;
  }

  .love-play__phaser {
    z-index: 1;
  }

  .love-play__hud {
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
    padding: 12px 12px 14px;
  }

  .love-play__meter {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .love-play__meter-track {
    flex: 1;
    height: 8px;
    border: 1px solid var(--love-white);
    background: #000;
  }

  .love-play__meter-fill {
    height: 100%;
    width: 100%;
    background: var(--love-white);
  }

  .love-play__meter-time {
    margin: 0;
    min-width: 2.6rem;
    color: var(--love-gray);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-align: right;
  }

  .love-play__hearts {
    margin: 0;
    min-width: 4.8rem;
    color: var(--love-gray);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .love-play__cta,
  .love-play__ctrl {
    pointer-events: auto;
    min-height: 44px;
    min-width: 44px;
    padding: 0 10px;
    border: 2px solid var(--love-white);
    background: #000;
    color: var(--love-white);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .love-play__cta {
    align-self: center;
    margin: auto 0;
    padding: 0 16px;
    letter-spacing: 0.18em;
    font-size: inherit;
  }

  .love-play__ctrl:disabled {
    color: var(--love-dim);
    border-color: var(--love-dim);
    cursor: default;
  }

  .love-play__cta:focus-visible,
  .love-play__ctrl:focus-visible,
  .love-play__credit-link:focus-visible {
    outline: 2px solid var(--love-white);
    outline-offset: 3px;
  }

  .love-play__copy {
    max-width: 100%;
  }

  .love-play__lyric,
  .love-play__sample,
  .love-play__error,
  .love-play__end {
    pointer-events: none;
  }

  .love-play__lyric p,
  .love-play__sample p,
  .love-play__error,
  .love-play__end p {
    margin: 0;
  }

  .love-play__lyric {
    color: var(--love-white);
    font-size: 0.86rem;
    line-height: 1.3;
    text-wrap: pretty;
    background: rgba(0, 0, 0, 0.62);
    padding: 6px 8px;
  }

  .love-play__sample {
    color: var(--love-gray);
    font-size: 0.74rem;
    font-style: italic;
    letter-spacing: 0.02em;
    line-height: 1.3;
    border-left: 2px solid var(--love-dim);
    padding: 6px 8px;
    background: rgba(0, 0, 0, 0.72);
  }

  .love-play__sample p + p {
    margin-top: 0.2rem;
  }

  .love-play__error {
    color: var(--love-white);
    font-size: 0.8rem;
    background: #000;
    border: 1px solid var(--love-gray);
    padding: 8px;
    pointer-events: auto;
  }

  .love-play__end {
    pointer-events: auto;
    text-align: center;
    background: rgba(0, 0, 0, 0.88);
    border: 1px solid var(--love-white);
    padding: 18px 12px;
  }

  .love-play__end-title {
    letter-spacing: 0.32em;
    font-size: 1.4rem;
  }

  .love-play__credit-link {
    pointer-events: auto;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-transform: none;
    letter-spacing: 0.08em;
  }

  .love-play__end .love-play__hearts-end {
    margin-top: 8px;
    letter-spacing: 0.14em;
    color: var(--love-gray);
  }

  .love-play__end .love-play__cta {
    margin-top: 12px;
  }

  .love-play__controls {
    display: flex;
    justify-content: stretch;
    align-items: center;
    gap: 8px;
    border: 2px solid var(--love-white);
    border-top: 0;
    padding: 8px;
    background: #000;
  }

  .love-play__controls-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
  }

  .love-play__controls-buttons .love-play__ctrl {
    flex: 1 1 auto;
  }

  .love-play__debug {
    margin: 8px 0 0;
    padding: 8px;
    border: 1px solid var(--love-dim);
    color: var(--love-gray);
    font-size: 0.68rem;
    line-height: 1.45;
    white-space: pre-wrap;
    background: #000;
  }

  .love-play__fallback {
    margin-top: 10px;
    padding: 12px;
    border: 1px solid var(--love-gray);
    color: var(--love-gray);
    font-size: 0.85rem;
  }

  audio[data-love-audio] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .love-play[data-fallback='true'] audio[data-love-audio] {
    position: static;
    width: 100%;
    height: auto;
    overflow: visible;
    clip: auto;
    margin-top: 10px;
  }

  .love-play[data-reduced-motion='true'] .love-play__status {
    letter-spacing: 0.12em;
  }
</style>
