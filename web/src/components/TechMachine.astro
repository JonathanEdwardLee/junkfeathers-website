---
import { techProjects } from '../data/techProjects';

const chronosTicks = Array.from({ length: 24 });
const inventoryRows = ['MERCH', 'TOOLS', 'GEAR', 'CREW'];
---

<div class="tech-experience">
  <header class="tech-header">
    <h1>TECH</h1>
  </header>

  <section
    id="tech-machine"
    class="tech-machine"
    data-tech-machine
    data-active-project="orpheus"
    aria-label="Inspect Junkfeathers technology projects"
  >
    <div class="machine-frame">
      <div class="machine-rail-wrap">
        <div class="machine-rail" role="tablist" aria-label="Select a technology project">
          {techProjects.map((project, index) => (
            <button
              id={`tech-selector-${project.id}`}
              class="project-selector"
              class:list={[project.family && 'project-selector--orpheus-family']}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`tech-panel-${project.id}`}
              tabindex={index === 0 ? '0' : '-1'}
              data-project-selector={project.id}
            >
              <span class="selector-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span>{project.selector}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="machine-output">
        {techProjects.map((project, index) => (
          <article
            id={`tech-panel-${project.id}`}
            class="project-panel"
            role="tabpanel"
            aria-labelledby={`tech-selector-${project.id}`}
            data-project-panel={project.id}
            hidden={index !== 0}
          >
            <div class="project-visual" aria-hidden="true">
              <div class={`visual-scene visual-scene--${project.id}`}>
                {project.id === 'orpheus' && (
                  <div class="orpheus-tracks">
                    <div class="track-playhead"></div>
                    {[0, 1, 2, 3].map((track) => (
                      <div class="track-row" style={`--track:${track}`}>
                        <span class="track-number">0{track + 1}</span>
                        <span class="track-wave">
                          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                        </span>
                        <span class="track-light"></span>
                      </div>
                    ))}
                  </div>
                )}

                {project.id === 'ofx' && (
                  <div class="ofx-system">
                    <div class="ofx-host">
                      <span>O</span>
                      <small>ORPHEUS BUS</small>
                    </div>
                    <div class="ofx-link"></div>
                    <div class="ofx-modules">
                      {['SAT', 'ECHO', 'LIMIT'].map((module, moduleIndex) => (
                        <div class="ofx-module" style={`--module:${moduleIndex}`}>
                          <span>{module}</span>
                          <i></i><i></i><i></i>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {project.id === 'chronos' && (
                  <div class="chronos-system">
                    <div class="chronos-dial">
                      {chronosTicks.map((_, tick) => <i style={`--tick:${tick}`}></i>)}
                      <span class="chronos-hand chronos-hand--minute"></span>
                      <span class="chronos-hand chronos-hand--second"></span>
                      <span class="chronos-hub"></span>
                    </div>
                    <div class="chronos-bpm"><strong>120</strong><span>BPM</span></div>
                  </div>
                )}

                {project.id === 'agora' && (
                  <div class="agora-system">
                    <svg viewBox="0 0 520 260" role="presentation">
                      <path d="M40 70 180 42 260 130 400 45 480 105" />
                      <path d="M65 215 190 180 260 130 390 205 480 105" />
                      <path d="M180 42 190 180M400 45 390 205" />
                    </svg>
                    <span class="agora-node agora-node--1"></span>
                    <span class="agora-node agora-node--2"></span>
                    <span class="agora-node agora-node--3"></span>
                    <span class="agora-node agora-node--4"></span>
                    <span class="agora-node agora-node--5"></span>
                    <span class="agora-pulse"></span>
                    <div class="agora-event">LOCAL // 04 SIGNALS</div>
                  </div>
                )}

                {project.id === 'ichor' && (
                  <div class="ichor-rack">
                    {[0, 1, 2].map((module) => (
                      <div class="ichor-module" style={`--module:${module}`}>
                        <span class="ichor-wave"></span>
                        <i></i><i></i><i></i>
                      </div>
                    ))}
                    <svg viewBox="0 0 520 260" role="presentation">
                      <path d="M80 70 C180 8 270 245 440 80" />
                      <path d="M80 188 C210 250 305 18 440 190" />
                    </svg>
                  </div>
                )}

                {project.id === 'syrinx' && (
                  <div class="syrinx-system">
                    <div class="syrinx-readout">
                      <span>ROOT</span><strong>C</strong><span>INTERVAL</span><strong>Ⅴ</strong>
                    </div>
                    <div class="syrinx-keys">
                      {['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', '°'].map((key, keyIndex) => (
                        <i class:list={[keyIndex === 0 || keyIndex === 4 ? 'is-lit' : '']}>{key}</i>
                      ))}
                    </div>
                    <div class="syrinx-interval"><span></span><i></i><span></span></div>
                  </div>
                )}

                {project.id === 'ostracon' && (
                  <div class="ostracon-system">
                    <div class="ostracon-total"><span>TOTAL</span><strong>0042</strong></div>
                    <div class="ostracon-list">
                      {inventoryRows.map((row, rowIndex) => (
                        <div class="ostracon-row" style={`--row:${rowIndex}`}>
                          <span>{row}</span><i></i><strong>{String((rowIndex + 1) * 3).padStart(2, '0')}</strong>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {project.id === 'archimedes' && (
                  <div class="archimedes-system">
                    <svg viewBox="0 0 520 260" role="presentation">
                      <path class="flight-vector" d="M20 205 C120 130 165 210 250 100 S390 80 500 25" />
                      <path class="sensor-beam" d="M260 130 465 48M260 130 455 205M260 130 65 35" />
                    </svg>
                    <div class="familiar-core"><span></span><i></i><i></i></div>
                    <span class="flight-mark flight-mark--1">+</span>
                    <span class="flight-mark flight-mark--2">+</span>
                    <span class="flight-mark flight-mark--3">+</span>
                  </div>
                )}
              </div>
            </div>

            <div class="project-copy">
              <div class="project-status"><span></span>{project.status}</div>
              <h2>{project.name}</h2>
              <p class="project-type">{project.type}</p>
              <p class="project-description">{project.description}</p>

              <div class="project-actions" aria-label={`${project.name} actions`}>
                {project.actions.map((action) => (
                  action.disabled ? (
                    <button
                      class:list={['project-action', `project-action--${action.style}`, 'project-action--disabled']}
                      type="button"
                      disabled
                      aria-disabled="true"
                    >
                      {action.label}
                    </button>
                  ) : (
                    <a
                      class:list={['project-action', `project-action--${action.style}`]}
                      href={action.href}
                      target={action.external ? '_blank' : undefined}
                      rel={action.external ? 'noopener noreferrer' : undefined}
                    >
                      {action.label}{action.external ? ' ↗' : ''}
                    </a>
                  )
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="machine-footer" aria-hidden="true">
        <span>INPUT 08</span>
        <i></i><i></i><i></i>
        <span>LOCAL SYSTEM</span>
      </div>
    </div>
  </section>
</div>

<script>
  const machine = document.querySelector<HTMLElement>('[data-tech-machine]');

  if (machine) {
    const selectors = Array.from(machine.querySelectorAll<HTMLButtonElement>('[data-project-selector]'));
    const panels = Array.from(machine.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const activateProject = (selector: HTMLButtonElement, moveFocus = false) => {
      const projectId = selector.dataset.projectSelector;
      if (!projectId) return;

      machine.dataset.activeProject = projectId;

      selectors.forEach((item) => {
        const selected = item === selector;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.projectPanel !== projectId;
      });

      selector.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      if (moveFocus) selector.focus();
    };

    selectors.forEach((selector, index) => {
      selector.addEventListener('click', () => activateProject(selector));
      selector.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % selectors.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + selectors.length) % selectors.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = selectors.length - 1;

        if (nextIndex !== null) {
          event.preventDefault();
          activateProject(selectors[nextIndex], true);
        }
      });
    });
  }
</script>

<style>
  .tech-experience {
    --tech-white: #fff;
    --tech-mid: #8a8a8a;
    --tech-dim: #4d4d4d;
    --tech-line: #2b2b2b;
    width: min(100% - 1rem, 780px);
    margin: clamp(1rem, 4vw, 2.5rem) auto clamp(3rem, 8vw, 6rem);
  }

  .tech-header {
    margin-bottom: clamp(1.5rem, 5vw, 2.75rem);
    border-block: 1px solid var(--tech-line);
    padding: clamp(1rem, 4vw, 2rem) 0;
  }

  .tech-header h1 {
    margin: 0;
    font-size: clamp(3rem, 16vw, 7.5rem);
    line-height: 0.82;
    letter-spacing: 0.12em;
    text-align: center;
  }

  .tech-machine {
    scroll-margin-top: 1rem;
  }

  .machine-frame {
    position: relative;
    overflow: hidden;
    border: 3px solid var(--tech-white);
    background:
      linear-gradient(90deg, transparent 49.85%, rgba(255, 255, 255, 0.028) 50%, transparent 50.15%),
      #020202;
    box-shadow: 7px 7px 0 #1a1a1a;
  }

  .machine-frame::before,
  .machine-frame::after {
    position: absolute;
    z-index: 4;
    top: 8px;
    width: 6px;
    height: 6px;
    border: 1px solid var(--tech-mid);
    border-radius: 50%;
    background: #000;
    content: '';
  }

  .machine-frame::before { left: 8px; }
  .machine-frame::after { right: 8px; }

  .machine-rail-wrap {
    padding: 1rem 0.75rem 0.8rem;
    border-bottom: 1px solid var(--tech-line);
    background: #050505;
  }

  .machine-rail {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.25rem 0.15rem 0.5rem;
    scrollbar-color: var(--tech-mid) #111;
    scrollbar-width: thin;
    scroll-snap-type: x mandatory;
  }

  .project-selector {
    position: relative;
    min-width: 112px;
    min-height: 52px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--tech-dim);
    border-radius: 0;
    background: #050505;
    color: var(--tech-mid);
    cursor: pointer;
    font: 700 0.76rem/1.05 monospace;
    letter-spacing: 0.04em;
    scroll-snap-align: center;
    text-align: left;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .project-selector::after {
    position: absolute;
    right: 5px;
    bottom: 5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--tech-dim);
    content: '';
  }

  .project-selector:hover {
    border-color: var(--tech-mid);
    color: var(--tech-white);
  }

  .project-selector[aria-selected='true'] {
    border-color: var(--tech-white);
    background: #151515;
    color: var(--tech-white);
  }

  .project-selector[aria-selected='true']::after {
    background: var(--tech-white);
    box-shadow: 0 0 7px var(--tech-white);
  }

  .project-selector:focus-visible {
    outline: 2px solid var(--tech-white) !important;
    outline-offset: 3px;
  }

  .project-selector--orpheus-family {
    border-bottom-color: #aaa;
  }

  .selector-index {
    color: var(--tech-dim);
    font-size: 0.63rem;
    font-weight: 400;
  }

  .project-selector[aria-selected='true'] .selector-index {
    color: var(--tech-white);
  }

  .machine-output {
    min-height: 590px;
  }

  .project-panel {
    min-height: 590px;
    display: grid;
  }

  .project-panel[hidden] {
    display: none;
  }

  .project-visual {
    min-height: 300px;
    padding: 1rem;
    border-bottom: 1px solid var(--tech-line);
    background:
      linear-gradient(rgba(255, 255, 255, 0.015) 50%, transparent 50%),
      radial-gradient(circle at center, #111 0, #040404 65%);
    background-size: 100% 4px, auto;
  }

  .visual-scene {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 268px;
    overflow: hidden;
    border: 1px solid var(--tech-line);
    background: #030303;
  }

  .visual-scene::before,
  .visual-scene::after {
    position: absolute;
    z-index: 3;
    width: 24px;
    height: 24px;
    border-color: var(--tech-mid);
    content: '';
    opacity: 0.55;
  }

  .visual-scene::before {
    top: 8px;
    left: 8px;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .visual-scene::after {
    right: 8px;
    bottom: 8px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .project-copy {
    align-content: start;
    padding: clamp(1.25rem, 5vw, 2.5rem);
  }

  .project-status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.35rem;
    color: var(--tech-mid);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .project-status span {
    width: 7px;
    height: 7px;
    border: 1px solid var(--tech-white);
    border-radius: 50%;
    background: var(--tech-white);
    box-shadow: 0 0 7px rgba(255, 255, 255, 0.55);
  }

  .project-copy h2 {
    margin: 0;
    font-size: clamp(2rem, 10vw, 4.2rem);
    line-height: 0.9;
    letter-spacing: 0.04em;
  }

  .project-type {
    margin: 0.8rem 0 0;
    color: var(--tech-mid);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .project-description {
    max-width: 54ch;
    margin: 1.4rem 0 0;
    color: #d4d4d4;
    font-size: clamp(0.92rem, 3vw, 1.05rem);
    line-height: 1.55;
  }

  .project-actions {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .project-action {
    min-height: 48px;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 0.75rem 1rem;
    border: 2px solid var(--tech-white);
    border-radius: 0;
    background: #000;
    color: var(--tech-white);
    font: 700 0.82rem/1.2 monospace;
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
  }

  .project-action--primary:hover,
  .project-action--primary:focus {
    border-bottom: 2px solid var(--tech-white);
    background: var(--tech-white);
    color: #000;
  }

  .project-action--secondary {
    border-width: 1px;
    border-color: var(--tech-mid);
    color: #d0d0d0;
  }

  a.project-action--secondary:hover,
  a.project-action--secondary:focus {
    border-bottom: 1px solid var(--tech-white);
    border-color: var(--tech-white);
    color: var(--tech-white);
  }

  .project-action:focus-visible {
    outline: 2px solid var(--tech-white) !important;
    outline-offset: 4px;
  }

  .project-action--disabled,
  .project-action--disabled:hover,
  .project-action--disabled:focus {
    border-color: #3c3c3c;
    background: #050505;
    color: #585858;
    cursor: not-allowed;
  }

  .machine-footer {
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--tech-line);
    color: var(--tech-dim);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .machine-footer i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--tech-dim);
  }

  .machine-footer i:first-of-type {
    background: var(--tech-white);
    box-shadow: 0 0 6px var(--tech-white);
  }

  /* Orpheus: four-track signal deck */
  .orpheus-tracks {
    position: absolute;
    inset: 12% 7%;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: 0.55rem;
  }

  .track-row {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr 10px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem;
    border: 1px solid #333;
    background: #080808;
  }

  .track-number {
    color: var(--tech-mid);
    font-size: 0.62rem;
  }

  .track-wave {
    height: 32px;
    display: flex;
    align-items: center;
    gap: clamp(3px, 1vw, 8px);
    overflow: hidden;
  }

  .track-wave i {
    flex: 1;
    min-width: 2px;
    height: 28%;
    background: var(--tech-mid);
    animation: track-wave 2.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--track) * -0.3s);
  }

  .track-wave i:nth-child(2n) { height: 78%; }
  .track-wave i:nth-child(3n) { height: 48%; }
  .track-wave i:nth-child(4n) { height: 96%; }

  .track-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tech-mid);
  }

  .track-row:first-of-type .track-light {
    background: var(--tech-white);
    box-shadow: 0 0 7px var(--tech-white);
  }

  .track-playhead {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 16%;
    width: 1px;
    background: var(--tech-white);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
    animation: track-scan 6s linear infinite;
  }

  /* O-FX: visibly tethered to Orpheus */
  .ofx-system {
    position: absolute;
    inset: 10%;
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: center;
    gap: 1rem;
  }

  .ofx-host {
    position: relative;
    z-index: 2;
    width: 90px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 2px solid var(--tech-white);
    border-radius: 50%;
    background: #050505;
  }

  .ofx-host > span {
    font-size: 2.25rem;
    font-weight: 700;
  }

  .ofx-host small {
    position: absolute;
    bottom: -1.45rem;
    width: 120px;
    color: var(--tech-mid);
    font-size: 0.58rem;
    text-align: center;
  }

  .ofx-link {
    position: absolute;
    left: 84px;
    right: 1rem;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--tech-white) 0 8px, transparent 8px 14px);
    animation: ofx-current 2s linear infinite;
  }

  .ofx-modules {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.55rem;
  }

  .ofx-module {
    min-height: 48px;
    display: grid;
    grid-template-columns: 1fr repeat(3, 8px);
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--tech-mid);
    background: #080808;
    color: #d8d8d8;
    font-size: 0.65rem;
  }

  .ofx-module i {
    height: calc(10px + var(--module) * 4px);
    background: var(--tech-mid);
    animation: limiter 1.8s ease-in-out infinite alternate;
  }

  .ofx-module i:last-child { background: var(--tech-white); }

  /* Chronos */
  .chronos-system {
    position: absolute;
    inset: 7%;
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(82px, 0.55fr);
    align-items: center;
    gap: 1rem;
  }

  .chronos-dial {
    position: relative;
    justify-self: center;
    width: min(54vw, 210px);
    aspect-ratio: 1;
    border: 2px solid var(--tech-white);
    border-radius: 50%;
    box-shadow: inset 0 0 0 8px #050505, inset 0 0 0 9px var(--tech-mid);
  }

  .chronos-dial > i {
    position: absolute;
    top: 4%;
    left: calc(50% - 1px);
    width: 2px;
    height: 8%;
    background: var(--tech-mid);
    transform: rotate(calc(var(--tick) * 15deg));
    transform-origin: 1px 575%;
  }

  .chronos-hand {
    position: absolute;
    z-index: 2;
    bottom: 50%;
    left: calc(50% - 1px);
    width: 2px;
    height: 36%;
    background: var(--tech-white);
    transform-origin: bottom;
  }

  .chronos-hand--minute { animation: timing-hand 12s steps(60, end) infinite; }
  .chronos-hand--second { height: 27%; animation: timing-hand 4s linear infinite reverse; }

  .chronos-hub {
    position: absolute;
    z-index: 3;
    inset: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tech-white);
  }

  .chronos-bpm {
    display: grid;
    padding: 0.8rem;
    border: 1px solid var(--tech-mid);
    text-align: center;
  }

  .chronos-bpm strong { font-size: clamp(1.8rem, 7vw, 3.2rem); line-height: 1; }
  .chronos-bpm span { color: var(--tech-mid); font-size: 0.62rem; letter-spacing: 0.16em; }

  /* Local Agora */
  .agora-system,
  .ichor-rack,
  .archimedes-system {
    position: absolute;
    inset: 5%;
  }

  .agora-system svg,
  .ichor-rack svg,
  .archimedes-system svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .agora-system path {
    fill: none;
    stroke: var(--tech-mid);
    stroke-dasharray: 7 8;
    stroke-width: 1.5;
    animation: network-current 7s linear infinite;
  }

  .agora-node {
    position: absolute;
    width: 14px;
    height: 14px;
