---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';
import VideoTransmission from '../components/VideoTransmission.astro';

interface ArchiveFact { label: string; value: string; url?: string }
interface ArchiveDestination {
  id: string; platform: string; url: string; kind: 'exact' | 'release-page' | 'smart-link'; label: string; level: string;
}
interface ArchiveVersion {
  key: string; recordingId: string | null; releaseId: string | null; projectId: string; projectName: string;
  label: string; datePrecision: string | null; listenChannelIds: string[]; watchChannelIds: string[];
  lyricIds: string[]; lyricState: string; destinations: ArchiveDestination[];
}
interface ArchiveSong {
  id: string; title: string; projectNames: string[]; writing: string | null; lyrics: string | null;
  versions: ArchiveVersion[];
}
interface ArchiveSongLink {
  id: string; songId: string; platform: string; url: string; mediaId: string | null;
}
interface ArchiveLyric {
  id: string; songId: string; title: string; version: string; text: string; authors: string;
  sampleTreatment: string | null; publicEligible?: boolean; state?: string;
}
interface ArchivePlayerChannel {
  id: string; songId: string; songLinkId: string; recordingId: string | null; releaseId: string | null;
  mediaId: string | null; facts: ArchiveFact[];
}
interface ArchiveData {
  meta: { schemaVersion: string; counts: { playerChannels: number } };
  songs: ArchiveSong[]; songLinks: ArchiveSongLink[]; lyrics: ArchiveLyric[]; playerChannels: ArchivePlayerChannel[];
}

const channelSpecs = [
  { songId: 'SONG-0055', songLinkId: 'SLNK-0441', youtubeId: 'nkRq-vjhBUg', playerChannelId: 'PCH-0066', recordingId: 'REC-SOLO-059', releaseId: 'REL-SOLO-014' },
  { songId: 'SONG-0052', songLinkId: 'SLNK-0492', youtubeId: 'FxcZc9OSzCU', playerChannelId: 'PCH-0183', youtubeUrlOverride: 'https://www.youtube.com/watch?v=FxcZc9OSzCU&list=OLAK5uy_lvVgnbLw8qlSq9XelASoBkEBPY5w9s-6o' },
  { songId: 'SONG-0039', songLinkId: 'SLNK-0620', youtubeId: 'ApKAcOuOiZ0', playerChannelId: 'PCH-0168' },
  { songId: 'SONG-0223', songLinkId: 'SLNK-0458', youtubeId: 'X4watMNFBfw', playerChannelId: 'PCH-0026' },
  { songId: 'SONG-0054', songLinkId: 'SLNK-0471', youtubeId: 'kQIljBxvemI', playerChannelId: 'PCH-0019' },
  { songId: 'SONG-0053', songLinkId: 'SLNK-0470', youtubeId: 'Q25_KwBVur0', playerChannelId: 'PCH-0018' },
] as const;

const archive = JSON.parse(
  readFileSync(resolve(process.cwd(), 'public/data/music-archive/v04/archive.json'), 'utf8'),
) as ArchiveData;
if (archive.meta.schemaVersion !== 'music-archive-v04.0' || archive.meta.counts.playerChannels !== 409) {
  throw new Error('Music video channels require the verified Archive v04 artifact.');
}

const knownValue = (value: string | null | undefined) => Boolean(value && !/^unknown$/i.test(value.trim()));

const channels = channelSpecs.map((spec, index) => {
  const song = archive.songs.find((item) => item.id === spec.songId);
  const link = archive.songLinks.find((item) => item.id === spec.songLinkId);
  const playerChannel = archive.playerChannels.find((item) => item.id === spec.playerChannelId);
  const version = song?.versions.find((item) =>
    item.listenChannelIds.includes(spec.playerChannelId) || item.watchChannelIds.includes(spec.playerChannelId)
  );
  const lyric = (version?.lyricIds ?? [])
    .map((id) => archive.lyrics.find((item) => item.id === id))
    .find((item) => item?.state === 'public' && item.publicEligible !== false && item.text);
  if (
    !song || !link || !playerChannel || !version
    || playerChannel.songId !== spec.songId
    || link.songId !== spec.songId || link.platform !== 'YouTube'
    || link.mediaId !== spec.youtubeId || link.url !== `https://www.youtube.com/watch?v=${spec.youtubeId}`
    || ('recordingId' in spec && (playerChannel.recordingId !== spec.recordingId || version.recordingId !== spec.recordingId))
    || ('releaseId' in spec && playerChannel.releaseId !== spec.releaseId && version.releaseId !== spec.releaseId)
  ) throw new Error(`Archive v04 video channel ${index + 1} failed exact-version resolution.`);

  const facts: ArchiveFact[] = [];
  const seen = new Set<string>();
  const pushFact = (label: string, value: string | null | undefined, url?: string) => {
    if (!knownValue(value) || seen.has(label)) return;
    seen.add(label);
    facts.push(url ? { label, value: value as string, url } : { label, value: value as string });
  };
  for (const fact of playerChannel.facts) {
    if (fact.label === 'PLATFORM' || fact.label === 'PLAYBACK SOURCE') continue;
    pushFact(fact.label, fact.value, fact.url);
  }
  pushFact('WRITING', song.writing);
  pushFact('LYRICS', song.lyrics);
  pushFact('SONG ID', song.id);
  pushFact('CHANNEL ID', playerChannel.id);
  pushFact('VERSION ID', version.key);

  return {
    number: index + 1,
    songId: song.id,
    songLinkId: link.id,
    playerChannelId: playerChannel.id,
    youtubeId: link.mediaId as string,
    youtubeUrl: 'youtubeUrlOverride' in spec ? spec.youtubeUrlOverride : link.url,
    moreHref: `/music/archive/?song=${song.id}&channel=${playerChannel.id}`,
    title: song.title,
    info: facts,
    lyrics: lyric ? { authors: lyric.authors, version: lyric.version, text: lyric.text, sampleTreatment: lyric.sampleTreatment } : null,
    destinations: version.destinations.map((destination) => ({
      platform: destination.platform,
      url: destination.url,
      kind: destination.kind,
      label: destination.kind === 'smart-link' ? 'SMART LINK' : destination.kind === 'release-page' ? 'RELEASE PAGE' : 'EXACT TRACK',
    })),
  };
});
---

<Layout title="Music - Junkfeathers" description="A curated selection of Junkfeathers music.">
  <div class="music-page">
    <header class="music-opening">
      <p class="music-system-line" aria-hidden="true">JF / AUDIO MACHINE</p>
      <h1>MUSIC</h1>
    </header>

    <VideoTransmission
      anchorId="first-video-module"
      channels={channels}
    />

    <aside class="archive-entry" aria-labelledby="archive-entry-title">
      <div class="archive-entry-art" aria-hidden="true">
        <div class="archive-reader">
          <i></i><i></i><i></i><i></i><i></i>
        </div>
        <div class="archive-entry-readout">
          <span>CAT / 010</span>
          <strong>INDEX READY</strong>
        </div>
      </div>
      <div class="archive-entry-copy">
        <p class="archive-entry-signal">JF / MUSIC CATALOG</p>
        <h2 id="archive-entry-title">MUSIC ARCHIVE</h2>
        <p>The music archive is a work in process. Explore my music catalog of over twenty years. Get the latest Junkfeathers releases and my other musical projects like Leadership Class, Nora and Gnoll and more.</p>
        <a href="/music/archive/?view=latest">ENTER ARCHIVE <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .music-page {
    width: min(100% - 1rem, 780px);
    margin: clamp(1rem, 5vw, 2.5rem) auto;
  }

  .music-opening {
    margin-bottom: clamp(2rem, 8vw, 4.5rem);
  }

  .music-system-line {
    margin: 0 0 0.2rem;
    color: var(--jf-gray-mid);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .music-opening h1 {
    margin: 0 0 clamp(0.9rem, 4vw, 1.5rem);
    font-size: clamp(2.5rem, 14vw, 6rem);
    line-height: 0.9;
    letter-spacing: 0.04em;
  }

  .archive-entry {
    --archive-mid: #858585;
    --archive-dim: #4a4a4a;
    display: grid;
    margin-top: clamp(2.75rem, 9vw, 5rem);
    border: var(--jf-border-major) solid var(--archive-mid);
    background: #020202;
    box-shadow: 5px 5px 0 #171717;
  }

  .archive-entry-art {
    position: relative;
    display: grid;
    min-height: 180px;
    padding: 1rem;
    overflow: hidden;
    border-bottom: 2px solid var(--archive-mid);
    background:
      repeating-linear-gradient(to bottom, transparent 0 3px, rgba(255, 255, 255, 0.025) 4px),
      #070707;
  }

  .archive-reader {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    padding: 0.7rem;
    border: 1px solid var(--archive-dim);
    background: #020202;
  }

  .archive-reader i {
    position: relative;
    overflow: hidden;
    border-inline: 1px solid #202020;
  }

  .archive-reader i::after {
    position: absolute;
    inset: 72% 2px auto;
    height: 22%;
    background: #8f8f8f;
    content: '';
    animation: archive-reader-breathe 3.6s ease-in-out infinite alternate;
  }

  .archive-reader i:nth-child(2)::after { animation-delay: -1.4s; }
  .archive-reader i:nth-child(3)::after { animation-delay: -2.6s; }
  .archive-reader i:nth-child(4)::after { animation-delay: -0.8s; }
  .archive-reader i:nth-child(5)::after { animation-delay: -2s; }

  .archive-entry-readout {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    justify-items: end;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--archive-dim);
    background: rgba(0, 0, 0, 0.88);
    color: var(--archive-mid);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  .archive-entry-readout strong { color: var(--jf-fg); }

  .archive-entry-copy {
    display: grid;
    align-content: center;
    justify-items: start;
    padding: clamp(1rem, 4vw, 1.5rem);
  }

  .archive-entry-signal {
    margin: 0 0 0.45rem;
    color: var(--archive-mid);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }

  .archive-entry h2 {
    margin: 0 0 0.25rem;
    font-size: clamp(1.2rem, 6vw, 1.8rem);
  }

  .archive-entry p:not(.archive-entry-signal) {
    margin: 0 0 1rem;
    color: var(--jf-gray-strong);
  }

  .archive-entry a {
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--jf-fg);
    border-bottom: 1px dashed var(--archive-mid);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .archive-entry a:hover,
  .archive-entry a:focus {
    color: var(--jf-fg);
    border-bottom-color: var(--jf-fg);
  }

  @media (min-width: 620px) {
    .music-page {
      width: min(100% - 2rem, 780px);
    }

    .archive-entry { grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr); }
    .archive-entry-art { border-right: 2px solid var(--archive-mid); border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-reader i::after { animation: none; }
  }

  @keyframes archive-reader-breathe {
    from { opacity: 0.28; transform: translateY(18%); }
    to { opacity: 0.88; transform: translateY(-210%); }
  }
</style>
