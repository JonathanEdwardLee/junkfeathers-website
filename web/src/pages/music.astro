---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Music - Junkfeathers">
  <div class="jf-machine-shell">
    <div class="jf-screen">
      <div style="text-align: center; padding: 15px 0;">
        <span class="jf-status-strip">MUSIC INDEX</span>
        <h1 class="jf-machine-title">JUNKFEATHERS MUSIC</h1>
        <hr class="jf-divider" />
        <p class="jf-machine-subtitle">Song archives, records, and audio links.</p>
      </div>
    </div>

    <div class="jf-panel">
      <span class="jf-label">ARCHIVE STATUS</span>
      <p style="margin: 0;">Legacy music tracks, Bandcamp embeds, and playlist links will be organized here in a future release.</p>
    </div>

    <div style="text-align: center; margin-top: var(--jf-space-4);">
      <a href="/" class="jf-btn jf-btn--secondary" style="font-size: 0.9em;">&lt; RETURN TO HOME</a>
    </div>
  </div>
</Layout>
