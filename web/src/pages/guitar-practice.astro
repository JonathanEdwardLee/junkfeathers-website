---
import Layout from '../layouts/Layout.astro';
import '../styles/gdc.css';
const voices = ['Wood block','Tape clack','Soft beep','Rim click','Analog pulse','Cowbell'];
const panels = ['Timing','Technique','Theory','EXP'];
const keys = ['C','D♭','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const modes = ['Major','Natural minor','Harmonic minor','Phrygian dominant'];
const degrees = ['I','II','III','IV','V','VI','VII'];
---
<Layout title="Free Guitar Practice Tools &amp; Metronome | Junkfeathers Tech" description="Guitar Discipline Console GDC-01. Practice scales with playable tabs, increase your speed, explore chord progressions and track your musical development. Completely free.">
<article class="gdc">
<header class="gdc-head"><div><small>JUNKFEATHERS TECH / GDC–01</small><h1>Become Most Excellent at Guitar</h1></div>
<div class="transport"><button id="play">▶ Start</button><output id="status">Ready</output><button id="balance">Balanced view</button></div><div class="account-bay" aria-hidden="true"></div></header>
<div id="rack" data-focus="Balanced">
{panels.map(panel=><section data-panel={panel} aria-label={panel}>
<header><h2>{panel}</h2><div>{panel!=='EXP' && <button popovertarget={'controls-'+panel} aria-label={panel+' settings'}>Settings</button>} <button class="focus" aria-label={'Enlarge '+panel}>Enlarge</button></div></header>
{panel==='Timing' && <>
<div class="display"><strong id="tempo">80</strong> <small>BPM</small><div class="gear-window" aria-hidden="true"><i></i></div></div>
<div id="pulses" aria-label="Pulse accents"></div>
<div class="row"><label>Tempo<input id="bpm" type="number" min="30" max="300" value="80"/></label><label>Meter<select id="meter">{['4/4','3/4','6/8','5/4','7/8'].map(m=><option>{m}</option>)}</select></label><button id="tap">Tap tempo</button></div>
<div id="controls-Timing" class="tray"><header><h3>Chronos settings</h3><button popovertarget="controls-Timing">Close</button></header><div class="controls">
<label>Count-in<select id="count"><option value="0">Off</option><option value="4">4 pulses</option></select></label>
<label>Base sound<select id="base">{voices.map(v=><option>{v}</option>)}</select></label>
<label>Accent sound<select id="accent">{voices.map(v=><option selected={v==='Cowbell'}>{v}</option>)}</select></label>
<label>Groove (%)<input type="range" id="groove" min="0" max="66" value="0"/></label><label>Volume<input type="range" id="vol" min="0" max="100" value="55"/></label></div><small>BPM counts pulses in every meter. Select a pulse on the panel to change its accent.</small></div></>}
{panel==='Technique' && <><h3 id="exercise"></h3><small id="rhythm"></small><div id="tab" aria-label="Current and upcoming bars of standard guitar tablature"></div>
<label><input type="checkbox" id="guide" checked/> Scale audio</label>
<div id="controls-Technique" class="tray"><header><h3>Scale practice</h3><button popovertarget="controls-Technique">Close</button></header><label class="ramp-switch"><input type="checkbox" id="ramp"/> Automatic tempo ramp</label><div class="controls">
<label>Key<select id="key">{keys.map((k,i)=><option value={i} selected={i===4}>{k}</option>)}</select></label>
<label>Scale<select id="scale">{modes.map(s=><option>{s}</option>)}</select></label>
<label>Fingering<select id="position"><option value="root">Root octave</option>{Array.from({length:21},(_,i)=><option value={i}>Frets {i}–{i+4}</option>)}</select></label><label>Sequence<select id="direction"><option>Up and down</option><option>Ascending</option><option>Descending</option></select></label>
<label>Notes per pulse<select id="division">{[1,2,3,4].map(n=><option>{n}</option>)}</select></label>
<label>Target BPM<input id="target" type="number" min="30" max="300" value="100"/></label><label>Step BPM<input id="increment" type="number" min="1" max="30" value="5"/></label><label>Loops per step<input id="loops" type="number" min="1" max="32" value="4"/></label></div></div></>}
{panel==='Theory' && <><div class="harmony-head"><div><h3 id="keyname"></h3><small id="relative"></small><small id="tonic"></small></div><label>Key<select id="theory-key">{keys.map((k,i)=><option value={i} selected={i===4}>{k}</option>)}</select></label><label>Scale<select id="theory-mode">{modes.map(s=><option>{s}</option>)}</select></label></div><div id="keyboard" aria-label="Scale and chord tones" role="img">{Array.from({length:24},(_,i)=><i data-pitch={i%12} class={[1,3,6,8,10].includes(i%12)?'black':'white'}></i>)}</div><div id="changes" aria-label="Chord progression"></div><label><input type="checkbox" id="chords"/> Chord backing · one bar per chord</label>
<div id="controls-Theory" class="tray"><header><h3>Chord progression</h3><button popovertarget="controls-Theory">Close</button></header><label>Preset<select id="preset"><option value="0,3,4,0">I · IV · V · I</option><option value="0,4,5,3">I · V · VI · IV</option><option value="1,4,0,-1">II · V · I</option><option value="0,3,4,-1">I · IV · V</option><option value="custom">Custom</option></select></label><div class="controls">{[0,3,4,0].map((v,i)=><label>Slot {i+1}<select id={'chord'+i}>{i>0 && <option value="-1">Skip</option>}{degrees.map((d,j)=><option value={j} selected={j===v}>{d}</option>)}</select></label>)}</div><table><caption>Scale harmony</caption><tbody id="harmony"></tbody></table></div></>}
{panel==='EXP' && <><div class="display"><strong id="points">0</strong> <small>EXP</small><span id="practice"></span></div><div class="daily-practice"><label>Daily goal<select id="daily-goal">{[5,10,15,20,30,45,60].map(n=><option value={n} selected={n===15}>{n} min</option>)}</select></label><div><small id="daily-time"></small><progress id="daily-progress" aria-label="Today’s practice goal"></progress></div></div><small id="week-summary">Activity · last seven days</small><div id="history" aria-label="Practice duration by day for the last seven days"></div><progress id="progress" aria-label="Progress toward next EXP milestone"></progress><small id="milestone"></small></>}
</section>)}</div></article>
<script>import '../scripts/gdc';</script>
</Layout>
