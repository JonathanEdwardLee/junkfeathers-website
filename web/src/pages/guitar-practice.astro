---
import {regions,patterns} from '../scripts/gdc-exercises';
import Layout from '../layouts/Layout.astro';
import '../styles/gdc.css';
const voices = ['Wood block','Tape clack','Soft beep','Rim click','Analog pulse','Cowbell'];
const panels = ['Timing','Technique','Theory','EXP'];
const audioChannels: Record<string,[string,string]> = { Timing:['click-audio','Chronos click'], Technique:['guide','Scale audio'], Theory:['chords','Chord backing'] };
const keys = ['C','D♭','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const modes = ['Major','Natural minor','Harmonic minor','Phrygian dominant'];
const degrees = ['I','II','III','IV','V','VI','VII'];
---
<Layout title="Free Guitar Practice Tools &amp; Metronome | Junkfeathers Tech" description="Guitar Discipline Console GDC-01. Practice scales with playable tabs, increase your speed, explore chord progressions and track your musical development. Completely free.">
<article class="gdc">
<header class="gdc-head"><div><small>JUNKFEATHERS TECH / GDC–01</small><h1>Become Most Excellent at Guitar</h1></div>
<div class="transport"><button id="play">▶ Start</button><output id="status" tabindex="0">Ready</output><button id="balance" class="panel-icon" aria-label="Balanced view" title="Balanced view"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor"><path d="M2 2h6v6H2z M12 2h6v6h-6z M2 12h6v6H2z M12 12h6v6h-6z"/></svg></button></div><div class="account-bay" aria-hidden="true"></div></header>
<div id="rack" data-focus="Balanced">
{panels.map(panel=><section data-panel={panel} aria-label={panel}>
<header><h2>{panel}</h2><div>{panel!=='EXP' && <button popovertarget={'controls-'+panel} class="panel-icon" title={panel+' settings'} aria-label={panel+' settings'}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="m10 2-.6 2.5-2 .9-2.2-1.2-2 3.4 1.9 1.7-.2 2.2L3 13l1.5 3.7 2.5-.4 1.7 1.5.2 2.5 3.9.7 1.1-2.3 2.1-.6 2.1 1.4 2.5-3.1-1.6-1.9.4-2.2 2.2-1.2-1.1-3.8-2.5.1-1.5-1.6.1-2.5-3.8-1.1-1.4 2-1.4-.2ZM15.5 11.7a3.6 3.6 0 1 1-7.2 0 3.6 3.6 0 0 1 7.2 0Z"/></svg></button>} {audioChannels[panel] && <label class="audio-switch" title={audioChannels[panel][1]}><input type="checkbox" id={audioChannels[panel][0]} aria-label={audioChannels[panel][1]} checked={panel!=='Theory'} /><span aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 9h4l5-4v14l-5-4H3z"/><g fill="none" stroke="currentColor" stroke-width="2"><path class="sound-on" d="M15 8q4 4 0 8m3-11q7 7 0 14"/><path class="sound-off" d="m15 9 6 6m0-6-6 6"/></g></svg></span></label>} <button class="focus panel-icon" aria-pressed="false" title={'Enlarge '+panel} aria-label={'Enlarge '+panel}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="expand-mark" d="M4 10V4h6m4 0h6v6M4 14v6h6m10-6v6h-6"/><path class="restore-mark" d="M4 9h5V4m6 0v5h5M4 15h5v5m6 0v-5h5"/></svg></button></div></header>
{panel==='Timing' && <>
<div class="display"><strong id="tempo">80</strong> <small>BPM</small><div class="gear-window" aria-hidden="true"><i></i></div></div>
<div id="pulses" aria-label="Pulse accents"></div>
<div class="row"><label>Tempo<input id="bpm" type="number" min="30" max="300" value="80"/></label><label>Meter<select id="meter">{['4/4','3/4','6/8','5/4','7/8'].map(m=><option>{m}</option>)}</select></label><button id="tap">Tap tempo</button></div>
<div id="controls-Timing" class="tray"><header><h3>Chronos settings</h3><button popovertarget="controls-Timing">Close</button></header><div class="controls">
<label>Count-in<select id="count"><option value="0">Off</option><option value="4">4 pulses</option></select></label>
<label>Base sound<select id="base">{voices.map(v=><option>{v}</option>)}</select></label>
<label>Accent sound<select id="accent">{voices.map(v=><option selected={v==='Cowbell'}>{v}</option>)}</select></label>
<label>Groove (%)<input type="range" id="groove" min="0" max="66" value="0"/></label><label>Volume<input type="range" id="vol" min="0" max="100" value="55"/></label></div><small>BPM counts pulses in every meter. Select a pulse on the panel to change its accent.</small></div></>}
{panel==='Technique' && <><div class="exercise-head"><h3 id="exercise"></h3><button id="choose-neck" type="button" aria-haspopup="dialog" aria-controls="neck-dialog">Choose neck region</button></div><small id="rhythm"></small><div id="tab" aria-label="Current and upcoming bars of standard guitar tablature"></div>

<div id="controls-Technique" class="tray"><header><h3>Scale practice</h3><button popovertarget="controls-Technique">Close</button></header><label class="ramp-switch"><input type="checkbox" id="ramp"/> Automatic tempo ramp</label><div class="controls">
<label>Key<select id="key">{keys.map((k,i)=><option value={i} selected={i===4}>{k}</option>)}</select></label>
<label>Scale<select id="scale">{modes.map(s=><option>{s}</option>)}</select></label>
<select hidden aria-label="Practice region" id="position">{regions.map(r=><option value={r.id}>{r.label}</option>)}</select><label>Pattern<select id="phrase">{Object.keys(patterns).map(p=><option>{p}</option>)}</select></label><label>Sequence<select id="direction"><option>Up and down</option><option>Ascending</option><option>Descending</option></select></label>
<label>Notes per pulse<select id="division">{[1,2,3,4].map(n=><option>{n}</option>)}</select></label>
<label>Target BPM<input id="target" type="number" min="30" max="300" value="100"/></label><label>Step BPM<input id="increment" type="number" min="1" max="30" value="5"/></label><label>Loops per step<input id="loops" type="number" min="1" max="32" value="4"/></label></div></div></>}
{panel==='Theory' && <><div class="harmony-head"><div><h3 id="keyname"></h3><small id="relative"></small><small id="tonic"></small></div><label>Key<select id="theory-key">{keys.map((k,i)=><option value={i} selected={i===4}>{k}</option>)}</select></label><label>Scale<select id="theory-mode">{modes.map(s=><option>{s}</option>)}</select></label></div><div id="keyboard" aria-label="Scale and chord tones" role="img">{Array.from({length:24},(_,i)=><i data-pitch={i%12} class={[1,3,6,8,10].includes(i%12)?'black':'white'}></i>)}</div><table><caption>Scale harmony</caption><tbody id="harmony"></tbody></table><div id="changes" aria-label="Chord progression"></div>
<div id="controls-Theory" class="tray"><header><h3>Chord progression</h3><button popovertarget="controls-Theory">Close</button></header><label>Preset<select id="preset"><option value="0,3,4,0">I · IV · V · I</option><option value="0,4,5,3">I · V · VI · IV</option><option value="1,4,0,-1">II · V · I</option><option value="0,3,4,-1">I · IV · V</option><option value="custom">Custom</option></select></label><div class="controls">{[0,3,4,0].map((v,i)=><label>Slot {i+1}<select id={'chord'+i}>{i>0 && <option value="-1">Skip</option>}{degrees.map((d,j)=><option value={j} selected={j===v}>{d}</option>)}</select></label>)}</div></div></>}
{panel==='EXP' && <><div class="display"><strong id="points">0</strong> <small>EXP</small><span id="practice"></span></div><div class="daily-practice"><label>Daily goal<select id="daily-goal">{[5,10,15,20,30,45,60].map(n=><option value={n} selected={n===15}>{n} min</option>)}</select></label><div><small id="daily-time"></small><progress id="daily-progress" aria-label="Today’s practice goal"></progress></div></div><button id="open-journal" aria-haspopup="dialog">Practice journal</button><small id="week-summary">Activity · last seven days</small><div id="history" aria-label="Practice duration by day for the last seven days"></div><progress id="progress" aria-label="Progress toward next EXP milestone"></progress><small id="milestone"></small></>}
</section>)}</div>
<dialog id="journal" aria-labelledby="journal-title"><header><h2 id="journal-title">Practice journal</h2><form method="dialog"><button>Close</button></form></header><p>Playback history on this browser</p><h3>Time by scale</h3><div id="scale-totals"></div><h3>Sessions</h3><div id="session-list"></div></dialog>
<dialog id="neck-dialog" aria-labelledby="neck-title">
<header><h2 id="neck-title">Practice region</h2><form method="dialog"><button>Done</button></form></header>
<div class="neck-map">
<svg viewBox="0 0 300 268" preserveAspectRatio="none" aria-hidden="true">
  <path d="M116 46 109 33 Q104 26 113 21 L169 2 Q184 -1 178 10 L164 27 164 46Z" fill="#252525" stroke="#ddd" stroke-width="1.8"/>
  <path d="M116 44H164L175 258H105Z" fill="#0a0a0a" stroke="#999"/>
  {Array.from({length:6},(_,i)=><line x1={118+i*8.8} x2={108+i*12.8} y1="44" y2="258" stroke="#aaa" stroke-width=".8"/>)}
  {Array.from({length:25},(_,i)=><line x1={116-i*.45} x2={164+i*.45} y1={44+i*8.9} y2={44+i*8.9} stroke="#888" stroke-width={i===0?3:1}/>)}
  <rect id="neck-highlight" x="107" y="44" width="66" height="72" fill="white" opacity=".16"/>
  <g fill="none" stroke="currentColor" stroke-width="2"><path d="M94 44H83V258H94"/><path d="M185 44H197V185H185"/><path d="M203 98H215V258H203"/></g>
</svg>
{regions.map(r=><button type="button" data-region={r.id} aria-pressed={r.id==='upper'?'true':'false'}>{r.label}</button>)}
</div>
<p id="neck-range" aria-live="polite"></p>
<label>Last fret on guitar<select id="last-fret">{[20,21,22,24].map(f=><option selected={f===24}>{f}</option>)}</select></label>
</dialog></article>
<script>import '../scripts/gdc';</script>
</Layout>
