---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - Orpheus Deck">
  <div class="jf-machine-shell">
    <div class="jf-screen">
      <div style="text-align: center; padding: 15px 0;">
        <span class="jf-status-strip">PRIVACY STATEMENT</span>
        <h1 class="jf-machine-title">ORPHEUS DECK PRIVACY POLICY</h1>
        <hr class="jf-divider" />
        <p class="jf-machine-subtitle">App data handling, permissions, and overview.</p>
      </div>
    </div>

    <div class="jf-panel">
      <p><strong>App:</strong> Orpheus Deck</p>
      <p><strong>Developer:</strong> Junkfeathers Tech</p>
      <p><strong>Support Contact:</strong> junkfeathersmusic@gmail.com</p>
      <p><strong>Effective Date:</strong> July 3, 2026</p>
      
      <div class="jf-divider"></div>
      
      <h3>1. Overview</h3>
      <p>Orpheus Deck is a retro-inspired four-track audio recorder for Android. This Privacy Policy explains how the app handles information, recordings, files, permissions, local preferences, and optional Google Play Billing subscriptions. Orpheus Deck is built to be privacy-conscious.</p>
    </div>

    <div style="text-align: center; margin-top: var(--jf-space-4);">
      <a href="/orpheus-deck/" class="jf-btn jf-btn--secondary" style="font-size: 0.9em;">&lt; RETURN TO ORPHEUS DECK</a>
    </div>
  </div>
</Layout>
