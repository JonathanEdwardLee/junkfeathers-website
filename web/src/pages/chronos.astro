---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Chronos - Junkfeathers">
  <div class="jf-machine-shell">
    <div class="jf-screen">
      <div style="text-align: center; padding: 15px 0;">
        <span class="jf-status-strip">DRAFT PANEL</span>
        <h1 class="jf-machine-title">CHRONOS</h1>
        <hr class="jf-divider" />
        <p class="jf-machine-subtitle">Retro timing machine under development.</p>
      </div>
    </div>

    <div style="text-align: center; margin-top: var(--jf-space-4);">
      <a href="/" class="jf-btn jf-btn--secondary" style="font-size: 0.9em;">&lt; RETURN TO HOME</a>
    </div>
  </div>
</Layout>
