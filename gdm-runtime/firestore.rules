rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gdmPlayers/{uid}/sessions/{session} {
      function ownsHistory() {
        return request.auth != null && request.auth.uid == uid &&
          request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function validSession() {
        return request.resource.data.keys().hasOnly(['seconds','record']) &&
          request.resource.data.seconds is number && request.resource.data.seconds > 0 &&
          request.resource.data.record is string && request.resource.data.record.size() <= 750000;
      }
      allow read: if ownsHistory();
      allow create: if ownsHistory() && validSession();
      allow update: if ownsHistory() && validSession() &&
        request.resource.data.seconds >= resource.data.seconds;
    }
  }
}
